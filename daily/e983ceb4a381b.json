[
  {
    "index": 0,
    "text": "Lesson 71.",
    "start": 1.531,
    "end": 4.002,
    "zh": "第71课。",
    "zh_hant": "第71課。"
  },
  {
    "index": 1,
    "text": "He's awful!",
    "start": 4.052,
    "end": 5.852,
    "zh": "他太讨厌了！",
    "zh_hant": "他太討厭了！"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 6.753,
    "end": 10.675,
    "zh": "听录音，然后回答问题。",
    "zh_hant": "聽錄音，然後回答問題。"
  },
  {
    "index": 3,
    "text": "How did Pauline answer the telephone at nine o'clock?",
    "start": 12.796,
    "end": 17.138,
    "zh": "波琳在九点钟是怎么接电话的？",
    "zh_hant": "波琳在九點鐘是怎麼接電話的？"
  },
  {
    "index": 4,
    "text": "What's Ron Marston like, Pauline?",
    "start": 19.479,
    "end": 22.861,
    "zh": "波琳，罗恩·马斯顿是个什么样的人？",
    "zh_hant": "波琳，羅恩·馬斯頓是個什麼樣的人？"
  },
  {
    "index": 5,
    "text": "He's awful!",
    "start": 23.942,
    "end": 25.362,
    "zh": "他太讨厌了！",
    "zh_hant": "他太討厭了！"
  },
  {
    "index": 6,
    "text": "He telephoned me four times yesterday",
    "start": 25.502,
    "end": 28.944,
    "zh": "他昨天给我打了四次电话",
    "zh_hant": "他昨天給我打了四次電話"
  },
  {
    "index": 7,
    "text": "and three times the day before yesterday.",
    "start": 29.124,
    "end": 32.586,
    "zh": "前天打了三次。",
    "zh_hant": "前天打了三次。"
  },
  {
    "index": 8,
    "text": "He telephoned the office yesterday morning",
    "start": 33.326,
    "end": 36.688,
    "zh": "他昨天上午打电话到办公室",
    "zh_hant": "他昨天上午打電話到辦公室"
  },
  {
    "index": 9,
    "text": "and yesterday afternoon.",
    "start": 36.408,
    "end": 38.869,
    "zh": "昨天下午也打了。",
    "zh_hant": "昨天下午也打了。"
  },
  {
    "index": 10,
    "text": "My boss answered the telephone.",
    "start": 39.469,
    "end": 42.011,
    "zh": "我的老板接了电话。",
    "zh_hant": "我的老闆接了電話。"
  },
  {
    "index": 11,
    "text": "What did your boss say to him?",
    "start": 43.051,
    "end": 45.312,
    "zh": "你老板对他说了什么？",
    "zh_hant": "你老闆對他說了什麼？"
  },
  {
    "index": 12,
    "text": "He said, 'Pauline is typing letters.",
    "start": 46.573,
    "end": 49.975,
    "zh": "他说：‘波琳正在打信。",
    "zh_hant": "他說：‘波琳正在打信。"
  },
  {
    "index": 13,
    "text": "She can't speak to you now!'",
    "start": 50.135,
    "end": 52.896,
    "zh": "她现在不能和你说话！’",
    "zh_hant": "她現在不能和你說話！’"
  },
  {
    "index": 14,
    "text": "Then I arrived home at six o'clock yesterday evening.",
    "start": 53.296,
    "end": 57.078,
    "zh": "然后我昨天傍晚六点回到家。",
    "zh_hant": "然後我昨天傍晚六點回到家。"
  },
  {
    "index": 15,
    "text": "He telephoned again.",
    "start": 57.278,
    "end": 58.939,
    "zh": "他又打来电话了。",
    "zh_hant": "他又打來電話了。"
  },
  {
    "index": 16,
    "text": "But I didn't answer the phone!",
    "start": 59.339,
    "end": 61.76,
    "zh": "但我不没接电话！",
    "zh_hant": "但我不沒接電話！"
  },
  {
    "index": 17,
    "text": "Did he telephone again last night?",
    "start": 62.561,
    "end": 65.062,
    "zh": "他昨天晚上又打电话了吗？",
    "zh_hant": "他昨天晚上又打電話了嗎？"
  },
  {
    "index": 18,
    "text": "Yes, he did.",
    "start": 65.863,
    "end": 67.043,
    "zh": "是的，他打了。",
    "zh_hant": "是的，他打了。"
  },
  {
    "index": 19,
    "text": "He telephoned at nine o'clock.",
    "start": 67.443,
    "end": 70.004,
    "zh": "他九点钟打来的。",
    "zh_hant": "他九點鐘打來的。"
  },
  {
    "index": 20,
    "text": "What did you say to him?",
    "start": 71.385,
    "end": 73.026,
    "zh": "你对他说了什么？",
    "zh_hant": "你對他說了什麼？"
  },
  {
    "index": 21,
    "text": "I said, 'This is Pauline's mother.",
    "start": 74.127,
    "end": 77.228,
    "zh": "我说：‘我是波琳的母亲。",
    "zh_hant": "我說：‘我是波琳的母親。"
  },
  {
    "index": 22,
    "text": "Please don't telephone my daughter again!'",
    "start": 77.648,
    "end": 81.09,
    "zh": "请不要再给我的女儿打电话了！’",
    "zh_hant": "請不要再給我的女兒打電話了！’"
  },
  {
    "index": 23,
    "text": "Did he telephone again?",
    "start": 81.235,
    "end": 82.94,
    "zh": "他又打电话了吗？",
    "zh_hant": "他又打電話了嗎？"
  },
  {
    "index": 24,
    "text": "No, he didn't!",
    "start": 83.404,
    "end": 84.968,
    "zh": "没有，他没打！",
    "zh_hant": "沒有，他沒打！"
  }
]
