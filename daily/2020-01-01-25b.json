[
  {
    "index": 0,
    "text": "Lesson 49 At the butcher's Listen to the tape then answer this question.",
    "start": 0.59,
    "end": 10.191,
    "zh": "第49课 在肉店 听录音,然后回答问题。",
    "zh_hant": "第49課 在肉店 聽錄音,然後回答問題。"
  },
  {
    "index": 1,
    "text": "What does Mr. Bird like?",
    "start": 11.396,
    "end": 14.237,
    "zh": "伯德先生喜欢什么？",
    "zh_hant": "伯德先生喜歡什麼？"
  },
  {
    "index": 2,
    "text": "Do you want any meat today, Mrs. Bird?",
    "start": 15.718,
    "end": 19.72,
    "zh": "你今天要肉吗，伯德太太？",
    "zh_hant": "你今天要肉嗎，伯德太太？"
  },
  {
    "index": 3,
    "text": "Yes, please.",
    "start": 20.6,
    "end": 22.201,
    "zh": "是的，请给我一些。",
    "zh_hant": "是的，請給我一些。"
  },
  {
    "index": 4,
    "text": "Do you want beef or lamb?",
    "start": 23.202,
    "end": 26.563,
    "zh": "你要牛肉还是羊肉？",
    "zh_hant": "你要牛肉還是羊肉？"
  },
  {
    "index": 5,
    "text": "Beef, please.",
    "start": 26.964,
    "end": 28.684,
    "zh": "请给我牛肉。",
    "zh_hant": "請給我牛肉。"
  },
  {
    "index": 6,
    "text": "This lamb's very good.",
    "start": 29.765,
    "end": 32.326,
    "zh": "这羊肉很好。",
    "zh_hant": "這羊肉很好。"
  },
  {
    "index": 7,
    "text": "I like lamb, but my husband doesn't.",
    "start": 33.907,
    "end": 37.689,
    "zh": "我喜欢羊肉，但我丈夫不喜欢。",
    "zh_hant": "我喜歡羊肉，但我丈夫不喜歡。"
  },
  {
    "index": 8,
    "text": "What about some steak?",
    "start": 38.589,
    "end": 40.931,
    "zh": "来点牛排怎么样？",
    "zh_hant": "來點牛排怎麼樣？"
  },
  {
    "index": 9,
    "text": "This is a nice piece.",
    "start": 41.611,
    "end": 44.173,
    "zh": "这块很不错。",
    "zh_hant": "這塊很不錯。"
  },
  {
    "index": 10,
    "text": "Give me that piece, please.",
    "start": 45.073,
    "end": 47.775,
    "zh": "请给我那块。",
    "zh_hant": "請給我那塊。"
  },
  {
    "index": 11,
    "text": "And a pound of mince, too.",
    "start": 48.255,
    "end": 51.417,
    "zh": "还要一磅肉馅。",
    "zh_hant": "還要一磅肉餡。"
  },
  {
    "index": 12,
    "text": "Do you want a chicken, Mrs. Bird?",
    "start": 52.958,
    "end": 56.759,
    "zh": "你要一只鸡吗，伯德太太？",
    "zh_hant": "你要一隻雞嗎，伯德太太？"
  },
  {
    "index": 13,
    "text": "They're very nice.",
    "start": 57.44,
    "end": 59.501,
    "zh": "这些鸡很好。",
    "zh_hant": "這些雞很好。"
  },
  {
    "index": 14,
    "text": "No, thank you.",
    "start": 59.861,
    "end": 61.342,
    "zh": "不了，谢谢。",
    "zh_hant": "不了，謝謝。"
  },
  {
    "index": 15,
    "text": "My husband likes steak,",
    "start": 62.223,
    "end": 64.884,
    "zh": "我丈夫喜欢牛排，",
    "zh_hant": "我丈夫喜歡牛排，"
  },
  {
    "index": 16,
    "text": "but he doesn't like chicken.",
    "start": 64.944,
    "end": 67.405,
    "zh": "但他不喜欢鸡。",
    "zh_hant": "但他不喜歡雞。"
  },
  {
    "index": 17,
    "text": "To tell you the truth,",
    "start": 68.586,
    "end": 71.287,
    "zh": "说实话，",
    "zh_hant": "說實話，"
  },
  {
    "index": 18,
    "text": "Mrs. Bird, I don't like chicken",
    "start": 70.947,
    "end": 75.089,
    "zh": "伯德太太，我也不喜欢鸡",
    "zh_hant": "伯德太太，我也不喜歡雞"
  },
  {
    "index": 19,
    "text": "either!",
    "start": 75.07,
    "end": 75.93,
    "zh": "也一样！",
    "zh_hant": "也一樣！"
  }
]
