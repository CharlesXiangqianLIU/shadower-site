[
  {
    "index": 0,
    "text": "Lesson 73.",
    "start": 0.69,
    "end": 3.202,
    "zh": "第73课。",
    "zh_hant": "第73課。"
  },
  {
    "index": 1,
    "text": "The way to King Street.",
    "start": 3.252,
    "end": 5.793,
    "zh": "去国王街的路。",
    "zh_hant": "去國王街的路。"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 6.893,
    "end": 11.375,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "Why did the man need a phrasebook?",
    "start": 12.476,
    "end": 16.278,
    "zh": "那个人为什么需要一本常用语手册？",
    "zh_hant": "那個人為什麼需要一本常用語手冊？"
  },
  {
    "index": 4,
    "text": "Last week Mrs. Mills went to London.",
    "start": 18.739,
    "end": 23.081,
    "zh": "上周，米尔斯太太去了伦敦。",
    "zh_hant": "上週，米爾斯太太去了倫敦。"
  },
  {
    "index": 5,
    "text": "She does not know London very well,",
    "start": 23.662,
    "end": 27.163,
    "zh": "她对伦敦不太熟悉，",
    "zh_hant": "她對倫敦不太熟悉，"
  },
  {
    "index": 6,
    "text": "and she lost her way.",
    "start": 27.244,
    "end": 29.665,
    "zh": "而且她迷路了。",
    "zh_hant": "而且她迷路了。"
  },
  {
    "index": 7,
    "text": "Suddenly, she saw a man",
    "start": 30.525,
    "end": 33.647,
    "zh": "突然，她看到一个男人",
    "zh_hant": "突然，她看到一個男人"
  },
  {
    "index": 8,
    "text": "near a bus stop.",
    "start": 33.567,
    "end": 35.447,
    "zh": "在公交车站附近。",
    "zh_hant": "在公交車站附近。"
  },
  {
    "index": 9,
    "text": "'I can ask him the way,'",
    "start": 35.097,
    "end": 38.869,
    "zh": "“我可以问他路，”",
    "zh_hant": "“我可以問他路，”"
  },
  {
    "index": 10,
    "text": "she said to herself.",
    "start": 38.989,
    "end": 40.951,
    "zh": "她自言自语道。",
    "zh_hant": "她自言自語道。"
  },
  {
    "index": 11,
    "text": "'Excuse me,' she said.",
    "start": 40.831,
    "end": 44.672,
    "zh": "“打扰一下，”她说。",
    "zh_hant": "“打擾一下，”她說。"
  },
  {
    "index": 12,
    "text": "'Can you tell",
    "start": 44.333,
    "end": 46.693,
    "zh": "“你能告诉",
    "zh_hant": "“你能告訴"
  },
  {
    "index": 13,
    "text": "me the way to King Street,",
    "start": 46.343,
    "end": 49.235,
    "zh": "我去国王街的路，",
    "zh_hant": "我去國王街的路，"
  },
  {
    "index": 14,
    "text": "please?'",
    "start": 49.015,
    "end": 50.495,
    "zh": "吗？”",
    "zh_hant": "嗎？”"
  },
  {
    "index": 15,
    "text": "The man smiled pleasantly.",
    "start": 51.076,
    "end": 53.977,
    "zh": "那个男人愉快地笑了笑。",
    "zh_hant": "那個男人愉快地笑了笑。"
  },
  {
    "index": 16,
    "text": "He did not understand English!",
    "start": 54.638,
    "end": 58.179,
    "zh": "他不懂英语！",
    "zh_hant": "他不懂英語！"
  },
  {
    "index": 17,
    "text": "He spoke German.",
    "start": 58.5,
    "end": 60.54,
    "zh": "他说德语。",
    "zh_hant": "他說德語。"
  },
  {
    "index": 18,
    "text": "He was a tourist.",
    "start": 61.141,
    "end": 63.502,
    "zh": "他是个游客。",
    "zh_hant": "他是個遊客。"
  },
  {
    "index": 19,
    "text": "Then he put his hand into his pocket,",
    "start": 64.162,
    "end": 68.124,
    "zh": "然后他把手伸进口袋里，",
    "zh_hant": "然後他把手伸進口袋裡，"
  },
  {
    "index": 20,
    "text": "and took out a phrasebook.",
    "start": 68.424,
    "end": 71.386,
    "zh": "掏出一本常用语手册。",
    "zh_hant": "掏出一本常用語手冊。"
  },
  {
    "index": 21,
    "text": "He opened the book and found a phrase.",
    "start": 71.826,
    "end": 76.148,
    "zh": "他打开书，找到一个短语。",
    "zh_hant": "他開啟書，找到一個短語。"
  },
  {
    "index": 22,
    "text": "He read the phrase slowly.",
    "start": 76.769,
    "end": 80.122,
    "zh": "他慢慢地读那个短语。",
    "zh_hant": "他慢慢地讀那個短語。"
  },
  {
    "index": 23,
    "text": "'I am sorry,'",
    "start": 79.722,
    "end": 83.079,
    "zh": "“对不起，”",
    "zh_hant": "“對不起，”"
  },
  {
    "index": 24,
    "text": "he said.",
    "start": 83.321,
    "end": 84.502,
    "zh": "他说。",
    "zh_hant": "他說。"
  },
  {
    "index": 25,
    "text": "'I do not speak English.'",
    "start": 84.163,
    "end": 87.71,
    "zh": "“我不会说英语。”",
    "zh_hant": "“我不會說英語。”"
  }
]
