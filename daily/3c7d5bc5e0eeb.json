[
  {
    "index": 0,
    "text": "Lesson 59 Is that all?",
    "start": 1.55,
    "end": 5.232,
    "zh": "第59课 就这些吗？",
    "zh_hant": "第59課 就這些嗎？"
  },
  {
    "index": 1,
    "text": "Listen to the tape then answer this question.",
    "start": 6.033,
    "end": 9.574,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 2,
    "text": "Does the lady buy any chalk?",
    "start": 11.756,
    "end": 14.397,
    "zh": "那位女士买粉笔了吗？",
    "zh_hant": "那位女士買粉筆了嗎？"
  },
  {
    "index": 3,
    "text": "I want some envelopes, please.",
    "start": 16.638,
    "end": 18.759,
    "zh": "我要一些信封，麻烦你了。",
    "zh_hant": "我要一些信封，麻煩你了。"
  },
  {
    "index": 4,
    "text": "Do you want the large size or the small size?",
    "start": 19.439,
    "end": 23.281,
    "zh": "你要大号的还是小号的？",
    "zh_hant": "你要大號的還是小號的？"
  },
  {
    "index": 5,
    "text": "The large size, please.",
    "start": 23.321,
    "end": 25.222,
    "zh": "请给我大号的。",
    "zh_hant": "請給我大號的。"
  },
  {
    "index": 6,
    "text": "Do you have any writing paper?",
    "start": 26.223,
    "end": 28.183,
    "zh": "你们有信纸吗？",
    "zh_hant": "你們有信紙嗎？"
  },
  {
    "index": 7,
    "text": "Yes, we do.",
    "start": 28.544,
    "end": 29.984,
    "zh": "是的，我们有。",
    "zh_hant": "是的，我們有。"
  },
  {
    "index": 8,
    "text": "I don't have any small pads.",
    "start": 32.526,
    "end": 34.747,
    "zh": "我没有小本子。",
    "zh_hant": "我沒有小本子。"
  },
  {
    "index": 9,
    "text": "I only have large ones.",
    "start": 35.127,
    "end": 37.408,
    "zh": "我只有大本的。",
    "zh_hant": "我只有大本的。"
  },
  {
    "index": 10,
    "text": "Do you want a pad?",
    "start": 38.369,
    "end": 39.709,
    "zh": "你要一个本子吗？",
    "zh_hant": "你要一個本子嗎？"
  },
  {
    "index": 11,
    "text": "Yes, please.",
    "start": 39.99,
    "end": 41.23,
    "zh": "好的，麻烦你了。",
    "zh_hant": "好的，麻煩你了。"
  },
  {
    "index": 12,
    "text": "And I want some glue.",
    "start": 41.971,
    "end": 43.832,
    "zh": "我还要一些胶水。",
    "zh_hant": "我還要一些膠水。"
  },
  {
    "index": 13,
    "text": "A bottle of glue.",
    "start": 44.653,
    "end": 45.994,
    "zh": "一瓶胶水。",
    "zh_hant": "一瓶膠水。"
  },
  {
    "index": 14,
    "text": "And I want a large box of chalk, too.",
    "start": 47.115,
    "end": 50.858,
    "zh": "我还要一大盒粉笔。",
    "zh_hant": "我還要一大盒粉筆。"
  },
  {
    "index": 15,
    "text": "I only have small boxes.",
    "start": 51.739,
    "end": 54.121,
    "zh": "我只有小盒的。",
    "zh_hant": "我只有小盒的。"
  },
  {
    "index": 16,
    "text": "Do you want one?",
    "start": 54.401,
    "end": 55.622,
    "zh": "你要一盒吗？",
    "zh_hant": "你要一盒嗎？"
  },
  {
    "index": 17,
    "text": "No, thank you.",
    "start": 56.283,
    "end": 57.363,
    "zh": "不了，谢谢。",
    "zh_hant": "不了，謝謝。"
  },
  {
    "index": 18,
    "text": "Is that all?",
    "start": 58.124,
    "end": 59.125,
    "zh": "就这些吗？",
    "zh_hant": "就這些嗎？"
  },
  {
    "index": 19,
    "text": "That's all, thank you.",
    "start": 59.526,
    "end": 60.966,
    "zh": "就这些了，谢谢。",
    "zh_hant": "就這些了，謝謝。"
  },
  {
    "index": 20,
    "text": "What else do you want?",
    "start": 61.828,
    "end": 63.208,
    "zh": "你还想要什么？",
    "zh_hant": "你還想要什麼？"
  },
  {
    "index": 21,
    "text": "I want my change.",
    "start": 63.429,
    "end": 65.13,
    "zh": "我要找零。",
    "zh_hant": "我要找零。"
  }
]
