[
  {
    "index": 0,
    "text": "Lesson 67 The weekend",
    "start": 1.51,
    "end": 5.532,
    "zh": "第67课 周末",
    "zh_hant": "第67課 週末"
  },
  {
    "index": 1,
    "text": "Listen to the tape then answer this question.",
    "start": 7.293,
    "end": 11.255,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 2,
    "text": "What are the Johnsons going to do at the weekend?",
    "start": 13.456,
    "end": 17.618,
    "zh": "约翰逊一家周末打算做什么？",
    "zh_hant": "約翰遜一家週末打算做什麼？"
  },
  {
    "index": 3,
    "text": "Hello.",
    "start": 19.88,
    "end": 20.64,
    "zh": "你好。",
    "zh_hant": "你好。"
  },
  {
    "index": 4,
    "text": "Were you at the butcher's?",
    "start": 21.04,
    "end": 23.081,
    "zh": "你在肉店吗？",
    "zh_hant": "你在肉店嗎？"
  },
  {
    "index": 5,
    "text": "Yes, I was.",
    "start": 23.542,
    "end": 25.122,
    "zh": "是的，我在。",
    "zh_hant": "是的，我在。"
  },
  {
    "index": 6,
    "text": "Were you at the butcher's, too?",
    "start": 25.182,
    "end": 27.183,
    "zh": "你也在肉店吗？",
    "zh_hant": "你也在肉店嗎？"
  },
  {
    "index": 7,
    "text": "No, I wasn't.",
    "start": 27.764,
    "end": 29.624,
    "zh": "不，我不在。",
    "zh_hant": "不，我不在。"
  },
  {
    "index": 8,
    "text": "I was at the greengrocer's.",
    "start": 29.905,
    "end": 32.126,
    "zh": "我在蔬菜水果店。",
    "zh_hant": "我在蔬菜水果店。"
  },
  {
    "index": 9,
    "text": "How's Jimmy today?",
    "start": 32.506,
    "end": 34.407,
    "zh": "吉米今天怎么样？",
    "zh_hant": "吉米今天怎麼樣？"
  },
  {
    "index": 10,
    "text": "He's very well, thank you.",
    "start": 35.267,
    "end": 37.148,
    "zh": "他很好，谢谢你。",
    "zh_hant": "他很好，謝謝你。"
  },
  {
    "index": 11,
    "text": "Was he absent from school last week?",
    "start": 37.949,
    "end": 40.67,
    "zh": "他上周缺课了吗？",
    "zh_hant": "他上週缺課了嗎？"
  },
  {
    "index": 12,
    "text": "Yes, he was.",
    "start": 41.671,
    "end": 43.312,
    "zh": "是的，他缺课了。",
    "zh_hant": "是的，他缺課了。"
  },
  {
    "index": 13,
    "text": "He was absent on Monday,",
    "start": 43.632,
    "end": 46.534,
    "zh": "他星期一没来上课，",
    "zh_hant": "他星期一沒來上課，"
  },
  {
    "index": 14,
    "text": "Tuesday, Wednesday and Thursday.",
    "start": 46.294,
    "end": 49.176,
    "zh": "星期二、星期三和星期四也没来。",
    "zh_hant": "星期二、星期三和星期四也沒來。"
  },
  {
    "index": 15,
    "text": "How are you all keeping?",
    "start": 49.897,
    "end": 51.658,
    "zh": "你们大家都好吗？",
    "zh_hant": "你們大家都好嗎？"
  },
  {
    "index": 16,
    "text": "Very well, thank you.",
    "start": 52.099,
    "end": 53.68,
    "zh": "很好，谢谢你。",
    "zh_hant": "很好，謝謝你。"
  },
  {
    "index": 17,
    "text": "We're going to spend three days in the country!",
    "start": 54.001,
    "end": 56.782,
    "zh": "我们要去乡下待三天！",
    "zh_hant": "我們要去鄉下待三天！"
  },
  {
    "index": 18,
    "text": "We're going to stay at my mother's for the weekend.",
    "start": 57.123,
    "end": 59.945,
    "zh": "我们要在我母亲家住周末。",
    "zh_hant": "我們要在我母親家住週末。"
  },
  {
    "index": 19,
    "text": "Friday, Saturday and Sunday in the country!",
    "start": 60.906,
    "end": 64.288,
    "zh": "星期五、星期六和星期天都在乡下！",
    "zh_hant": "星期五、星期六和星期天都在鄉下！"
  },
  {
    "index": 20,
    "text": "Aren't you lucky!",
    "start": 64.709,
    "end": 65.97,
    "zh": "你们真幸运！",
    "zh_hant": "你們真幸運！"
  }
]
