[
  {
    "index": 0,
    "text": "Lesson 73.",
    "start": 1.55,
    "end": 4.182,
    "zh": "第73课。",
    "zh_hant": "第73課。"
  },
  {
    "index": 1,
    "text": "The way to King Street.",
    "start": 4.232,
    "end": 6.493,
    "zh": "去国王街的路。",
    "zh_hant": "去國王街的路。"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 7.613,
    "end": 11.215,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "Why did the man need a phrasebook?",
    "start": 13.356,
    "end": 16.357,
    "zh": "那个人为什么需要一本常用语手册？",
    "zh_hant": "那個人為什麼需要一本常用語手冊？"
  },
  {
    "index": 4,
    "text": "Last week Mrs. Mills went to London.",
    "start": 18.779,
    "end": 22.04,
    "zh": "上周，米尔斯夫人去了伦敦。",
    "zh_hant": "上週，米爾斯夫人去了倫敦。"
  },
  {
    "index": 5,
    "text": "She does not know London very well, and she lost her way.",
    "start": 22.821,
    "end": 26.943,
    "zh": "她对伦敦不太熟悉，结果迷了路。",
    "zh_hant": "她對倫敦不太熟悉，結果迷了路。"
  },
  {
    "index": 6,
    "text": "Suddenly, she saw a man near a bus stop.",
    "start": 28.364,
    "end": 31.845,
    "zh": "突然，她看到公共汽车站附近有一个男人。",
    "zh_hant": "突然，她看到公共汽車站附近有一個男人。"
  },
  {
    "index": 7,
    "text": "'I can ask him the way,'",
    "start": 31.525,
    "end": 34.947,
    "zh": "“我可以问他路，”",
    "zh_hant": "“我可以問他路，”"
  },
  {
    "index": 8,
    "text": "she said to herself.",
    "start": 34.667,
    "end": 36.367,
    "zh": "她自言自语道。",
    "zh_hant": "她自言自語道。"
  },
  {
    "index": 9,
    "text": "'Excuse me,' she said.",
    "start": 37.848,
    "end": 40.309,
    "zh": "“打扰一下，”她说。",
    "zh_hant": "“打擾一下，”她說。"
  },
  {
    "index": 10,
    "text": "'Can you tell me",
    "start": 39.959,
    "end": 42.551,
    "zh": "“你能告诉我",
    "zh_hant": "“你能告訴我"
  },
  {
    "index": 11,
    "text": "the way to King Street, please?'",
    "start": 42.201,
    "end": 44.712,
    "zh": "去国王街的路吗？”",
    "zh_hant": "去國王街的路嗎？”"
  },
  {
    "index": 12,
    "text": "The man smiled pleasantly.",
    "start": 46.113,
    "end": 48.393,
    "zh": "那个男人愉快地笑了笑。",
    "zh_hant": "那個男人愉快地笑了笑。"
  },
  {
    "index": 13,
    "text": "He did not understand English!",
    "start": 49.294,
    "end": 52.135,
    "zh": "他听不懂英语！",
    "zh_hant": "他聽不懂英語！"
  },
  {
    "index": 14,
    "text": "He spoke German.",
    "start": 52.596,
    "end": 54.396,
    "zh": "他说德语。",
    "zh_hant": "他說德語。"
  },
  {
    "index": 15,
    "text": "He was a tourist.",
    "start": 54.977,
    "end": 56.658,
    "zh": "他是个游客。",
    "zh_hant": "他是個遊客。"
  },
  {
    "index": 16,
    "text": "Then he put his hand into his pocket,",
    "start": 57.738,
    "end": 60.68,
    "zh": "然后他把手伸进口袋，",
    "zh_hant": "然後他把手伸進口袋，"
  },
  {
    "index": 17,
    "text": "and took out a phrasebook.",
    "start": 61.02,
    "end": 62.961,
    "zh": "掏出一本常用语手册。",
    "zh_hant": "掏出一本常用語手冊。"
  },
  {
    "index": 18,
    "text": "He opened the book and found a phrase.",
    "start": 64.402,
    "end": 67.543,
    "zh": "他打开书，找到一个短语。",
    "zh_hant": "他開啟書，找到一個短語。"
  },
  {
    "index": 19,
    "text": "He read the phrase slowly.",
    "start": 68.544,
    "end": 71.285,
    "zh": "他慢慢地读那个短语。",
    "zh_hant": "他慢慢地讀那個短語。"
  },
  {
    "index": 20,
    "text": "'I am sorry,'",
    "start": 71.785,
    "end": 75.347,
    "zh": "“对不起，”",
    "zh_hant": "“對不起，”"
  },
  {
    "index": 21,
    "text": "he said.",
    "start": 75.607,
    "end": 76.707,
    "zh": "他说。",
    "zh_hant": "他說。"
  },
  {
    "index": 22,
    "text": "'I do not speak English.'",
    "start": 76.357,
    "end": 81.93,
    "zh": "“我不会说英语。”",
    "zh_hant": "“我不會說英語。”"
  }
]
