[
  {
    "index": 0,
    "text": "Lesson 135 The latest",
    "start": 0.891,
    "end": 4.972,
    "zh": "第135课 最新",
    "zh_hant": "第135課 最新"
  },
  {
    "index": 1,
    "text": "report",
    "start": 4.672,
    "end": 5.733,
    "zh": "报道",
    "zh_hant": "報道"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 6.814,
    "end": 11.296,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "Is Karen Marsh going to retire,",
    "start": 12.196,
    "end": 15.638,
    "zh": "凯伦·马什真的要退休吗，",
    "zh_hant": "凱倫·馬什真的要退休嗎，"
  },
  {
    "index": 4,
    "text": "do you think?",
    "start": 15.598,
    "end": 16.938,
    "zh": "你觉得呢？",
    "zh_hant": "你覺得呢？"
  },
  {
    "index": 5,
    "text": "Are you really going to retire, Miss Marsh?",
    "start": 18.8,
    "end": 22.661,
    "zh": "马什小姐，您真的打算退休吗？",
    "zh_hant": "馬什小姐，您真的打算退休嗎？"
  },
  {
    "index": 6,
    "text": "I may.",
    "start": 23.302,
    "end": 24.402,
    "zh": "可能吧。",
    "zh_hant": "可能吧。"
  },
  {
    "index": 7,
    "text": "I can't make up my mind.",
    "start": 24.803,
    "end": 27.564,
    "zh": "我还没拿定主意。",
    "zh_hant": "我還沒拿定主意。"
  },
  {
    "index": 8,
    "text": "I will have to ask my future husband.",
    "start": 28.084,
    "end": 32.026,
    "zh": "我得问问我的未婚夫。",
    "zh_hant": "我得問問我的未婚夫。"
  },
  {
    "index": 9,
    "text": "He won't let me make another film.",
    "start": 32.346,
    "end": 35.908,
    "zh": "他不会让我再拍电影了。",
    "zh_hant": "他不會讓我再拍電影了。"
  },
  {
    "index": 10,
    "text": "Your future husband, Miss Marsh?",
    "start": 36.609,
    "end": 39.69,
    "zh": "您的未婚夫，马什小姐？",
    "zh_hant": "您的未婚夫，馬什小姐？"
  },
  {
    "index": 11,
    "text": "Yes.",
    "start": 39.971,
    "end": 41.051,
    "zh": "是的。",
    "zh_hant": "是的。"
  },
  {
    "index": 12,
    "text": "Let me introduce him to you.",
    "start": 41.131,
    "end": 43.812,
    "zh": "让我把他介绍给您。",
    "zh_hant": "讓我把他介紹給您。"
  },
  {
    "index": 13,
    "text": "His name is Carlos.",
    "start": 44.153,
    "end": 47.234,
    "zh": "他叫卡洛斯。",
    "zh_hant": "他叫卡洛斯。"
  },
  {
    "index": 14,
    "text": "We're going to get married next week.",
    "start": 47.634,
    "end": 51.796,
    "zh": "我们下星期就要结婚了。",
    "zh_hant": "我們下星期就要結婚了。"
  },
  {
    "index": 15,
    "text": "Look, Liz!",
    "start": 53.037,
    "end": 54.437,
    "zh": "看，莉兹！",
    "zh_hant": "看，莉茲！"
  },
  {
    "index": 16,
    "text": "Here's another report about Karen Marsh.",
    "start": 54.598,
    "end": 58.98,
    "zh": "这里又有一篇关于凯伦·马什的报道。",
    "zh_hant": "這裡又有一篇關於凱倫·馬什的報道。"
  },
  {
    "index": 17,
    "text": "Listen: 'Karen Marsh:",
    "start": 59.24,
    "end": 62.581,
    "zh": "听：‘凯伦·马什：",
    "zh_hant": "聽：‘凱倫·馬什："
  },
  {
    "index": 18,
    "text": "The latest.",
    "start": 62.602,
    "end": 64.162,
    "zh": "最新消息。",
    "zh_hant": "最新訊息。"
  },
  {
    "index": 19,
    "text": "At her London Hotel today",
    "start": 64.623,
    "end": 67.564,
    "zh": "今天在伦敦的酒店",
    "zh_hant": "今天在倫敦的酒店"
  },
  {
    "index": 20,
    "text": "Miss Marsh told reporters",
    "start": 67.884,
    "end": 71.046,
    "zh": "马什小姐告诉记者",
    "zh_hant": "馬什小姐告訴記者"
  },
  {
    "index": 21,
    "text": "she might retire.",
    "start": 71.026,
    "end": 73.147,
    "zh": "她可能退休。",
    "zh_hant": "她可能退休。"
  },
  {
    "index": 22,
    "text": "She said she couldn't make up her mind.",
    "start": 73.787,
    "end": 77.829,
    "zh": "她说她还没拿定主意。",
    "zh_hant": "她說她還沒拿定主意。"
  },
  {
    "index": 23,
    "text": "She said",
    "start": 78.149,
    "end": 79.43,
    "zh": "她说",
    "zh_hant": "她說"
  },
  {
    "index": 24,
    "text": "she would have to ask her future husband.",
    "start": 79.37,
    "end": 83.653,
    "zh": "她得问问她的未婚夫。",
    "zh_hant": "她得問問她的未婚夫。"
  },
  {
    "index": 25,
    "text": "She said",
    "start": 84.413,
    "end": 85.674,
    "zh": "她说",
    "zh_hant": "她說"
  },
  {
    "index": 26,
    "text": "her future husband would not let her make",
    "start": 85.554,
    "end": 89.976,
    "zh": "她的未婚夫不会让她再拍",
    "zh_hant": "她的未婚夫不會讓她再拍"
  },
  {
    "index": 27,
    "text": "another film.",
    "start": 89.696,
    "end": 91.337,
    "zh": "电影了。",
    "zh_hant": "電影了。"
  },
  {
    "index": 28,
    "text": "Then she introduced us to Carlos",
    "start": 92.078,
    "end": 96.28,
    "zh": "然后她把卡洛斯介绍给我们",
    "zh_hant": "然後她把卡洛斯介紹給我們"
  },
  {
    "index": 29,
    "text": "and told us they would get married",
    "start": 96.34,
    "end": 99.782,
    "zh": "并告诉我们他们将于",
    "zh_hant": "並告訴我們他們將於"
  },
  {
    "index": 30,
    "text": "next week.'",
    "start": 99.642,
    "end": 101.463,
    "zh": "下星期结婚。’",
    "zh_hant": "下星期結婚。’"
  },
  {
    "index": 31,
    "text": "That's sensational news,",
    "start": 101.763,
    "end": 104.745,
    "zh": "这可是轰动性的消息，",
    "zh_hant": "這可是轟動性的訊息，"
  },
  {
    "index": 32,
    "text": "isn't it, Kate?",
    "start": 104.745,
    "end": 106.766,
    "zh": "是吧，凯特？",
    "zh_hant": "是吧，凱特？"
  },
  {
    "index": 33,
    "text": "It certainly is.",
    "start": 107.427,
    "end": 109.568,
    "zh": "确实如此。",
    "zh_hant": "確實如此。"
  },
  {
    "index": 34,
    "text": "He'll be her sixth husband!",
    "start": 109.768,
    "end": 113.49,
    "zh": "他将是她的第六任丈夫！",
    "zh_hant": "他將是她的第六任丈夫！"
  }
]
