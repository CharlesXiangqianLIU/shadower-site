[
  {
    "index": 0,
    "text": "Lesson 63 Thank you, doctor.",
    "start": 0.75,
    "end": 5.091,
    "zh": "第63课 谢谢你,医生。",
    "zh_hant": "第63課 謝謝你,醫生。"
  },
  {
    "index": 1,
    "text": "Listen to the tape then answer this question.",
    "start": 6.431,
    "end": 11.471,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 2,
    "text": "Who else is in bed today?",
    "start": 12.536,
    "end": 15.578,
    "zh": "今天还有谁躺在床上？",
    "zh_hant": "今天還有誰躺在床上？"
  },
  {
    "index": 3,
    "text": "Why?",
    "start": 16.378,
    "end": 17.278,
    "zh": "为什么？",
    "zh_hant": "為什麼？"
  },
  {
    "index": 4,
    "text": "How's Jimmy today?",
    "start": 19.16,
    "end": 21.16,
    "zh": "吉米今天怎么样？",
    "zh_hant": "吉米今天怎麼樣？"
  },
  {
    "index": 5,
    "text": "Better.",
    "start": 21.501,
    "end": 22.441,
    "zh": "好多了。",
    "zh_hant": "好多了。"
  },
  {
    "index": 6,
    "text": "Thank you, doctor.",
    "start": 22.621,
    "end": 24.322,
    "zh": "谢谢你，医生。",
    "zh_hant": "謝謝你，醫生。"
  },
  {
    "index": 7,
    "text": "Can I see him please, Mrs. Williams?",
    "start": 24.903,
    "end": 28.484,
    "zh": "威廉姆斯夫人，我现在能看看他吗？",
    "zh_hant": "威廉姆斯夫人，我現在能看看他嗎？"
  },
  {
    "index": 8,
    "text": "Certainly, doctor.",
    "start": 29.285,
    "end": 31.065,
    "zh": "当然可以，医生。",
    "zh_hant": "當然可以，醫生。"
  },
  {
    "index": 9,
    "text": "Come upstairs.",
    "start": 31.266,
    "end": 33.146,
    "zh": "上楼来吧。",
    "zh_hant": "上樓來吧。"
  },
  {
    "index": 10,
    "text": "You look very well, Jimmy.",
    "start": 34.087,
    "end": 36.548,
    "zh": "你看上去很好，吉米。",
    "zh_hant": "你看上去很好，吉米。"
  },
  {
    "index": 11,
    "text": "You are better now, but you mustn't get up yet.",
    "start": 37.089,
    "end": 41.811,
    "zh": "你现在好多了，但还不能起床。",
    "zh_hant": "你現在好多了，但還不能起床。"
  },
  {
    "index": 12,
    "text": "You must stay in bed for another two days.",
    "start": 42.392,
    "end": 47.034,
    "zh": "你必须再卧床两天。",
    "zh_hant": "你必須再臥床兩天。"
  },
  {
    "index": 13,
    "text": "The boy mustn't go to school yet, Mrs. Williams.",
    "start": 48.235,
    "end": 52.777,
    "zh": "威廉姆斯夫人，这孩子还不能去上学。",
    "zh_hant": "威廉姆斯夫人，這孩子還不能去上學。"
  },
  {
    "index": 14,
    "text": "And he mustn't eat rich food.",
    "start": 53.177,
    "end": 56.338,
    "zh": "而且他不能吃油腻的食物。",
    "zh_hant": "而且他不能吃油膩的食物。"
  },
  {
    "index": 15,
    "text": "Does he have a temperature, doctor?",
    "start": 58.079,
    "end": 61.661,
    "zh": "医生，他发烧吗？",
    "zh_hant": "醫生，他發燒嗎？"
  },
  {
    "index": 16,
    "text": "No, he doesn't.",
    "start": 62.061,
    "end": 63.922,
    "zh": "不，他不发烧。",
    "zh_hant": "不，他不發燒。"
  },
  {
    "index": 17,
    "text": "Must he stay in bed?",
    "start": 64.062,
    "end": 66.723,
    "zh": "他必须卧床吗？",
    "zh_hant": "他必須臥床嗎？"
  },
  {
    "index": 18,
    "text": "Yes.",
    "start": 66.984,
    "end": 67.864,
    "zh": "是的。",
    "zh_hant": "是的。"
  },
  {
    "index": 19,
    "text": "He must remain in bed for another two days.",
    "start": 67.844,
    "end": 72.326,
    "zh": "他必须再卧床两天。",
    "zh_hant": "他必須再臥床兩天。"
  },
  {
    "index": 20,
    "text": "He can get up for about two hours each day,",
    "start": 72.767,
    "end": 77.529,
    "zh": "他每天可以起床大约两个小时，",
    "zh_hant": "他每天可以起床大約兩個小時，"
  },
  {
    "index": 21,
    "text": "but you must keep the room warm.",
    "start": 77.849,
    "end": 81.492,
    "zh": "但你必须保持房间暖和。",
    "zh_hant": "但你必須保持房間暖和。"
  },
  {
    "index": 22,
    "text": "Where's Mr. Williams this evening?",
    "start": 83.375,
    "end": 86.839,
    "zh": "威廉姆斯先生今晚在哪里？",
    "zh_hant": "威廉姆斯先生今晚在哪裡？"
  },
  {
    "index": 23,
    "text": "He's in bed, doctor.",
    "start": 87.32,
    "end": 90.002,
    "zh": "他在床上，医生。",
    "zh_hant": "他在床上，醫生。"
  },
  {
    "index": 24,
    "text": "Can you see him please?",
    "start": 90.383,
    "end": 92.966,
    "zh": "你能看看他吗？",
    "zh_hant": "你能看看他嗎？"
  },
  {
    "index": 25,
    "text": "He has a bad cold, too!",
    "start": 93.227,
    "end": 96.47,
    "zh": "他也得了重感冒！",
    "zh_hant": "他也得了重感冒！"
  }
]
