[
  {
    "index": 0,
    "text": "Why did the writer complain to the people behind him?",
    "start": 9.81,
    "end": 14.212,
    "zh": "为什么作者向坐在他后面的人抱怨？",
    "zh_hant": "為什麼作者向坐在他後面的人抱怨？"
  },
  {
    "index": 1,
    "text": "Last week I went to the theatre.",
    "start": 15.933,
    "end": 19.035,
    "zh": "上周我去了剧院。",
    "zh_hant": "上週我去了劇院。"
  },
  {
    "index": 2,
    "text": "I had a very good seat.",
    "start": 19.475,
    "end": 21.696,
    "zh": "我的座位很好。",
    "zh_hant": "我的座位很好。"
  },
  {
    "index": 3,
    "text": "The play was very interesting.",
    "start": 22.056,
    "end": 24.577,
    "zh": "这场戏非常有趣。",
    "zh_hant": "這場戲非常有趣。"
  },
  {
    "index": 4,
    "text": "I did not enjoy it.",
    "start": 25.318,
    "end": 26.999,
    "zh": "但我并没有享受它。",
    "zh_hant": "但我並沒有享受它。"
  },
  {
    "index": 5,
    "text": "A young man and a young woman were sitting behind me.",
    "start": 27.419,
    "end": 31.481,
    "zh": "一个年轻男人和年轻女人坐在我后面。",
    "zh_hant": "一個年輕男人和年輕女人坐在我後面。"
  },
  {
    "index": 6,
    "text": "They were talking loudly.",
    "start": 31.981,
    "end": 34.162,
    "zh": "他们大声说话。",
    "zh_hant": "他們大聲說話。"
  },
  {
    "index": 7,
    "text": "I got very angry.",
    "start": 34.743,
    "end": 36.883,
    "zh": "我非常生气。",
    "zh_hant": "我非常生氣。"
  },
  {
    "index": 8,
    "text": "I could not hear the actors.",
    "start": 37.464,
    "end": 40.145,
    "zh": "我听不到演员的声音。",
    "zh_hant": "我聽不到演員的聲音。"
  },
  {
    "index": 9,
    "text": "I turned round.",
    "start": 40.726,
    "end": 42.246,
    "zh": "我转过身。",
    "zh_hant": "我轉過身。"
  },
  {
    "index": 10,
    "text": "I looked at the man and the woman angrily.",
    "start": 42.927,
    "end": 46.428,
    "zh": "我愤怒地看着那对男女。",
    "zh_hant": "我憤怒地看著那對男女。"
  },
  {
    "index": 11,
    "text": "They did not pay any attention.",
    "start": 47.269,
    "end": 50.01,
    "zh": "他们毫不在意。",
    "zh_hant": "他們毫不在意。"
  },
  {
    "index": 12,
    "text": "In the end, I could not bear it.",
    "start": 50.671,
    "end": 54.434,
    "zh": "最后，我忍无可忍。",
    "zh_hant": "最後，我忍無可忍。"
  },
  {
    "index": 13,
    "text": "I turned round again.",
    "start": 55.055,
    "end": 56.836,
    "zh": "我再次转过身。",
    "zh_hant": "我再次轉過身。"
  },
  {
    "index": 14,
    "text": "'I can't hear a word!'",
    "start": 56.596,
    "end": 60.7,
    "zh": "“我一个字也听不见！”",
    "zh_hant": "“我一個字也聽不見！”"
  },
  {
    "index": 15,
    "text": "I said angrily.",
    "start": 61.02,
    "end": 62.782,
    "zh": "我生气地说。",
    "zh_hant": "我生氣地說。"
  },
  {
    "index": 16,
    "text": "'It's none of your business,' the young man said rudely.",
    "start": 62.582,
    "end": 68.567,
    "zh": "“这不关你的事，”年轻男人粗鲁地说。",
    "zh_hant": "“這不關你的事，”年輕男人粗魯地說。"
  },
  {
    "index": 17,
    "text": "'This is a private conversation!'",
    "start": 68.487,
    "end": 71.83,
    "zh": "“这是私人谈话！”",
    "zh_hant": "“這是私人談話！”"
  }
]
