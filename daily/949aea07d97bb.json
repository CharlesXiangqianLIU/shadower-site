[
  {
    "index": 0,
    "text": "Lesson 99.",
    "start": 1.57,
    "end": 4.042,
    "zh": "第99课。",
    "zh_hant": "第99課。"
  },
  {
    "index": 1,
    "text": "Ow!",
    "start": 4.092,
    "end": 4.872,
    "zh": "哎哟！",
    "zh_hant": "哎喲！"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 5.973,
    "end": 9.734,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "Must Andy go to see the doctor?",
    "start": 11.896,
    "end": 14.837,
    "zh": "安迪必须去看医生吗？",
    "zh_hant": "安迪必須去看醫生嗎？"
  },
  {
    "index": 4,
    "text": "Ow!",
    "start": 17.218,
    "end": 18.038,
    "zh": "哎哟！",
    "zh_hant": "哎喲！"
  },
  {
    "index": 5,
    "text": "What's the matter, Andy?",
    "start": 18.619,
    "end": 20.159,
    "zh": "怎么了，安迪？",
    "zh_hant": "怎麼了，安迪？"
  },
  {
    "index": 6,
    "text": "I slipped and fell downstairs.",
    "start": 20.58,
    "end": 23.421,
    "zh": "我滑倒了，摔下了楼梯。",
    "zh_hant": "我滑倒了，摔下了樓梯。"
  },
  {
    "index": 7,
    "text": "Have you hurt yourself?",
    "start": 23.781,
    "end": 25.642,
    "zh": "你伤到自己了吗？",
    "zh_hant": "你傷到自己了嗎？"
  },
  {
    "index": 8,
    "text": "Yes, I have.",
    "start": 25.802,
    "end": 27.463,
    "zh": "是的，我伤了。",
    "zh_hant": "是的，我傷了。"
  },
  {
    "index": 9,
    "text": "I think that I've hurt my back.",
    "start": 27.663,
    "end": 30.124,
    "zh": "我想我伤到背了。",
    "zh_hant": "我想我傷到背了。"
  },
  {
    "index": 10,
    "text": "Try and stand up.",
    "start": 30.805,
    "end": 32.505,
    "zh": "试着站起来。",
    "zh_hant": "試著站起來。"
  },
  {
    "index": 11,
    "text": "Can you stand up?",
    "start": 33.366,
    "end": 34.766,
    "zh": "你能站起来吗？",
    "zh_hant": "你能站起來嗎？"
  },
  {
    "index": 12,
    "text": "Here.",
    "start": 35.647,
    "end": 36.407,
    "zh": "来。",
    "zh_hant": "來。"
  },
  {
    "index": 13,
    "text": "Let me help you.",
    "start": 36.327,
    "end": 37.668,
    "zh": "让我帮你。",
    "zh_hant": "讓我幫你。"
  },
  {
    "index": 14,
    "text": "I'm sorry, Lucy.",
    "start": 38.549,
    "end": 40.269,
    "zh": "对不起，露西。",
    "zh_hant": "對不起，露西。"
  },
  {
    "index": 15,
    "text": "I'm afraid that I can't get up.",
    "start": 40.349,
    "end": 42.992,
    "zh": "恐怕我站不起来。",
    "zh_hant": "恐怕我站不起來。"
  },
  {
    "index": 16,
    "text": "I think that the doctor had better see you.",
    "start": 44.274,
    "end": 46.957,
    "zh": "我觉得医生最好来看看你。",
    "zh_hant": "我覺得醫生最好來看看你。"
  },
  {
    "index": 17,
    "text": "I'll phone Dr. Carter.",
    "start": 47.398,
    "end": 49.3,
    "zh": "我会给卡特医生打电话。",
    "zh_hant": "我會給卡特醫生打電話。"
  },
  {
    "index": 18,
    "text": "The doctor says that he will come at once.",
    "start": 50.782,
    "end": 53.665,
    "zh": "医生说他马上就来。",
    "zh_hant": "醫生說他馬上就來。"
  },
  {
    "index": 19,
    "text": "I'm sure that you need an X-ray, Andy.",
    "start": 54.247,
    "end": 57.17,
    "zh": "我确定你需要拍X光片，安迪。",
    "zh_hant": "我確定你需要拍X光片，安迪。"
  }
]
