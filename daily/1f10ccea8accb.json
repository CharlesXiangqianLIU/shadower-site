[
  {
    "index": 0,
    "text": "Lesson 77 Terrible",
    "start": 1.57,
    "end": 5.352,
    "zh": "第77课 糟糕的",
    "zh_hant": "第77課 糟糕的"
  },
  {
    "index": 1,
    "text": "toothache",
    "start": 5.002,
    "end": 6.132,
    "zh": "牙痛",
    "zh_hant": "牙痛"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 7.553,
    "end": 11.215,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "What time of day is it, do you think?",
    "start": 13.416,
    "end": 15.977,
    "zh": "你觉得现在是什么时间？",
    "zh_hant": "你覺得現在是什麼時間？"
  },
  {
    "index": 4,
    "text": "How do you know?",
    "start": 16.338,
    "end": 17.658,
    "zh": "你怎么知道的？",
    "zh_hant": "你怎麼知道的？"
  },
  {
    "index": 5,
    "text": "Good morning, Mr. Croft.",
    "start": 19.999,
    "end": 21.94,
    "zh": "早上好，克罗夫特先生。",
    "zh_hant": "早上好，克羅夫特先生。"
  },
  {
    "index": 6,
    "text": "Good morning, nurse.",
    "start": 22.421,
    "end": 24.001,
    "zh": "早上好，护士。",
    "zh_hant": "早上好，護士。"
  },
  {
    "index": 7,
    "text": "I want to see the dentist, please.",
    "start": 24.241,
    "end": 26.822,
    "zh": "我想看牙医。",
    "zh_hant": "我想看牙醫。"
  },
  {
    "index": 8,
    "text": "Do you have an appointment?",
    "start": 27.403,
    "end": 29.384,
    "zh": "您有预约吗？",
    "zh_hant": "您有預約嗎？"
  },
  {
    "index": 9,
    "text": "No, I don't.",
    "start": 29.624,
    "end": 31.445,
    "zh": "没有，我没有。",
    "zh_hant": "沒有，我沒有。"
  },
  {
    "index": 10,
    "text": "Is it urgent?",
    "start": 32.225,
    "end": 33.706,
    "zh": "是急事吗？",
    "zh_hant": "是急事嗎？"
  },
  {
    "index": 11,
    "text": "Yes, it is.",
    "start": 34.166,
    "end": 36.047,
    "zh": "是的，是急事。",
    "zh_hant": "是的，是急事。"
  },
  {
    "index": 12,
    "text": "It's very urgent.",
    "start": 36.267,
    "end": 38.208,
    "zh": "非常紧急。",
    "zh_hant": "非常緊急。"
  },
  {
    "index": 13,
    "text": "I feel awful.",
    "start": 38.869,
    "end": 40.869,
    "zh": "我感觉很难受。",
    "zh_hant": "我感覺很難受。"
  },
  {
    "index": 14,
    "text": "I have a terrible toothache.",
    "start": 41.49,
    "end": 43.931,
    "zh": "我牙痛得厉害。",
    "zh_hant": "我牙痛得厲害。"
  },
  {
    "index": 15,
    "text": "Can you come",
    "start": 44.732,
    "end": 46.372,
    "zh": "您能在",
    "zh_hant": "您能在"
  },
  {
    "index": 16,
    "text": "at 10 a.m. on Monday, April 24th?",
    "start": 46.073,
    "end": 51.835,
    "zh": "4月24日星期一上午10点来吗？",
    "zh_hant": "4月24日星期一上午10點來嗎？"
  },
  {
    "index": 17,
    "text": "I must see the dentist now, nurse.",
    "start": 53.796,
    "end": 57.398,
    "zh": "我现在必须看牙医，护士。",
    "zh_hant": "我現在必須看牙醫，護士。"
  },
  {
    "index": 18,
    "text": "The dentist is very busy at the moment.",
    "start": 57.998,
    "end": 61.78,
    "zh": "牙医现在很忙。",
    "zh_hant": "牙醫現在很忙。"
  },
  {
    "index": 19,
    "text": "Can you come at 2 p.m. ?",
    "start": 62.541,
    "end": 65.95,
    "zh": "您能下午2点来吗？",
    "zh_hant": "您能下午2點來嗎？"
  },
  {
    "index": 20,
    "text": "That's very late.",
    "start": 65.982,
    "end": 67.883,
    "zh": "那太晚了。",
    "zh_hant": "那太晚了。"
  },
  {
    "index": 21,
    "text": "Can the dentist see me now?",
    "start": 68.444,
    "end": 71.005,
    "zh": "牙医现在能见我吗？",
    "zh_hant": "牙醫現在能見我嗎？"
  },
  {
    "index": 22,
    "text": "I'm afraid that he can't, Mr. Croft.",
    "start": 71.925,
    "end": 75.267,
    "zh": "恐怕不行，克罗夫特先生。",
    "zh_hant": "恐怕不行，克羅夫特先生。"
  },
  {
    "index": 23,
    "text": "Can't you wait till this afternoon?",
    "start": 75.747,
    "end": 78.668,
    "zh": "您不能等到今天下午吗？",
    "zh_hant": "您不能等到今天下午嗎？"
  },
  {
    "index": 24,
    "text": "I can wait, but my toothache can't!",
    "start": 79.609,
    "end": 83.047,
    "zh": "我可以等，可我的牙痛等不了！",
    "zh_hant": "我可以等，可我的牙痛等不了！"
  }
]
