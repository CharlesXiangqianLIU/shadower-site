[
  {
    "index": 0,
    "text": "Lesson 113 Small",
    "start": 1.53,
    "end": 5.572,
    "zh": "第113课 零钱",
    "zh_hant": "第113課 零錢"
  },
  {
    "index": 1,
    "text": "change",
    "start": 5.222,
    "end": 6.272,
    "zh": "变化",
    "zh_hant": "變化"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 7.213,
    "end": 10.555,
    "zh": "听录音，然后回答问题。",
    "zh_hant": "聽錄音，然後回答問題。"
  },
  {
    "index": 3,
    "text": "Who has got some small change?",
    "start": 12.576,
    "end": 15.017,
    "zh": "谁有零钱？",
    "zh_hant": "誰有零錢？"
  },
  {
    "index": 4,
    "text": "Fares, please!",
    "start": 17.278,
    "end": 18.559,
    "zh": "请买票！",
    "zh_hant": "請買票！"
  },
  {
    "index": 5,
    "text": "Trafalgar Square, please.",
    "start": 19.439,
    "end": 21.08,
    "zh": "请到特拉法加广场。",
    "zh_hant": "請到特拉法加廣場。"
  },
  {
    "index": 6,
    "text": "I'm sorry, sir.",
    "start": 22.001,
    "end": 23.341,
    "zh": "对不起，先生。",
    "zh_hant": "對不起，先生。"
  },
  {
    "index": 7,
    "text": "I can't change a ten-pound note.",
    "start": 23.521,
    "end": 26.022,
    "zh": "我找不开十英镑的纸币。",
    "zh_hant": "我找不開十英鎊的紙幣。"
  },
  {
    "index": 8,
    "text": "Haven't you got any small change?",
    "start": 26.123,
    "end": 28.624,
    "zh": "您没有零钱吗？",
    "zh_hant": "您沒有零錢嗎？"
  },
  {
    "index": 9,
    "text": "I've got no small change, I am afraid.",
    "start": 29.364,
    "end": 31.885,
    "zh": "恐怕我没有零钱。",
    "zh_hant": "恐怕我沒有零錢。"
  },
  {
    "index": 10,
    "text": "I'll ask some of the passengers.",
    "start": 32.766,
    "end": 34.687,
    "zh": "我去问问其他乘客。",
    "zh_hant": "我去問問其他乘客。"
  },
  {
    "index": 11,
    "text": "Have you any small change, sir?",
    "start": 35.588,
    "end": 37.628,
    "zh": "先生，您有零钱吗？",
    "zh_hant": "先生，您有零錢嗎？"
  },
  {
    "index": 12,
    "text": "I'm sorry.",
    "start": 38.209,
    "end": 39.189,
    "zh": "对不起。",
    "zh_hant": "對不起。"
  },
  {
    "index": 13,
    "text": "I've got none.",
    "start": 39.43,
    "end": 40.71,
    "zh": "我一点儿也没有。",
    "zh_hant": "我一點兒也沒有。"
  },
  {
    "index": 14,
    "text": "I haven't got any either.",
    "start": 42.211,
    "end": 44.012,
    "zh": "我也没有。",
    "zh_hant": "我也沒有。"
  },
  {
    "index": 15,
    "text": "Can you change this ten-pound note, madam?",
    "start": 45.093,
    "end": 47.914,
    "zh": "女士，您能换开这张十英镑的纸币吗？",
    "zh_hant": "女士，您能換開這張十英鎊的紙幣嗎？"
  },
  {
    "index": 16,
    "text": "I'm afraid I can't.",
    "start": 48.455,
    "end": 49.956,
    "zh": "恐怕我不能。",
    "zh_hant": "恐怕我不能。"
  },
  {
    "index": 17,
    "text": "Neither can I. I'm very sorry, sir.",
    "start": 50.897,
    "end": 55.379,
    "zh": "我也不能。非常抱歉，先生。",
    "zh_hant": "我也不能。非常抱歉，先生。"
  },
  {
    "index": 18,
    "text": "You must get off the bus.",
    "start": 55.56,
    "end": 57.481,
    "zh": "您必须下车。",
    "zh_hant": "您必須下車。"
  },
  {
    "index": 19,
    "text": "None of our passengers can change this note.",
    "start": 57.941,
    "end": 61.023,
    "zh": "我们的乘客中没人能换开这张纸币。",
    "zh_hant": "我們的乘客中沒人能換開這張紙幣。"
  },
  {
    "index": 20,
    "text": "They're all millionaires!",
    "start": 61.564,
    "end": 63.505,
    "zh": "他们都是百万富翁！",
    "zh_hant": "他們都是百萬富翁！"
  },
  {
    "index": 21,
    "text": "Except us.",
    "start": 65.927,
    "end": 67.087,
    "zh": "除了我们。",
    "zh_hant": "除了我們。"
  },
  {
    "index": 22,
    "text": "I've got some small change.",
    "start": 68.228,
    "end": 69.829,
    "zh": "我有一些零钱。",
    "zh_hant": "我有一些零錢。"
  },
  {
    "index": 23,
    "text": "So have I.",
    "start": 70.45,
    "end": 71.41,
    "zh": "我也有。",
    "zh_hant": "我也有。"
  }
]
