[
  {
    "index": 0,
    "text": "Lesson 83 Going",
    "start": 0.851,
    "end": 4.152,
    "zh": "第83课 出行",
    "zh_hant": "第83課 出行"
  },
  {
    "index": 1,
    "text": "on holiday",
    "start": 3.892,
    "end": 5.373,
    "zh": "去度假",
    "zh_hant": "去度假"
  },
  {
    "index": 2,
    "text": "Listen to the tape then",
    "start": 6.553,
    "end": 9.395,
    "zh": "听录音，然后",
    "zh_hant": "聽錄音，然後"
  },
  {
    "index": 3,
    "text": "answer this question.",
    "start": 9.195,
    "end": 11.095,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 4,
    "text": "Where did Sam go for his holiday this year?",
    "start": 12.196,
    "end": 16.638,
    "zh": "今年萨姆去哪儿度假了？",
    "zh_hant": "今年薩姆去哪兒度假了？"
  },
  {
    "index": 5,
    "text": "Hello, Sam.",
    "start": 18.88,
    "end": 20.5,
    "zh": "你好，萨姆。",
    "zh_hant": "你好，薩姆。"
  },
  {
    "index": 6,
    "text": "Come in.",
    "start": 20.481,
    "end": 21.641,
    "zh": "请进。",
    "zh_hant": "請進。"
  },
  {
    "index": 7,
    "text": "Hi, Sam.",
    "start": 23.002,
    "end": 24.442,
    "zh": "嗨，萨姆。",
    "zh_hant": "嗨，薩姆。"
  },
  {
    "index": 8,
    "text": "We're having lunch.",
    "start": 24.663,
    "end": 26.423,
    "zh": "我们正在吃午饭。",
    "zh_hant": "我們正在吃午飯。"
  },
  {
    "index": 9,
    "text": "Do you want to have lunch with us?",
    "start": 26.864,
    "end": 30.125,
    "zh": "你想和我们一起吃午饭吗？",
    "zh_hant": "你想和我們一起吃午飯嗎？"
  },
  {
    "index": 10,
    "text": "No, thank you, Tom.",
    "start": 30.986,
    "end": 33.087,
    "zh": "不，谢谢你，汤姆。",
    "zh_hant": "不，謝謝你，湯姆。"
  },
  {
    "index": 11,
    "text": "I've already had lunch.",
    "start": 33.287,
    "end": 35.608,
    "zh": "我已经吃过午饭了。",
    "zh_hant": "我已經吃過午飯了。"
  },
  {
    "index": 12,
    "text": "I had lunch at half past twelve.",
    "start": 36.088,
    "end": 39.47,
    "zh": "我十二点半吃的午饭。",
    "zh_hant": "我十二點半吃的午飯。"
  },
  {
    "index": 13,
    "text": "Have a cup of coffee then.",
    "start": 39.951,
    "end": 42.492,
    "zh": "那喝杯咖啡吧。",
    "zh_hant": "那喝杯咖啡吧。"
  },
  {
    "index": 14,
    "text": "I've just had a cup, thank you.",
    "start": 43.012,
    "end": 45.973,
    "zh": "我刚喝了一杯，谢谢。",
    "zh_hant": "我剛喝了一杯，謝謝。"
  },
  {
    "index": 15,
    "text": "I had one after my lunch.",
    "start": 46.334,
    "end": 48.895,
    "zh": "我午饭后喝了一杯。",
    "zh_hant": "我午飯後喝了一杯。"
  },
  {
    "index": 16,
    "text": "Let's go into the living room, Carol.",
    "start": 49.935,
    "end": 53.277,
    "zh": "我们去客厅吧，卡罗尔。",
    "zh_hant": "我們去客廳吧，卡羅爾。"
  },
  {
    "index": 17,
    "text": "We can have our coffee there.",
    "start": 53.677,
    "end": 56.378,
    "zh": "我们可以在那儿喝咖啡。",
    "zh_hant": "我們可以在那兒喝咖啡。"
  },
  {
    "index": 18,
    "text": "Excuse the mess, Sam.",
    "start": 57.059,
    "end": 59.76,
    "zh": "请别介意这儿乱，萨姆。",
    "zh_hant": "請別介意這兒亂，薩姆。"
  },
  {
    "index": 19,
    "text": "This room's very untidy.",
    "start": 60.22,
    "end": 63.002,
    "zh": "这个房间太不整洁了。",
    "zh_hant": "這個房間太不整潔了。"
  },
  {
    "index": 20,
    "text": "We're packing our suitcases.",
    "start": 63.422,
    "end": 66.143,
    "zh": "我们正在收拾行李箱。",
    "zh_hant": "我們正在收拾行李箱。"
  },
  {
    "index": 21,
    "text": "We're going to leave tomorrow.",
    "start": 66.444,
    "end": 69.265,
    "zh": "我们明天就要走了。",
    "zh_hant": "我們明天就要走了。"
  },
  {
    "index": 22,
    "text": "Tom and I are going to have a holiday.",
    "start": 69.785,
    "end": 73.787,
    "zh": "汤姆和我要去度假了。",
    "zh_hant": "湯姆和我要去度假了。"
  },
  {
    "index": 23,
    "text": "Aren't you lucky!",
    "start": 74.367,
    "end": 76.108,
    "zh": "你们多幸运啊！",
    "zh_hant": "你們多幸運啊！"
  },
  {
    "index": 24,
    "text": "When are you going to have a holiday, Sam?",
    "start": 77.509,
    "end": 81.233,
    "zh": "你什么时候去度假，萨姆？",
    "zh_hant": "你什麼時候去度假，薩姆？"
  },
  {
    "index": 25,
    "text": "I don't know.",
    "start": 81.795,
    "end": 83.176,
    "zh": "我不知道。",
    "zh_hant": "我不知道。"
  },
  {
    "index": 26,
    "text": "I've already had my holiday this year.",
    "start": 83.517,
    "end": 87.162,
    "zh": "我今年已经休过假了。",
    "zh_hant": "我今年已經休過假了。"
  },
  {
    "index": 27,
    "text": "Where did you go?",
    "start": 88.064,
    "end": 89.626,
    "zh": "你去哪儿了？",
    "zh_hant": "你去哪兒了？"
  },
  {
    "index": 28,
    "text": "I stayed at home!",
    "start": 90.388,
    "end": 92.19,
    "zh": "我待在家里！",
    "zh_hant": "我待在家裡！"
  }
]
