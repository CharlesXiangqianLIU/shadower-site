[
  {
    "index": 0,
    "text": "Lesson 37 Making",
    "start": 0.51,
    "end": 3.992,
    "zh": "第37课 制作",
    "zh_hant": "第37課 製作"
  },
  {
    "index": 1,
    "text": "a bookcase",
    "start": 3.732,
    "end": 5.132,
    "zh": "一个书柜",
    "zh_hant": "一個書櫃"
  },
  {
    "index": 2,
    "text": "Listen to the tape then",
    "start": 6.093,
    "end": 8.934,
    "zh": "听录音，然后",
    "zh_hant": "聽錄音，然後"
  },
  {
    "index": 3,
    "text": "answer this question.",
    "start": 8.714,
    "end": 10.635,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 4,
    "text": "What is Susan's favourite colour?",
    "start": 12.276,
    "end": 15.478,
    "zh": "苏珊最喜欢的颜色是什么？",
    "zh_hant": "蘇珊最喜歡的顏色是什麼？"
  },
  {
    "index": 5,
    "text": "You're working hard, George.",
    "start": 17.419,
    "end": 19.9,
    "zh": "乔治，你干活很努力。",
    "zh_hant": "喬治，你幹活很努力。"
  },
  {
    "index": 6,
    "text": "What are you doing?",
    "start": 20.62,
    "end": 22.521,
    "zh": "你在做什么？",
    "zh_hant": "你在做什麼？"
  },
  {
    "index": 7,
    "text": "I'm making a bookcase.",
    "start": 23.422,
    "end": 25.823,
    "zh": "我在做一个书柜。",
    "zh_hant": "我在做一個書櫃。"
  },
  {
    "index": 8,
    "text": "Give me that hammer please, Dan.",
    "start": 26.723,
    "end": 29.665,
    "zh": "丹，请把那把锤子给我。",
    "zh_hant": "丹，請把那把錘子給我。"
  },
  {
    "index": 9,
    "text": "Which hammer?",
    "start": 30.865,
    "end": 32.186,
    "zh": "哪把锤子？",
    "zh_hant": "哪把錘子？"
  },
  {
    "index": 10,
    "text": "This one?",
    "start": 32.666,
    "end": 33.787,
    "zh": "这把吗？",
    "zh_hant": "這把嗎？"
  },
  {
    "index": 11,
    "text": "No, not that one.",
    "start": 34.127,
    "end": 36.508,
    "zh": "不，不是那把。",
    "zh_hant": "不，不是那把。"
  },
  {
    "index": 12,
    "text": "The big one.",
    "start": 36.488,
    "end": 37.949,
    "zh": "大的那把。",
    "zh_hant": "大的那把。"
  },
  {
    "index": 13,
    "text": "Here you are.",
    "start": 38.889,
    "end": 40.29,
    "zh": "给你。",
    "zh_hant": "給你。"
  },
  {
    "index": 14,
    "text": "Thanks, Dan.",
    "start": 40.491,
    "end": 41.871,
    "zh": "谢谢，丹。",
    "zh_hant": "謝謝，丹。"
  },
  {
    "index": 15,
    "text": "What are you going to do now, George?",
    "start": 43.513,
    "end": 47.255,
    "zh": "乔治，你现在打算做什么？",
    "zh_hant": "喬治，你現在打算做什麼？"
  },
  {
    "index": 16,
    "text": "I'm going to paint it.",
    "start": 47.996,
    "end": 50.077,
    "zh": "我打算把它刷上漆。",
    "zh_hant": "我打算把它刷上漆。"
  },
  {
    "index": 17,
    "text": "What colour are you going to paint it?",
    "start": 51.138,
    "end": 54.48,
    "zh": "你打算把它刷成什么颜色？",
    "zh_hant": "你打算把它刷成什麼顏色？"
  },
  {
    "index": 18,
    "text": "I'm going to paint it pink.",
    "start": 55.601,
    "end": 58.442,
    "zh": "我打算把它刷成粉色。",
    "zh_hant": "我打算把它刷成粉色。"
  },
  {
    "index": 19,
    "text": "Pink!",
    "start": 59.203,
    "end": 60.404,
    "zh": "粉色！",
    "zh_hant": "粉色！"
  },
  {
    "index": 20,
    "text": "This bookcase isn't for me.",
    "start": 60.944,
    "end": 63.486,
    "zh": "这个书柜不是给我做的。",
    "zh_hant": "這個書櫃不是給我做的。"
  },
  {
    "index": 21,
    "text": "It's for my daughter, Susan.",
    "start": 63.946,
    "end": 66.688,
    "zh": "是给我女儿苏珊做的。",
    "zh_hant": "是給我女兒蘇珊做的。"
  },
  {
    "index": 22,
    "text": "Pink's her favourite colour.",
    "start": 67.029,
    "end": 69.73,
    "zh": "粉色是她最喜欢的颜色。",
    "zh_hant": "粉色是她最喜歡的顏色。"
  }
]
