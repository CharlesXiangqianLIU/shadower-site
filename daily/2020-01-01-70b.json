[
  {
    "index": 0,
    "text": "Lesson 139 Is that you, John?",
    "start": 0.61,
    "end": 5.611,
    "zh": "第139课 是你吗,约翰?",
    "zh_hant": "第139課 是你嗎,約翰?"
  },
  {
    "index": 1,
    "text": "Listen to the tape then",
    "start": 6.833,
    "end": 9.675,
    "zh": "听录音，然后",
    "zh_hant": "聽錄音，然後"
  },
  {
    "index": 2,
    "text": "answer this question.",
    "start": 9.495,
    "end": 11.375,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 3,
    "text": "Which John Smith does Graham Turner",
    "start": 12.516,
    "end": 16.418,
    "zh": "格雷厄姆·特纳认为",
    "zh_hant": "格雷厄姆·特納認為"
  },
  {
    "index": 4,
    "text": "think",
    "start": 16.238,
    "end": 17.058,
    "zh": "他在和",
    "zh_hant": "他在和"
  },
  {
    "index": 5,
    "text": "he is talking to?",
    "start": 16.738,
    "end": 18.419,
    "zh": "哪个约翰·史密斯通话？",
    "zh_hant": "哪個約翰·史密斯通話？"
  },
  {
    "index": 6,
    "text": "Is that you, John?",
    "start": 20.26,
    "end": 22.361,
    "zh": "是你吗，约翰？",
    "zh_hant": "是你嗎，約翰？"
  },
  {
    "index": 7,
    "text": "Yes, speaking.",
    "start": 22.681,
    "end": 24.402,
    "zh": "是的，我就是。",
    "zh_hant": "是的，我就是。"
  },
  {
    "index": 8,
    "text": "Tell Mary we'll be late for dinner this evening.",
    "start": 24.722,
    "end": 29.044,
    "zh": "告诉玛丽，我们今晚晚餐会迟到。",
    "zh_hant": "告訴瑪麗，我們今晚晚餐會遲到。"
  },
  {
    "index": 9,
    "text": "I'm afraid I don't understand.",
    "start": 29.405,
    "end": 32.506,
    "zh": "恐怕我不明白。",
    "zh_hant": "恐怕我不明白。"
  },
  {
    "index": 10,
    "text": "Hasn't Mary told you?",
    "start": 33.227,
    "end": 35.367,
    "zh": "玛丽没告诉你吗？",
    "zh_hant": "瑪麗沒告訴你嗎？"
  },
  {
    "index": 11,
    "text": "She invited Charlotte and me to dinner this evening.",
    "start": 36.128,
    "end": 40.591,
    "zh": "她邀请我和夏洛特今晚去吃饭。",
    "zh_hant": "她邀請我和夏洛特今晚去吃飯。"
  },
  {
    "index": 12,
    "text": "I said I would be at your house at six",
    "start": 41.551,
    "end": 45.553,
    "zh": "我说过六点会到你家，",
    "zh_hant": "我說過六點會到你家，"
  },
  {
    "index": 13,
    "text": "o'clock,",
    "start": 45.293,
    "end": 46.333,
    "zh": "点钟，",
    "zh_hant": "點鐘，"
  },
  {
    "index": 14,
    "text": "but the boss wants me to do some extra work.",
    "start": 46.594,
    "end": 50.876,
    "zh": "但老板让我加班做点额外工作。",
    "zh_hant": "但老闆讓我加班做點額外工作。"
  },
  {
    "index": 15,
    "text": "I'll have to stay at the office.",
    "start": 51.576,
    "end": 54.337,
    "zh": "我得待在办公室。",
    "zh_hant": "我得待在辦公室。"
  },
  {
    "index": 16,
    "text": "I don't know when I'll finish.",
    "start": 54.758,
    "end": 57.399,
    "zh": "我不知道什么时候能完成。",
    "zh_hant": "我不知道什麼時候能完成。"
  },
  {
    "index": 17,
    "text": "Oh, and by the way,",
    "start": 58.099,
    "end": 60.8,
    "zh": "哦，顺便说一下。",
    "zh_hant": "哦，順便說一下。"
  },
  {
    "index": 18,
    "text": "my wife wants to know if Mary needs any help.",
    "start": 61.101,
    "end": 65.583,
    "zh": "我妻子想知道玛丽是否需要帮忙。",
    "zh_hant": "我妻子想知道瑪麗是否需要幫忙。"
  },
  {
    "index": 19,
    "text": "I don't know what you're talking about.",
    "start": 66.243,
    "end": 69.865,
    "zh": "我不知道你在说什么。",
    "zh_hant": "我不知道你在說什麼。"
  },
  {
    "index": 20,
    "text": "That is John Smith, isn't it?",
    "start": 70.706,
    "end": 74.107,
    "zh": "那是约翰·史密斯，对吧？",
    "zh_hant": "那是約翰·史密斯，對吧？"
  },
  {
    "index": 21,
    "text": "Yes, I'm John Smith.",
    "start": 74.187,
    "end": 76.648,
    "zh": "是的，我就是约翰·史密斯。",
    "zh_hant": "是的，我就是約翰·史密斯。"
  },
  {
    "index": 22,
    "text": "You are John Smith,",
    "start": 77.209,
    "end": 79.75,
    "zh": "你是约翰·史密斯，",
    "zh_hant": "你是約翰·史密斯，"
  },
  {
    "index": 23,
    "text": "the engineer, aren't you?",
    "start": 79.4,
    "end": 81.993,
    "zh": "那位工程师，对吗？",
    "zh_hant": "那位工程師，對嗎？"
  },
  {
    "index": 24,
    "text": "That's right.",
    "start": 82.253,
    "end": 83.514,
    "zh": "没错。",
    "zh_hant": "沒錯。"
  },
  {
    "index": 25,
    "text": "You work for the Overseas",
    "start": 84.335,
    "end": 87.378,
    "zh": "你在海外",
    "zh_hant": "你在海外"
  },
  {
    "index": 26,
    "text": "Engineering Company, don't you?",
    "start": 87.178,
    "end": 89.981,
    "zh": "工程公司工作，对吧？",
    "zh_hant": "工程公司工作，對吧？"
  },
  {
    "index": 27,
    "text": "No, I don't.",
    "start": 90.161,
    "end": 91.862,
    "zh": "不，不是。",
    "zh_hant": "不，不是。"
  },
  {
    "index": 28,
    "text": "I'm John Smith the telephone engineer",
    "start": 92.083,
    "end": 95.586,
    "zh": "我是电话工程师约翰·史密斯，",
    "zh_hant": "我是電話工程師約翰·史密斯，"
  },
  {
    "index": 29,
    "text": "and I'm repairing your telephone line.",
    "start": 95.667,
    "end": 99.27,
    "zh": "我正在修你的电话线。",
    "zh_hant": "我正在修你的電話線。"
  }
]
