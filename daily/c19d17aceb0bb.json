[
  {
    "index": 0,
    "text": "Lesson 35 Our village",
    "start": 1.551,
    "end": 5.993,
    "zh": "第35课 我们的村庄",
    "zh_hant": "第35課 我們的村莊"
  },
  {
    "index": 1,
    "text": "Listen to the tape then answer this question.",
    "start": 7.834,
    "end": 12.316,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 2,
    "text": "Are the children coming out of the park",
    "start": 14.477,
    "end": 18.079,
    "zh": "孩子们是正从公园里出来，",
    "zh_hant": "孩子們是正從公園裡出來，"
  },
  {
    "index": 3,
    "text": "or going into it?",
    "start": 18.459,
    "end": 20.36,
    "zh": "还是正走进公园呢？",
    "zh_hant": "還是正走進公園呢？"
  },
  {
    "index": 4,
    "text": "This is a photograph of our village.",
    "start": 22.721,
    "end": 26.523,
    "zh": "这是我们村庄的一张照片。",
    "zh_hant": "這是我們村莊的一張照片。"
  },
  {
    "index": 5,
    "text": "Our village is in a valley.",
    "start": 28.324,
    "end": 31.405,
    "zh": "我们的村庄坐落在一个山谷里。",
    "zh_hant": "我們的村莊坐落在一個山谷裡。"
  },
  {
    "index": 6,
    "text": "It is between two hills.",
    "start": 33.346,
    "end": 35.987,
    "zh": "它位于两座小山之间。",
    "zh_hant": "它位於兩座小山之間。"
  },
  {
    "index": 7,
    "text": "The village is on a river.",
    "start": 38.029,
    "end": 41.01,
    "zh": "村庄在一条河边。",
    "zh_hant": "村莊在一條河邊。"
  },
  {
    "index": 8,
    "text": "Here is another photograph of the village.",
    "start": 43.43,
    "end": 47.312,
    "zh": "这是村庄的另一张照片。",
    "zh_hant": "這是村莊的另一張照片。"
  },
  {
    "index": 9,
    "text": "My wife and I are walking",
    "start": 48.893,
    "end": 51.814,
    "zh": "我和妻子正在散步，",
    "zh_hant": "我和妻子正在散步，"
  },
  {
    "index": 10,
    "text": "along the banks of the river.",
    "start": 51.895,
    "end": 54.335,
    "zh": "沿着河岸走。",
    "zh_hant": "沿著河岸走。"
  },
  {
    "index": 11,
    "text": "We are on the left.",
    "start": 56.437,
    "end": 58.578,
    "zh": "我们在左边。",
    "zh_hant": "我們在左邊。"
  },
  {
    "index": 12,
    "text": "There is a boy in the water.",
    "start": 59.878,
    "end": 62.88,
    "zh": "水里有一个男孩。",
    "zh_hant": "水裡有一個男孩。"
  },
  {
    "index": 13,
    "text": "He is swimming across the river.",
    "start": 64.081,
    "end": 67.062,
    "zh": "他正在游过这条河。",
    "zh_hant": "他正在遊過這條河。"
  },
  {
    "index": 14,
    "text": "Here is another photograph.",
    "start": 69.323,
    "end": 71.944,
    "zh": "这是另一张照片。",
    "zh_hant": "這是另一張照片。"
  },
  {
    "index": 15,
    "text": "This is the school building.",
    "start": 73.325,
    "end": 75.846,
    "zh": "这是学校建筑。",
    "zh_hant": "這是學校建築。"
  },
  {
    "index": 16,
    "text": "It is beside a park.",
    "start": 77.207,
    "end": 79.408,
    "zh": "它在一个公园旁边。",
    "zh_hant": "它在一個公園旁邊。"
  },
  {
    "index": 17,
    "text": "The park is on the right.",
    "start": 81.429,
    "end": 84.032,
    "zh": "公园在右边。",
    "zh_hant": "公園在右邊。"
  },
  {
    "index": 18,
    "text": "Some children are coming out of the building.",
    "start": 86.076,
    "end": 89.661,
    "zh": "一些孩子正从建筑里出来。",
    "zh_hant": "一些孩子正從建築裡出來。"
  },
  {
    "index": 19,
    "text": "Some of them are going into the park.",
    "start": 91.645,
    "end": 95.23,
    "zh": "他们中的一些人正走进公园。",
    "zh_hant": "他們中的一些人正走進公園。"
  }
]
