[
  {
    "index": 0,
    "text": "Lesson 55 The Sawyer",
    "start": 0.55,
    "end": 4.452,
    "zh": "第55课 索耶",
    "zh_hant": "第55課 索耶"
  },
  {
    "index": 1,
    "text": "family",
    "start": 4.112,
    "end": 5.052,
    "zh": "一家",
    "zh_hant": "一家"
  },
  {
    "index": 2,
    "text": "Listen to the tape then",
    "start": 6.213,
    "end": 9.114,
    "zh": "听录音，然后",
    "zh_hant": "聽錄音，然後"
  },
  {
    "index": 3,
    "text": "answer this question.",
    "start": 8.975,
    "end": 10.895,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 4,
    "text": "When do the children do their homework?",
    "start": 11.816,
    "end": 15.337,
    "zh": "孩子们什么时候做作业？",
    "zh_hant": "孩子們什麼時候做作業？"
  },
  {
    "index": 5,
    "text": "The Sawyers live at 87 King Street.",
    "start": 16.858,
    "end": 21.14,
    "zh": "索耶一家住在国王街87号。",
    "zh_hant": "索耶一家住在國王街87號。"
  },
  {
    "index": 6,
    "text": "In the morning,",
    "start": 21.901,
    "end": 23.241,
    "zh": "早上，",
    "zh_hant": "早上，"
  },
  {
    "index": 7,
    "text": "Mr. Sawyer goes to work",
    "start": 23.342,
    "end": 25.843,
    "zh": "索耶先生去上班",
    "zh_hant": "索耶先生去上班"
  },
  {
    "index": 8,
    "text": "and the children go to school.",
    "start": 26.223,
    "end": 29.164,
    "zh": "孩子们去上学。",
    "zh_hant": "孩子們去上學。"
  },
  {
    "index": 9,
    "text": "Their father takes them to school every day.",
    "start": 29.945,
    "end": 33.967,
    "zh": "他们的父亲每天送他们去学校。",
    "zh_hant": "他們的父親每天送他們去學校。"
  },
  {
    "index": 10,
    "text": "Mrs. Sawyer stays at home every day.",
    "start": 35.048,
    "end": 38.749,
    "zh": "索耶太太每天待在家里。",
    "zh_hant": "索耶太太每天待在家裡。"
  },
  {
    "index": 11,
    "text": "She does the housework.",
    "start": 39.23,
    "end": 41.371,
    "zh": "她做家务。",
    "zh_hant": "她做家務。"
  },
  {
    "index": 12,
    "text": "She always eats her lunch at noon.",
    "start": 42.071,
    "end": 45.573,
    "zh": "她总是在中午吃午饭。",
    "zh_hant": "她總是在中午吃午飯。"
  },
  {
    "index": 13,
    "text": "In the afternoon, she usually",
    "start": 46.774,
    "end": 49.975,
    "zh": "下午，她通常",
    "zh_hant": "下午，她通常"
  },
  {
    "index": 14,
    "text": "sees her friends.",
    "start": 49.715,
    "end": 51.396,
    "zh": "见她的朋友们。",
    "zh_hant": "見她的朋友們。"
  },
  {
    "index": 15,
    "text": "They often drink tea together.",
    "start": 51.996,
    "end": 54.898,
    "zh": "他们经常一起喝茶。",
    "zh_hant": "他們經常一起喝茶。"
  },
  {
    "index": 16,
    "text": "In the evening, the children come home from school.",
    "start": 55.838,
    "end": 60.14,
    "zh": "晚上，孩子们放学回家。",
    "zh_hant": "晚上，孩子們放學回家。"
  },
  {
    "index": 17,
    "text": "They arrive home early.",
    "start": 60.701,
    "end": 63.102,
    "zh": "他们早早到家。",
    "zh_hant": "他們早早到家。"
  },
  {
    "index": 18,
    "text": "Mr. Sawyer comes home from work.",
    "start": 64.142,
    "end": 67.464,
    "zh": "索耶先生下班回家。",
    "zh_hant": "索耶先生下班回家。"
  },
  {
    "index": 19,
    "text": "He arrives home late.",
    "start": 67.924,
    "end": 70.385,
    "zh": "他很晚才到家。",
    "zh_hant": "他很晚才到家。"
  },
  {
    "index": 20,
    "text": "At night, the children always do their homework.",
    "start": 71.466,
    "end": 75.708,
    "zh": "夜里，孩子们总是做作业。",
    "zh_hant": "夜裡，孩子們總是做作業。"
  },
  {
    "index": 21,
    "text": "Then they go to bed.",
    "start": 76.208,
    "end": 78.329,
    "zh": "然后他们上床睡觉。",
    "zh_hant": "然後他們上床睡覺。"
  },
  {
    "index": 22,
    "text": "Mr. Sawyer usually reads his newspaper,",
    "start": 79.09,
    "end": 82.819,
    "zh": "索耶先生通常看他的报纸，",
    "zh_hant": "索耶先生通常看他的報紙，"
  },
  {
    "index": 23,
    "text": "but sometimes he and his wife watch television.",
    "start": 83.08,
    "end": 87.33,
    "zh": "但有时候他和妻子看电视。",
    "zh_hant": "但有時候他和妻子看電視。"
  }
]
