[
  {
    "index": 0,
    "text": "Lesson 141.",
    "start": 0.67,
    "end": 3.502,
    "zh": "第141课。",
    "zh_hant": "第141課。"
  },
  {
    "index": 1,
    "text": "Sally's first train ride.",
    "start": 3.552,
    "end": 6.633,
    "zh": "莎莉的第一次火车之旅。",
    "zh_hant": "莎莉的第一次火車之旅。"
  },
  {
    "index": 2,
    "text": "Listen to the tape then",
    "start": 7.594,
    "end": 10.415,
    "zh": "听磁带，然后",
    "zh_hant": "聽磁帶，然後"
  },
  {
    "index": 3,
    "text": "answer this question.",
    "start": 10.235,
    "end": 12.176,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 4,
    "text": "Why was the mother embarrassed?",
    "start": 13.137,
    "end": 16.198,
    "zh": "为什么母亲感到尴尬？",
    "zh_hant": "為什麼母親感到尷尬？"
  },
  {
    "index": 5,
    "text": "Last week,",
    "start": 17.919,
    "end": 19.46,
    "zh": "上周，",
    "zh_hant": "上週，"
  },
  {
    "index": 6,
    "text": "my four-year-old daughter, Sally,",
    "start": 19.38,
    "end": 22.461,
    "zh": "我四岁的女儿莎莉，",
    "zh_hant": "我四歲的女兒莎莉，"
  },
  {
    "index": 7,
    "text": "was invited to a children's party.",
    "start": 22.401,
    "end": 25.623,
    "zh": "被邀请去参加一个儿童聚会。",
    "zh_hant": "被邀請去參加一個兒童聚會。"
  },
  {
    "index": 8,
    "text": "I decided to take her by train.",
    "start": 26.563,
    "end": 29.845,
    "zh": "我决定带她坐火车去。",
    "zh_hant": "我決定帶她坐火車去。"
  },
  {
    "index": 9,
    "text": "Sally was very excited",
    "start": 30.725,
    "end": 33.527,
    "zh": "莎莉非常兴奋，",
    "zh_hant": "莎莉非常興奮，"
  },
  {
    "index": 10,
    "text": "because she had never travelled",
    "start": 33.507,
    "end": 36.508,
    "zh": "因为她以前从未",
    "zh_hant": "因為她以前從未"
  },
  {
    "index": 11,
    "text": "on a train before.",
    "start": 36.328,
    "end": 38.429,
    "zh": "坐过火车。",
    "zh_hant": "坐過火車。"
  },
  {
    "index": 12,
    "text": "She sat near the window",
    "start": 39.55,
    "end": 41.931,
    "zh": "她坐在靠近窗户的地方，",
    "zh_hant": "她坐在靠近窗戶的地方，"
  },
  {
    "index": 13,
    "text": "and asked questions about everything she",
    "start": 42.132,
    "end": 46.614,
    "zh": "并对她所看到的",
    "zh_hant": "並對她所看到的"
  },
  {
    "index": 14,
    "text": "saw.",
    "start": 46.414,
    "end": 47.234,
    "zh": "一切问个不停。",
    "zh_hant": "一切問個不停。"
  },
  {
    "index": 15,
    "text": "Suddenly,",
    "start": 48.135,
    "end": 49.215,
    "zh": "突然，",
    "zh_hant": "突然，"
  },
  {
    "index": 16,
    "text": "a middle-age lady got on the train",
    "start": 49.535,
    "end": 53.717,
    "zh": "一位中年女士上了火车，",
    "zh_hant": "一位中年女士上了火車，"
  },
  {
    "index": 17,
    "text": "and sat opposite Sally.",
    "start": 53.737,
    "end": 56.438,
    "zh": "坐在莎莉对面。",
    "zh_hant": "坐在莎莉對面。"
  },
  {
    "index": 18,
    "text": "'Hello,",
    "start": 56.088,
    "end": 59.08,
    "zh": "“你好，",
    "zh_hant": "“你好，"
  },
  {
    "index": 19,
    "text": "little girl,'",
    "start": 58.94,
    "end": 60.5,
    "zh": "小姑娘，”",
    "zh_hant": "小姑娘，”"
  },
  {
    "index": 20,
    "text": "she said.",
    "start": 60.621,
    "end": 61.781,
    "zh": "她说。",
    "zh_hant": "她說。"
  },
  {
    "index": 21,
    "text": "Sally did not answer,",
    "start": 62.422,
    "end": 64.903,
    "zh": "莎莉没有回答，",
    "zh_hant": "莎莉沒有回答，"
  },
  {
    "index": 22,
    "text": "but looked at her curiously.",
    "start": 64.843,
    "end": 67.464,
    "zh": "只是好奇地看着她。",
    "zh_hant": "只是好奇地看著她。"
  },
  {
    "index": 23,
    "text": "The lady was dressed in a blue coat",
    "start": 68.585,
    "end": 72.246,
    "zh": "那位女士穿着一件蓝色外套，",
    "zh_hant": "那位女士穿著一件藍色外套，"
  },
  {
    "index": 24,
    "text": "and a large, funny hat.",
    "start": 72.347,
    "end": 75.288,
    "zh": "戴着一顶又大又滑稽的帽子。",
    "zh_hant": "戴著一頂又大又滑稽的帽子。"
  },
  {
    "index": 25,
    "text": "After the train had left the station,",
    "start": 76.168,
    "end": 79.5,
    "zh": "火车离开车站后，",
    "zh_hant": "火車離開車站後，"
  },
  {
    "index": 26,
    "text": "the lady opened her handbag",
    "start": 79.1,
    "end": 83.112,
    "zh": "那位女士打开她的手提包，",
    "zh_hant": "那位女士開啟她的手提包，"
  },
  {
    "index": 27,
    "text": "and took out her powder compact.",
    "start": 83.092,
    "end": 86.574,
    "zh": "拿出了她的粉饼盒。",
    "zh_hant": "拿出了她的粉餅盒。"
  },
  {
    "index": 28,
    "text": "She then began to make up her face.",
    "start": 87.134,
    "end": 91.156,
    "zh": "然后她开始化妆。",
    "zh_hant": "然後她開始化妝。"
  },
  {
    "index": 29,
    "text": "'Why are you",
    "start": 90.806,
    "end": 93.977,
    "zh": "“你为什么",
    "zh_hant": "“你為什麼"
  },
  {
    "index": 30,
    "text": "doing that?'",
    "start": 93.657,
    "end": 95.478,
    "zh": "那样做？”",
    "zh_hant": "那樣做？”"
  },
  {
    "index": 31,
    "text": "Sally asked.",
    "start": 95.498,
    "end": 97.119,
    "zh": "莎莉问道。",
    "zh_hant": "莎莉問道。"
  },
  {
    "index": 32,
    "text": "'To make myself beautiful,'",
    "start": 96.859,
    "end": 100.801,
    "zh": "“为了让自己变漂亮，”",
    "zh_hant": "“為了讓自己變漂亮，”"
  },
  {
    "index": 33,
    "text": "the lady answered.",
    "start": 100.941,
    "end": 102.722,
    "zh": "那位女士回答。",
    "zh_hant": "那位女士回答。"
  },
  {
    "index": 34,
    "text": "She put away her compact",
    "start": 103.282,
    "end": 105.883,
    "zh": "她收起了粉饼盒，",
    "zh_hant": "她收起了粉餅盒，"
  },
  {
    "index": 35,
    "text": "and smiled kindly.",
    "start": 105.843,
    "end": 108.044,
    "zh": "和蔼地笑了笑。",
    "zh_hant": "和藹地笑了笑。"
  },
  {
    "index": 36,
    "text": "'But you are still",
    "start": 107.944,
    "end": 111.386,
    "zh": "“但你还是很",
    "zh_hant": "“但你還是很"
  },
  {
    "index": 37,
    "text": "ugly,'",
    "start": 111.166,
    "end": 113.007,
    "zh": "丑，”",
    "zh_hant": "醜，”"
  },
  {
    "index": 38,
    "text": "Sally said.",
    "start": 112.657,
    "end": 113.987,
    "zh": "莎莉说。",
    "zh_hant": "莎莉說。"
  },
  {
    "index": 39,
    "text": "Sally was amused,",
    "start": 114.668,
    "end": 117.109,
    "zh": "莎莉觉得很有趣，",
    "zh_hant": "莎莉覺得很有趣，"
  },
  {
    "index": 40,
    "text": "but I was very embarrassed!",
    "start": 117.129,
    "end": 120.81,
    "zh": "但我非常尴尬！",
    "zh_hant": "但我非常尷尬！"
  }
]
