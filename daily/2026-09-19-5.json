[{"index": 0, "text": "We also brought this to cheer you. And what is this called?", "start": 0.0, "end": 3.572, "zh": "我们还带了这个来给你打气。这个叫什么？", "zh_hant": "我們還帶了這個來給你打氣。這個叫什麼？"}, {"index": 1, "text": "It's my specialty recipe.", "start": 3.222, "end": 6.753, "zh": "这是我的独家配方。", "zh_hant": "這是我的獨家配方。"}, {"index": 2, "text": "You just mix a little Korean soju here — like soju, yeah — and Thai beer together, and finish with Sprite.", "start": 6.403, "end": 16.178, "zh": "你只要在这里混一点韩国烧酒——对，就是烧酒——再加泰国啤酒，最后加雪碧。", "zh_hant": "你只要在這裡混一點韓國燒酒——對，就是燒酒——再加泰國啤酒，最後加雪碧。"}, {"index": 3, "text": "What are the steps?", "start": 15.968, "end": 17.218, "zh": "步骤是什么？", "zh_hant": "步驟是什麼？"}, {"index": 4, "text": "Just one shot of soju.", "start": 16.868, "end": 19.76, "zh": "先来一小杯烧酒。", "zh_hant": "先來一小杯燒酒。"}, {"index": 5, "text": "Then Thai beer.", "start": 19.75, "end": 20.98, "zh": "然后加泰国啤酒。", "zh_hant": "然後加泰國啤酒。"}, {"index": 6, "text": "Ooh, a shot of beer.", "start": 21.091, "end": 22.521, "zh": "哦，一小杯啤酒。", "zh_hant": "哦，一小杯啤酒。"}, {"index": 7, "text": "Yeah.", "start": 22.171, "end": 23.262, "zh": "对。", "zh_hant": "對。"}, {"index": 8, "text": "Oh, this is fun.", "start": 22.912, "end": 23.802, "zh": "哦，这真有意思。", "zh_hant": "哦，這真有意思。"}, {"index": 9, "text": "And then we finish up with Sprite.", "start": 23.452, "end": 25.783, "zh": "最后我们加雪碧收尾。", "zh_hant": "最後我們加雪碧收尾。"}, {"index": 10, "text": "How did you find out this recipe?", "start": 25.433, "end": 27.103, "zh": "你是怎么发现这个配方的？", "zh_hant": "你是怎麼發現這個配方的？"}, {"index": 11, "text": "Online.", "start": 26.994, "end": 28.004, "zh": "网上。", "zh_hant": "網上。"}, {"index": 12, "text": "You find everything out.", "start": 30.055, "end": 31.626, "zh": "你什么都能找到。", "zh_hant": "你什麼都能找到。"}, {"index": 13, "text": "But it's my, yeah, it's my special one.", "start": 31.276, "end": 34.647, "zh": "但这是我的，对，这是我的独门配方。", "zh_hant": "但這是我的，對，這是我的獨門配方。"}, {"index": 14, "text": "And then you just...", "start": 34.678, "end": 36.288, "zh": "然后你就……", "zh_hant": "然後你就……"}, {"index": 15, "text": "Come on.", "start": 37.699, "end": 38.609, "zh": "来吧。", "zh_hant": "來吧。"}, {"index": 16, "text": "Are you kidding me?", "start": 38.259, "end": 39.049, "zh": "你在开玩笑吧？", "zh_hant": "你在開玩笑吧？"}, {"index": 17, "text": "Yeah.", "start": 38.699, "end": 39.37, "zh": "对。", "zh_hant": "對。"}, {"index": 18, "text": "Honored.", "start": 39.02, "end": 39.75, "zh": "荣幸之至。", "zh_hant": "榮幸之至。"}, {"index": 19, "text": "Here's to you.", "start": 39.742, "end": 40.772, "zh": "敬你。", "zh_hant": "敬你。"}, {"index": 20, "text": "Can I teach you one more thing in Thai?", "start": 40.422, "end": 43.197, "zh": "我能再教你一句泰语吗？", "zh_hant": "我能再教你一句泰語嗎？"}, {"index": 21, "text": "Yes.", "start": 42.908, "end": 43.678, "zh": "可以。", "zh_hant": "可以。"}, {"index": 22, "text": "When you cheers, you say Mot Kew.", "start": 43.569, "end": 45.982, "zh": "干杯的时候，你要说 Mot Kew。", "zh_hant": "乾杯的時候，你要說 Mot Kew。"}, {"index": 23, "text": "Means bottoms up.", "start": 46.434, "end": 47.706, "zh": "意思是干杯。", "zh_hant": "意思是乾杯。"}, {"index": 24, "text": "So bottoms up.", "start": 47.536, "end": 48.828, "zh": "那就干杯吧。", "zh_hant": "那就乾杯吧。"}, {"index": 25, "text": "Mot Kew!", "start": 48.558, "end": 49.609, "zh": "Mot Kew！", "zh_hant": "Mot Kew！"}]