[
  {
    "index": 0,
    "text": "Lesson 77 Terrible",
    "start": 0.53,
    "end": 4.292,
    "zh": "第七十七课 可怕",
    "zh_hant": "第七十七課 可怕"
  },
  {
    "index": 1,
    "text": "toothache",
    "start": 4.072,
    "end": 5.393,
    "zh": "的牙疼",
    "zh_hant": "的牙疼"
  },
  {
    "index": 2,
    "text": "Listen to the tape then",
    "start": 6.433,
    "end": 9.435,
    "zh": "听录音，然后",
    "zh_hant": "聽錄音，然後"
  },
  {
    "index": 3,
    "text": "answer this question.",
    "start": 9.275,
    "end": 11.195,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 4,
    "text": "What time of day is it, do you think?",
    "start": 12.116,
    "end": 16.478,
    "zh": "你认为现在是什么时间？",
    "zh_hant": "你認為現在是什麼時間？"
  },
  {
    "index": 5,
    "text": "How do you know?",
    "start": 17.039,
    "end": 18.899,
    "zh": "你怎么知道的？",
    "zh_hant": "你怎麼知道的？"
  },
  {
    "index": 6,
    "text": "Good morning, Mr. Croft.",
    "start": 21.221,
    "end": 24.322,
    "zh": "早上好，克罗夫特先生。",
    "zh_hant": "早上好，克羅夫特先生。"
  },
  {
    "index": 7,
    "text": "Good morning, nurse.",
    "start": 24.983,
    "end": 26.863,
    "zh": "早上好，护士。",
    "zh_hant": "早上好，護士。"
  },
  {
    "index": 8,
    "text": "I want to see the dentist, please.",
    "start": 27.624,
    "end": 31.045,
    "zh": "我想看牙医。",
    "zh_hant": "我想看牙醫。"
  },
  {
    "index": 9,
    "text": "Do you have an appointment?",
    "start": 31.226,
    "end": 34.247,
    "zh": "你有预约吗？",
    "zh_hant": "你有預約嗎？"
  },
  {
    "index": 10,
    "text": "No, I don't.",
    "start": 34.647,
    "end": 36.528,
    "zh": "没有。",
    "zh_hant": "沒有。"
  },
  {
    "index": 11,
    "text": "Is it urgent?",
    "start": 36.608,
    "end": 38.409,
    "zh": "情况紧急吗？",
    "zh_hant": "情況緊急嗎？"
  },
  {
    "index": 12,
    "text": "Yes, it is.",
    "start": 38.769,
    "end": 40.931,
    "zh": "是的，很紧急。",
    "zh_hant": "是的，很緊急。"
  },
  {
    "index": 13,
    "text": "It's very urgent.",
    "start": 41.291,
    "end": 43.672,
    "zh": "非常紧急。",
    "zh_hant": "非常緊急。"
  },
  {
    "index": 14,
    "text": "I feel awful.",
    "start": 44.593,
    "end": 46.413,
    "zh": "我感觉很难受。",
    "zh_hant": "我感覺很難受。"
  },
  {
    "index": 15,
    "text": "I have a terrible toothache.",
    "start": 46.974,
    "end": 50.135,
    "zh": "我牙疼得厉害。",
    "zh_hant": "我牙疼得厲害。"
  },
  {
    "index": 16,
    "text": "Can you come at 10 a.m. on Monday,",
    "start": 50.816,
    "end": 54.778,
    "zh": "你能周一上午十点来吗，",
    "zh_hant": "你能週一上午十點來嗎，"
  },
  {
    "index": 17,
    "text": "April 24th?",
    "start": 54.838,
    "end": 56.819,
    "zh": "4月24日？",
    "zh_hant": "4月24日？"
  },
  {
    "index": 18,
    "text": "I must see the dentist now, nurse.",
    "start": 57.719,
    "end": 62.081,
    "zh": "我现在必须见牙医，护士。",
    "zh_hant": "我現在必須見牙醫，護士。"
  },
  {
    "index": 19,
    "text": "The dentist is very busy at the moment.",
    "start": 62.802,
    "end": 67.044,
    "zh": "牙医此刻很忙。",
    "zh_hant": "牙醫此刻很忙。"
  },
  {
    "index": 20,
    "text": "Can you come at 2 p.m. ?",
    "start": 67.264,
    "end": 71.01,
    "zh": "你能下午两点来吗？",
    "zh_hant": "你能下午兩點來嗎？"
  },
  {
    "index": 21,
    "text": "That's very late.",
    "start": 71.266,
    "end": 73.707,
    "zh": "那太晚了。",
    "zh_hant": "那太晚了。"
  },
  {
    "index": 22,
    "text": "Can the dentist see me now?",
    "start": 74.247,
    "end": 77.069,
    "zh": "牙医现在能见我吗？",
    "zh_hant": "牙醫現在能見我嗎？"
  },
  {
    "index": 23,
    "text": "I'm afraid that he can't, Mr. Croft.",
    "start": 77.609,
    "end": 81.795,
    "zh": "恐怕不行，克罗夫特先生。",
    "zh_hant": "恐怕不行，克羅夫特先生。"
  },
  {
    "index": 24,
    "text": "Can't you wait till this afternoon?",
    "start": 82.036,
    "end": 85.481,
    "zh": "你不能等到今天下午吗？",
    "zh_hant": "你不能等到今天下午嗎？"
  },
  {
    "index": 25,
    "text": "I can wait, but my toothache can't!",
    "start": 86.483,
    "end": 90.769,
    "zh": "我可以等，但我的牙疼等不了！",
    "zh_hant": "我可以等，但我的牙疼等不了！"
  }
]
