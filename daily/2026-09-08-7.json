[{"index": 0, "text": "Emma, for you, what is the hold that the Spice Girls have over you?", "start": 0.04, "end": 4.772, "zh": "艾玛，对你来说，辣妹组合对你有什么魔力？", "zh_hant": "艾瑪，對你來說，辣妹組合對你有什麼魔力？"}, {"index": 1, "text": "Is this real?", "start": 4.702, "end": 5.933, "zh": "这是真的吗？", "zh_hant": "這是真的嗎？"}, {"index": 2, "text": "Yes, it's real.", "start": 6.363, "end": 7.894, "zh": "是的，是真的。", "zh_hant": "是的，是真的。"}, {"index": 3, "text": "But you're telling me you've never met a Spice Girl?", "start": 7.764, "end": 13.276, "zh": "但你是说你从没见过辣妹组合的成员？", "zh_hant": "但你是說你從沒見過辣妹組合的成員？"}, {"index": 4, "text": "Have you never met a Spice Girl?", "start": 13.427, "end": 14.957, "zh": "你从没见过辣妹吗？", "zh_hant": "你從沒見過辣妹嗎？"}, {"index": 5, "text": "Wait, hold on.", "start": 14.848, "end": 16.078, "zh": "等等，先别急。", "zh_hant": "等等，先別急。"}, {"index": 6, "text": "I have to mentally prepare myself.", "start": 16.148, "end": 18.159, "zh": "我得先做好心理准备。", "zh_hant": "我得先做好心理準備。"}, {"index": 7, "text": "Have you never met a Spice Girl?", "start": 18.689, "end": 20.42, "zh": "你从没见过辣妹吗？", "zh_hant": "你從沒見過辣妹嗎？"}, {"index": 8, "text": "Not in the flesh.", "start": 20.67, "end": 21.961, "zh": "真人没见过。", "zh_hant": "真人沒見過。"}, {"index": 9, "text": "Okay.", "start": 21.731, "end": 22.601, "zh": "好的。", "zh_hant": "好的。"}, {"index": 10, "text": "Now, as you know, Emma,", "start": 22.932, "end": 29.385, "zh": "艾玛，你知道，", "zh_hant": "艾瑪，你知道，"}, {"index": 11, "text": "it is very rare for more than one Spice Girl to appear together for any reason at all.", "start": 29.175, "end": 39.81, "zh": "辣妹组合成员之间能同时现身是极为罕见的。", "zh_hant": "辣妹組合成員之間能同時現身是極為罕見的。"}, {"index": 12, "text": "So, they're not here.", "start": 44.01, "end": 45.427, "zh": "所以，她们现在不在场。", "zh_hant": "所以，她們現在不在場。"}]