[{"index": 0, "text": "Hello and welcome to Real Easy English,", "start": 0.0, "end": 3.531, "zh": "大家好,欢迎收听Real Easy English,", "zh_hant": "大家好,歡迎收聽Real Easy English,"}, {"index": 1, "text": "the podcast where we have real conversations", "start": 3.471, "end": 7.012, "zh": "在这个播客里,我们会用简单的英语", "zh_hant": "在這個播客裡,我們會用簡單的英語"}, {"index": 2, "text": "in easy English", "start": 6.692, "end": 8.213, "zh": "进行真实的对话,", "zh_hant": "進行真實的對話,"}, {"index": 3, "text": "to help you learn.", "start": 7.933, "end": 9.213, "zh": "帮助你学习。", "zh_hant": "幫助你學習。"}, {"index": 4, "text": "I'm Beth.", "start": 9.433, "end": 10.373, "zh": "我是Beth。", "zh_hant": "我是Beth。"}, {"index": 5, "text": "And I'm Neil.", "start": 10.153, "end": 11.374, "zh": "我是Neil。", "zh_hant": "我是Neil。"}, {"index": 6, "text": "There is a video version of this podcast on our website,", "start": 11.214, "end": 15.435, "zh": "这个播客在我们的网站上有视频版本,", "zh_hant": "這個播客在我們的網站上有影片版本,"}, {"index": 7, "text": "where you can also find a worksheet and transcript to help you learn.", "start": 15.455, "end": 19.656, "zh": "你还可以在那里找到练习册和文字稿来帮助学习。", "zh_hant": "你還可以在那裡找到練習冊和文字稿來幫助學習。"}, {"index": 8, "text": "It's at bbclearningenglish.com.", "start": 19.877, "end": 22.417, "zh": "网址是bbclearningenglish.com。", "zh_hant": "網址是bbclearningenglish.com。"}, {"index": 9, "text": "Hi, Neil, how are you?", "start": 29.24, "end": 30.86, "zh": "嗨,Neil,你好吗?", "zh_hant": "嗨,Neil,你好嗎?"}, {"index": 10, "text": "I'm hungry.", "start": 30.88, "end": 31.981, "zh": "我饿了。", "zh_hant": "我餓了。"}, {"index": 11, "text": "Me too.", "start": 31.881, "end": 33.881, "zh": "我也是。", "zh_hant": "我也是。"}, {"index": 12, "text": "I'm starving.", "start": 33.481, "end": 35.202, "zh": "我快饿死了。", "zh_hant": "我快餓死了。"}, {"index": 13, "text": "Well, that's good, because we're talking", "start": 35.482, "end": 38.043, "zh": "嗯,那正好,因为我们今天要聊的", "zh_hant": "嗯,那正好,因為我們今天要聊的"}, {"index": 14, "text": "about lunch today.", "start": 37.943, "end": 39.983, "zh": "是午餐。", "zh_hant": "是午餐。"}, {"index": 15, "text": "We're recording this just before lunch,", "start": 40.303, "end": 43.044, "zh": "我们是在午餐前录这期节目的,", "zh_hant": "我們是在午餐前錄這期節目的,"}, {"index": 16, "text": "so it's no wonder that we're both very hungry.", "start": 42.644, "end": 46.365, "zh": "所以难怪我们俩都很饿。", "zh_hant": "所以難怪我們倆都很餓。"}, {"index": 17, "text": "You might be able to hear our tummies rumble", "start": 46.386, "end": 49.566, "zh": "你可能会听到我们肚子咕咕叫的声音,", "zh_hant": "你可能會聽到我們肚子咕咕叫的聲音,"}, {"index": 18, "text": "because we're hungry.", "start": 49.887, "end": 51.227, "zh": "因为我们饿了。", "zh_hant": "因為我們餓了。"}, {"index": 19, "text": "OK.", "start": 52.428, "end": 53.068, "zh": "好的。", "zh_hant": "好的。"}, {"index": 20, "text": "So, shall we begin?", "start": 52.928, "end": 54.508, "zh": "那我们开始吧?", "zh_hant": "那我們開始吧?"}, {"index": 21, "text": "Yes.", "start": 54.368, "end": 55.088, "zh": "好。", "zh_hant": "好。"}, {"index": 22, "text": "Let's do it.", "start": 54.688, "end": 55.668, "zh": "开始吧。", "zh_hant": "開始吧。"}, {"index": 23, "text": "What have you got for lunch today?", "start": 55.608, "end": 57.829, "zh": "你今天午餐吃什么?", "zh_hant": "你今天午餐吃什麼?"}, {"index": 24, "text": "for my lunch,", "start": 57.969, "end": 59.81, "zh": "我的午餐", "zh_hant": "我的午餐"}, {"index": 25, "text": "I have chicken with potatoes", "start": 59.41, "end": 64.211, "zh": "是鸡肉配土豆", "zh_hant": "是雞肉配土豆"}, {"index": 26, "text": "and vegetables in a harissa paste.", "start": 64.711, "end": 68.072, "zh": "和哈里萨辣酱蔬菜。", "zh_hant": "和哈里薩辣醬蔬菜。"}, {"index": 27, "text": "Oh, that sounds really nice.", "start": 68.253, "end": 70.933, "zh": "哦,听起来真不错。", "zh_hant": "哦,聽起來真不錯。"}, {"index": 28, "text": "Yeah, it's leftovers actually,", "start": 70.733, "end": 73.054, "zh": "是的,其实是剩菜,", "zh_hant": "是的,其實是剩菜,"}, {"index": 29, "text": "which I have heated up and brought", "start": 72.874, "end": 75.695, "zh": "我热了一下,", "zh_hant": "我熱了一下,"}, {"index": 30, "text": "in in a little flask.", "start": 75.335, "end": 77.616, "zh": "装在一个小饭盒里带来的。", "zh_hant": "裝在一個小飯盒裡帶來的。"}, {"index": 31, "text": "What are leftovers ?", "start": 77.396, "end": 81.417, "zh": "什么是leftovers(剩菜)?", "zh_hant": "什麼是leftovers(剩菜)?"}, {"index": 32, "text": "Good question.", "start": 81.017, "end": 86.438, "zh": "好问题。", "zh_hant": "好問題。"}, {"index": 33, "text": "Yes.", "start": 86.379, "end": 86.999, "zh": "是的。", "zh_hant": "是的。"}, {"index": 34, "text": "I also", "start": 86.599, "end": 90.32, "zh": "我今天午餐", "zh_hant": "我今天午餐"}, {"index": 35, "text": "have leftovers for my lunch today.", "start": 90.02, "end": 92.761, "zh": "也吃剩菜。", "zh_hant": "也吃剩菜。"}, {"index": 36, "text": "So, yesterday I made a pasta", "start": 92.441, "end": 96.982, "zh": "昨天我做了意大利面,", "zh_hant": "昨天我做了義大利麵,"}, {"index": 37, "text": "for lunch with vegetables in it", "start": 97.182, "end": 101.183, "zh": "里面加了蔬菜,当作午餐,", "zh_hant": "裡面加了蔬菜,當作午餐,"}, {"index": 38, "text": "and I have that.", "start": 102.124, "end": 103.344, "zh": "我现在吃的就是这个。", "zh_hant": "我現在吃的就是這個。"}, {"index": 39, "text": "So, Beth, what do you usually have for lunch?", "start": 103.264, "end": 106.705, "zh": "那Beth,你平时午餐一般吃什么?", "zh_hant": "那Beth,你平時午餐一般吃什麼?"}, {"index": 40, "text": "Is it usually leftovers or something else?", "start": 106.425, "end": 109.526, "zh": "通常是剩菜还是别的什么?", "zh_hant": "通常是剩菜還是別的什麼?"}, {"index": 41, "text": "It's usually leftovers", "start": 109.926, "end": 112.187, "zh": "我来上班的时候通常吃剩菜,", "zh_hant": "我來上班的時候通常吃剩菜,"}, {"index": 42, "text": "when I come into work because it's", "start": 111.947, "end": 115.708, "zh": "因为这样", "zh_hant": "因為這樣"}, {"index": 43, "text": "easier,", "start": 115.788, "end": 116.608, "zh": "更方便,", "zh_hant": "更方便,"}, {"index": 44, "text": "and then I don't need to buy lunch.", "start": 116.208, "end": 118.669, "zh": "而且不用花钱买午餐。", "zh_hant": "而且不用花錢買午餐。"}, {"index": 45, "text": "But if I go out and buy food,", "start": 119.009, "end": 122.11, "zh": "但如果我出去买吃的,", "zh_hant": "但如果我出去買吃的,"}, {"index": 46, "text": "then I would usually go for something", "start": 122.07, "end": 125.491, "zh": "我通常会选择", "zh_hant": "我通常會選擇"}, {"index": 47, "text": "like sushi or ramen.", "start": 125.672, "end": 128.392, "zh": "寿司或者拉面之类的。", "zh_hant": "壽司或者拉麵之類的。"}, {"index": 48, "text": "What about you?", "start": 128.793, "end": 129.853, "zh": "你呢?", "zh_hant": "你呢?"}, {"index": 49, "text": "What do you usually have for lunch?", "start": 129.493, "end": 131.853, "zh": "你平时午餐一般吃什么?", "zh_hant": "你平時午餐一般吃什麼?"}, {"index": 50, "text": "Yeah.", "start": 133.974, "end": 134.634, "zh": "嗯。", "zh_hant": "嗯。"}, {"index": 51, "text": "Sometimes I have leftovers that I bring in.", "start": 134.234, "end": 137.235, "zh": "有时候我会带剩菜来吃。", "zh_hant": "有時候我會帶剩菜來吃。"}, {"index": 52, "text": "Sometimes, I buy a sandwich, for example.", "start": 136.895, "end": 140.356, "zh": "有时候,我会买个三明治什么的。", "zh_hant": "有時候,我會買個三明治什麼的。"}, {"index": 53, "text": "What's your favourite kind of sandwich?", "start": 140.897, "end": 143.277, "zh": "你最喜欢哪种三明治?", "zh_hant": "你最喜歡哪種三明治?"}, {"index": 54, "text": "If I have a sandwich, if I buy a sandwich for lunch,", "start": 144.138, "end": 148.179, "zh": "如果我买三明治当午餐的话,", "zh_hant": "如果我買三明治當午餐的話,"}, {"index": 55, "text": "I like to get things like smoked salmon.", "start": 147.779, "end": 151.44, "zh": "我喜欢里面加烟熏三文鱼之类的。", "zh_hant": "我喜歡裡面加煙燻三文魚之類的。"}, {"index": 56, "text": "Nice.", "start": 151.96, "end": 152.84, "zh": "不错。", "zh_hant": "不錯。"}, {"index": 57, "text": "With pickles maybe, yeah.", "start": 152.701, "end": 155.741, "zh": "也许再加点腌菜,对。", "zh_hant": "也許再加點醃菜,對。"}, {"index": 58, "text": "There's a really good baguette I like actually", "start": 156.022, "end": 158.622, "zh": "其实有一种很好吃的法棍我很喜欢,", "zh_hant": "其實有一種很好吃的法棍我很喜歡,"}, {"index": 59, "text": "that has smoked salmon", "start": 158.222, "end": 161.163, "zh": "里面有烟熏三文鱼", "zh_hant": "裡面有煙燻三文魚"}, {"index": 60, "text": "and egg mayonnaise in it.", "start": 161.263, "end": 164.284, "zh": "和蛋黄酱鸡蛋。", "zh_hant": "和蛋黃醬雞蛋。"}, {"index": 61, "text": "Oh, it's so nice.", "start": 164.105, "end": 165.765, "zh": "哦,太好吃了。", "zh_hant": "哦,太好吃了。"}, {"index": 62, "text": "Stop it.", "start": 165.365, "end": 166.305, "zh": "别说了。", "zh_hant": "別說了。"}, {"index": 63, "text": "Sorry.", "start": 166.045, "end": 166.705, "zh": "抱歉。", "zh_hant": "抱歉。"}, {"index": 64, "text": "I'm so hungry.", "start": 166.305, "end": 167.546, "zh": "我真的太饿了。", "zh_hant": "我真的太餓了。"}, {"index": 65, "text": "Me too.", "start": 167.146, "end": 168.086, "zh": "我也是。", "zh_hant": "我也是。"}, {"index": 66, "text": "Neil, do you ever skip lunch?", "start": 168.706, "end": 170.967, "zh": "Neil,你会不吃午餐吗?", "zh_hant": "Neil,你會不吃午餐嗎?"}, {"index": 67, "text": "No way.", "start": 171.027, "end": 172.867, "zh": "绝对不会。", "zh_hant": "絕對不會。"}, {"index": 68, "text": "I would be in a horrible mood", "start": 172.467, "end": 175.548, "zh": "如果不吃午餐,", "zh_hant": "如果不吃午餐,"}, {"index": 69, "text": "if I skipped lunch.", "start": 175.568, "end": 177.209, "zh": "我心情会糟透了。", "zh_hant": "我心情會糟透了。"}, {"index": 70, "text": "I don't understand", "start": 176.809, "end": 179.349, "zh": "我真不明白", "zh_hant": "我真不明白"}, {"index": 71, "text": "how anyone can skip any meal.", "start": 178.949, "end": 182.01, "zh": "怎么会有人不吃饭。", "zh_hant": "怎麼會有人不吃飯。"}, {"index": 72, "text": "I need to eat all my meals.", "start": 181.61, "end": 185.071, "zh": "我每顿饭都得吃。", "zh_hant": "我每頓飯都得吃。"}, {"index": 73, "text": "Yeah.", "start": 185.312, "end": 185.972, "zh": "是啊。", "zh_hant": "是啊。"}, {"index": 74, "text": "Otherwise, you get hangry.", "start": 186.132, "end": 187.852, "zh": "不然你会变得又饿又生气。", "zh_hant": "不然你會變得又餓又生氣。"}, {"index": 75, "text": "Exactly.", "start": 187.812, "end": 188.713, "zh": "没错。", "zh_hant": "沒錯。"}, {"index": 76, "text": "'Hangry' is hungry and angry.", "start": 188.313, "end": 191.614, "zh": "'Hangry'就是又饿(hungry)又生气(angry)。", "zh_hant": "'Hangry'就是又餓(hungry)又生氣(angry)。"}, {"index": 77, "text": "I'm on the…", "start": 191.934, "end": 194.014, "zh": "我现在……", "zh_hant": "我現在……"}, {"index": 78, "text": "I'm almost getting hangry now.", "start": 193.614, "end": 195.995, "zh": "我现在都快要hangry了。", "zh_hant": "我現在都快要hangry了。"}, {"index": 79, "text": "What's your favourite meal?", "start": 196.775, "end": 198.676, "zh": "你最喜欢哪一餐?", "zh_hant": "你最喜歡哪一餐?"}, {"index": 80, "text": "Is it lunch?", "start": 198.436, "end": 199.516, "zh": "是午餐吗?", "zh_hant": "是午餐嗎?"}, {"index": 81, "text": "Breakfast?", "start": 199.596, "end": 200.577, "zh": "早餐?", "zh_hant": "早餐?"}, {"index": 82, "text": "Dinner?", "start": 200.177, "end": 200.877, "zh": "晚餐?", "zh_hant": "晚餐?"}, {"index": 83, "text": "I think", "start": 200.477, "end": 203.778, "zh": "我觉得", "zh_hant": "我覺得"}, {"index": 84, "text": "the evening meal is probably my favourite because", "start": 203.938, "end": 207.719, "zh": "晚餐可能是我最喜欢的,因为", "zh_hant": "晚餐可能是我最喜歡的,因為"}, {"index": 85, "text": "we sit at the table and chat and it's", "start": 207.319, "end": 210.7, "zh": "我们会坐在桌边聊天,而且", "zh_hant": "我們會坐在桌邊聊天,而且"}, {"index": 86, "text": "the biggest, nicest meal of the day", "start": 210.3, "end": 213.061, "zh": "这是一天中最丰盛、最美味的一餐,", "zh_hant": "這是一天中最豐盛、最美味的一餐,"}, {"index": 87, "text": "and you don't really have to do anything after", "start": 213.241, "end": 216.402, "zh": "吃完之后也不用再做什么事,", "zh_hant": "吃完之後也不用再做什麼事,"}, {"index": 88, "text": "so you can relax.", "start": 216.142, "end": 217.662, "zh": "可以好好放松一下。", "zh_hant": "可以好好放鬆一下。"}, {"index": 89, "text": "Yeah that's good.", "start": 218.242, "end": 219.483, "zh": "嗯,那挺好的。", "zh_hant": "嗯,那挺好的。"}, {"index": 90, "text": "I really like brunch", "start": 219.083, "end": 221.403, "zh": "我很喜欢brunch(早午餐),", "zh_hant": "我很喜歡brunch(早午餐),"}, {"index": 91, "text": "which is that sort of in between breakfast and lunch,", "start": 221.203, "end": 224.984, "zh": "就是介于早餐和午餐之间的那种,", "zh_hant": "就是介於早餐和午餐之間的那種,"}, {"index": 92, "text": "maybe 10:00.", "start": 224.584, "end": 226.925, "zh": "大概十点左右。", "zh_hant": "大概十點左右。"}, {"index": 93, "text": "And I might have eggs", "start": 226.525, "end": 229.046, "zh": "我可能会吃鸡蛋、", "zh_hant": "我可能會吃雞蛋、"}, {"index": 94, "text": "and bacon and hash browns and avocado,", "start": 228.646, "end": 232.347, "zh": "培根、土豆饼、牛油果,", "zh_hant": "培根、土豆餅、牛油果,"}, {"index": 95, "text": "a big meal full of lots of good food,", "start": 231.947, "end": 235.808, "zh": "丰盛的一餐,各种美食都有,", "zh_hant": "豐盛的一餐,各種美食都有,"}, {"index": 96, "text": "like a brunch.", "start": 235.768, "end": 236.868, "zh": "就像brunch那样。", "zh_hant": "就像brunch那樣。"}, {"index": 97, "text": "Do you ever have a working lunch ?", "start": 237.409, "end": 240.859, "zh": "你会有工作餐吗?", "zh_hant": "你會有工作餐嗎?"}, {"index": 98, "text": "I do occasionally if", "start": 240.459, "end": 243.711, "zh": "如果我", "zh_hant": "如果我"}, {"index": 99, "text": "I'm working from home", "start": 243.311, "end": 245.091, "zh": "在家工作的话偶尔会有,", "zh_hant": "在家工作的話偶爾會有,"}, {"index": 100, "text": "because I can carry", "start": 246.612, "end": 249.813, "zh": "因为这样我可以", "zh_hant": "因為這樣我可以"}, {"index": 101, "text": "on working and eat quickly.", "start": 249.413, "end": 251.213, "zh": "边工作边快速吃饭。", "zh_hant": "邊工作邊快速吃飯。"}, {"index": 102, "text": "And then in my actual lunch break,", "start": 250.813, "end": 253.054, "zh": "然后到真正的午休时间,", "zh_hant": "然後到真正的午休時間,"}, {"index": 103, "text": "I might have a nice long walk or something like that,", "start": 252.654, "end": 256.575, "zh": "我可能会去散个长长的步之类的,", "zh_hant": "我可能會去散個長長的步之類的,"}, {"index": 104, "text": "but when I'm in the office, I don't want to eat at my desk.", "start": 256.895, "end": 260.236, "zh": "但在办公室的时候,我不想在桌前吃饭。", "zh_hant": "但在辦公室的時候,我不想在桌前吃飯。"}, {"index": 105, "text": "No. Me neither.", "start": 260.136, "end": 261.477, "zh": "是啊,我也不想。", "zh_hant": "是啊,我也不想。"}, {"index": 106, "text": "I don't really like working lunches .", "start": 261.077, "end": 264.698, "zh": "我不太喜欢边工作边吃饭。", "zh_hant": "我不太喜歡邊工作邊吃飯。"}, {"index": 107, "text": "I would rather eat my lunch without working.", "start": 264.298, "end": 267.959, "zh": "我宁愿好好吃午饭,不去工作。", "zh_hant": "我寧願好好吃午飯,不去工作。"}, {"index": 108, "text": "Yeah, I'd prefer the same, really.", "start": 268.839, "end": 271.7, "zh": "嗯,我也更倾向于这样。", "zh_hant": "嗯,我也更傾向於這樣。"}, {"index": 109, "text": "We heard 'working lunch',", "start": 281.744, "end": 291.747, "zh": "我们学到了'working lunch',", "zh_hant": "我們學到了'working lunch',"}, {"index": 110, "text": "which is when you eat your lunch while you're working.", "start": 291.427, "end": 294.628, "zh": "就是指边工作边吃午饭。", "zh_hant": "就是指邊工作邊吃午飯。"}, {"index": 111, "text": "We also had 'leftovers', which is when you don't finish a meal,", "start": 295.408, "end": 299.769, "zh": "我们还学到了'leftovers',指没吃完的饭菜,", "zh_hant": "我們還學到了'leftovers',指沒吃完的飯菜,"}, {"index": 112, "text": "so you have more of it at a different time, like the next day.", "start": 299.569, "end": 303.331, "zh": "留到之后再吃,比如第二天。", "zh_hant": "留到之後再吃,比如第二天。"}, {"index": 113, "text": "And we talked about which meals and food we prefer.", "start": 303.671, "end": 307.432, "zh": "我们还聊了各自更喜欢的餐食和食物。", "zh_hant": "我們還聊了各自更喜歡的餐食和食物。"}, {"index": 114, "text": "If you prefer something, you like it better than something else.", "start": 307.292, "end": 311.153, "zh": "如果你更喜欢某样东西,就是说你更喜欢它,而不是别的。", "zh_hant": "如果你更喜歡某樣東西,就是說你更喜歡它,而不是別的。"}, {"index": 115, "text": "Yes.", "start": 311.193, "end": 311.953, "zh": "没错。", "zh_hant": "沒錯。"}, {"index": 116, "text": "And another phrase we can use to say this is 'would rather'.", "start": 311.693, "end": 315.975, "zh": "另一个可以用来表达这个意思的短语是'would rather'(宁愿)。", "zh_hant": "另一個可以用來表達這個意思的短語是'would rather'(寧願)。"}, {"index": 117, "text": "For example, I 'd rather have sushi", "start": 315.895, "end": 318.856, "zh": "比如,我午餐", "zh_hant": "比如,我午餐"}, {"index": 118, "text": "than a sandwich for lunch.", "start": 318.636, "end": 320.476, "zh": "宁愿吃寿司也不吃三明治。", "zh_hant": "寧願吃壽司也不吃三明治。"}, {"index": 119, "text": "That's it for this episode of Real Easy English.", "start": 320.676, "end": 323.677, "zh": "这就是本期Real Easy English的全部内容。", "zh_hant": "這就是本期Real Easy English的全部內容。"}, {"index": 120, "text": "Test what you've learned with a worksheet on our website,", "start": 323.297, "end": 326.378, "zh": "去我们网站上的练习册测试一下你学到的内容吧,", "zh_hant": "去我們網站上的練習冊測試一下你學到的內容吧,"}, {"index": 121, "text": "bbclearningenglish.com.", "start": 326.078, "end": 328.32, "zh": "网址是bbclearningenglish.com。", "zh_hant": "網址是bbclearningenglish.com。"}, {"index": 122, "text": "And make sure you join us again", "start": 328.36, "end": 330.802, "zh": "记得再来加入我们,", "zh_hant": "記得再來加入我們,"}, {"index": 123, "text": "for another easy English conversation.", "start": 330.522, "end": 333.645, "zh": "参加下一次简单英语对话。", "zh_hant": "參加下一次簡單英語對話。"}, {"index": 124, "text": "We'll be back next week.", "start": 333.565, "end": 335.146, "zh": "我们下周再见。", "zh_hant": "我們下週再見。"}, {"index": 125, "text": "See you soon.", "start": 334.947, "end": 335.927, "zh": "回头见。", "zh_hant": "回頭見。"}, {"index": 126, "text": "Goodbye.", "start": 336.028, "end": 336.868, "zh": "再见。", "zh_hant": "再見。"}]