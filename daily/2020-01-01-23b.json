[
  {
    "index": 0,
    "text": "Lesson 45 The boss's",
    "start": 0.35,
    "end": 4.352,
    "zh": "第45课 老板的",
    "zh_hant": "第45課 老闆的"
  },
  {
    "index": 1,
    "text": "letter",
    "start": 4.032,
    "end": 4.852,
    "zh": "信",
    "zh_hant": "信"
  },
  {
    "index": 2,
    "text": "Listen to the tape then",
    "start": 6.153,
    "end": 9.214,
    "zh": "听录音，然后",
    "zh_hant": "聽錄音，然後"
  },
  {
    "index": 3,
    "text": "answer this question.",
    "start": 9.015,
    "end": 10.975,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 4,
    "text": "Why can't Pamela type the letter?",
    "start": 11.956,
    "end": 15.538,
    "zh": "为什么帕梅拉不能打这封信？",
    "zh_hant": "為什麼帕梅拉不能打這封信？"
  },
  {
    "index": 5,
    "text": "Can you come here a minute please, Bob?",
    "start": 17.579,
    "end": 21.32,
    "zh": "鲍勃，你能过来一下吗？",
    "zh_hant": "鮑勃，你能過來一下嗎？"
  },
  {
    "index": 6,
    "text": "Yes, sir?",
    "start": 21.761,
    "end": 22.901,
    "zh": "什么事，先生？",
    "zh_hant": "什麼事，先生？"
  },
  {
    "index": 7,
    "text": "Where's Pamela?",
    "start": 23.942,
    "end": 25.523,
    "zh": "帕梅拉在哪？",
    "zh_hant": "帕梅拉在哪？"
  },
  {
    "index": 8,
    "text": "She's next door.",
    "start": 26.203,
    "end": 27.984,
    "zh": "她在隔壁。",
    "zh_hant": "她在隔壁。"
  },
  {
    "index": 9,
    "text": "She's in her office, sir.",
    "start": 28.244,
    "end": 30.505,
    "zh": "她在她的办公室里，先生。",
    "zh_hant": "她在她的辦公室裡，先生。"
  },
  {
    "index": 10,
    "text": "Can she type this letter for me?",
    "start": 31.426,
    "end": 34.567,
    "zh": "她能帮我打这封信吗？",
    "zh_hant": "她能幫我打這封信嗎？"
  },
  {
    "index": 11,
    "text": "Ask her please.",
    "start": 35.188,
    "end": 36.868,
    "zh": "请你去问问她。",
    "zh_hant": "請你去問問她。"
  },
  {
    "index": 12,
    "text": "Yes, sir.",
    "start": 36.888,
    "end": 38.069,
    "zh": "好的，先生。",
    "zh_hant": "好的，先生。"
  },
  {
    "index": 13,
    "text": "Can you type this letter for the boss please,",
    "start": 39.25,
    "end": 43.193,
    "zh": "你能帮老板打这封信吗，",
    "zh_hant": "你能幫老闆打這封信嗎，"
  },
  {
    "index": 14,
    "text": "Pamela?",
    "start": 42.913,
    "end": 43.853,
    "zh": "帕梅拉？",
    "zh_hant": "帕梅拉？"
  },
  {
    "index": 15,
    "text": "Yes, of course I can.",
    "start": 44.074,
    "end": 46.996,
    "zh": "是的，我当然可以。",
    "zh_hant": "是的，我當然可以。"
  },
  {
    "index": 16,
    "text": "Here you are.",
    "start": 47.697,
    "end": 49.037,
    "zh": "给你。",
    "zh_hant": "給你。"
  },
  {
    "index": 17,
    "text": "Thank you, Bob.",
    "start": 49.318,
    "end": 51.019,
    "zh": "谢谢你，鲍勃。",
    "zh_hant": "謝謝你，鮑勃。"
  },
  {
    "index": 18,
    "text": "Bob!",
    "start": 51.84,
    "end": 52.88,
    "zh": "鲍勃！",
    "zh_hant": "鮑勃！"
  },
  {
    "index": 19,
    "text": "Yes?",
    "start": 53.101,
    "end": 54.101,
    "zh": "怎么了？",
    "zh_hant": "怎麼了？"
  },
  {
    "index": 20,
    "text": "What's the matter?",
    "start": 54.162,
    "end": 55.622,
    "zh": "出了什么事？",
    "zh_hant": "出了什麼事？"
  },
  {
    "index": 21,
    "text": "I can't type this letter.",
    "start": 56.223,
    "end": 58.725,
    "zh": "我打不了这封信。",
    "zh_hant": "我打不了這封信。"
  },
  {
    "index": 22,
    "text": "I can't read it!",
    "start": 59.346,
    "end": 61.227,
    "zh": "我读不懂它！",
    "zh_hant": "我讀不懂它！"
  },
  {
    "index": 23,
    "text": "The boss's handwriting is terrible!",
    "start": 61.487,
    "end": 65.57,
    "zh": "老板的笔迹太糟糕了！",
    "zh_hant": "老闆的筆跡太糟糕了！"
  }
]
