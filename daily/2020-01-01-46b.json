[
  {
    "index": 0,
    "text": "Lesson 91.",
    "start": 0.871,
    "end": 3.302,
    "zh": "第91课。",
    "zh_hant": "第91課。"
  },
  {
    "index": 1,
    "text": "Poor Ian!",
    "start": 3.352,
    "end": 5.052,
    "zh": "可怜的伊恩！",
    "zh_hant": "可憐的伊恩！"
  },
  {
    "index": 2,
    "text": "Listen to the tape then",
    "start": 6.233,
    "end": 9.115,
    "zh": "听录音，然后",
    "zh_hant": "聽錄音，然後"
  },
  {
    "index": 3,
    "text": "answer this question.",
    "start": 8.895,
    "end": 10.895,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 4,
    "text": "Who wanted to sell the house?",
    "start": 12.116,
    "end": 15.258,
    "zh": "谁想卖房子？",
    "zh_hant": "誰想賣房子？"
  },
  {
    "index": 5,
    "text": "Has Ian sold his house yet?",
    "start": 17.559,
    "end": 20.541,
    "zh": "伊恩已经卖掉他的房子了吗？",
    "zh_hant": "伊恩已經賣掉他的房子了嗎？"
  },
  {
    "index": 6,
    "text": "Yes, he has.",
    "start": 21.241,
    "end": 23.182,
    "zh": "是的，他卖掉了。",
    "zh_hant": "是的，他賣掉了。"
  },
  {
    "index": 7,
    "text": "He sold it last week.",
    "start": 23.162,
    "end": 25.863,
    "zh": "他上周卖掉的。",
    "zh_hant": "他上週賣掉的。"
  },
  {
    "index": 8,
    "text": "Has he moved to his new house yet?",
    "start": 26.844,
    "end": 30.666,
    "zh": "他已经搬进新房子了吗？",
    "zh_hant": "他已經搬進新房子了嗎？"
  },
  {
    "index": 9,
    "text": "No, not yet.",
    "start": 31.446,
    "end": 33.587,
    "zh": "还没有。",
    "zh_hant": "還沒有。"
  },
  {
    "index": 10,
    "text": "He's still here.",
    "start": 33.768,
    "end": 35.648,
    "zh": "他还在这儿。",
    "zh_hant": "他還在這兒。"
  },
  {
    "index": 11,
    "text": "He's going to move tomorrow.",
    "start": 35.989,
    "end": 38.73,
    "zh": "他打算明天搬家。",
    "zh_hant": "他打算明天搬家。"
  },
  {
    "index": 12,
    "text": "When?",
    "start": 39.791,
    "end": 40.691,
    "zh": "什么时候？",
    "zh_hant": "什麼時候？"
  },
  {
    "index": 13,
    "text": "Tomorrow morning?",
    "start": 41.051,
    "end": 42.972,
    "zh": "明天上午？",
    "zh_hant": "明天上午？"
  },
  {
    "index": 14,
    "text": "No. Tomorrow afternoon.",
    "start": 44.113,
    "end": 47.274,
    "zh": "不，明天下午。",
    "zh_hant": "不，明天下午。"
  },
  {
    "index": 15,
    "text": "I'll miss him.",
    "start": 47.875,
    "end": 49.415,
    "zh": "我会想他的。",
    "zh_hant": "我會想他的。"
  },
  {
    "index": 16,
    "text": "He has always been a good neighbour.",
    "start": 49.836,
    "end": 53.717,
    "zh": "他一直是个好邻居。",
    "zh_hant": "他一直是個好鄰居。"
  },
  {
    "index": 17,
    "text": "He's a very nice person.",
    "start": 54.498,
    "end": 57.619,
    "zh": "他是个非常好的人。",
    "zh_hant": "他是個非常好的人。"
  },
  {
    "index": 18,
    "text": "We'll all miss him.",
    "start": 58.12,
    "end": 60.941,
    "zh": "我们都会想念他的。",
    "zh_hant": "我們都會想念他的。"
  },
  {
    "index": 19,
    "text": "When will the new people move into this house?",
    "start": 62.282,
    "end": 66.764,
    "zh": "新住户什么时候搬进这所房子？",
    "zh_hant": "新住戶什麼時候搬進這所房子？"
  },
  {
    "index": 20,
    "text": "I think that they'll move in the day",
    "start": 67.685,
    "end": 71.206,
    "zh": "我想他们会搬进来，",
    "zh_hant": "我想他們會搬進來，"
  },
  {
    "index": 21,
    "text": "after tomorrow.",
    "start": 71.027,
    "end": 72.787,
    "zh": "就在后天。",
    "zh_hant": "就在後天。"
  },
  {
    "index": 22,
    "text": "Will you see Ian today, Jenny?",
    "start": 74.168,
    "end": 78.03,
    "zh": "珍妮，你今天会见到伊恩吗？",
    "zh_hant": "珍妮，你今天會見到伊恩嗎？"
  },
  {
    "index": 23,
    "text": "Yes, I will.",
    "start": 79.671,
    "end": 81.713,
    "zh": "是的，我会。",
    "zh_hant": "是的，我會。"
  },
  {
    "index": 24,
    "text": "Please give him my regards.",
    "start": 83.014,
    "end": 86.958,
    "zh": "请代我向他问好。",
    "zh_hant": "請代我向他問好。"
  },
  {
    "index": 25,
    "text": "Poor Ian!",
    "start": 87.719,
    "end": 89.44,
    "zh": "可怜的伊恩！",
    "zh_hant": "可憐的伊恩！"
  },
  {
    "index": 26,
    "text": "He didn't want to leave this house.",
    "start": 89.801,
    "end": 93.564,
    "zh": "他不想离开这所房子。",
    "zh_hant": "他不想離開這所房子。"
  },
  {
    "index": 27,
    "text": "No, he didn't want to leave,",
    "start": 94.485,
    "end": 98.148,
    "zh": "是的，他不想离开，",
    "zh_hant": "是的，他不想離開，"
  },
  {
    "index": 28,
    "text": "but his wife did!",
    "start": 98.288,
    "end": 100.51,
    "zh": "但他的妻子想！",
    "zh_hant": "但他的妻子想！"
  }
]
