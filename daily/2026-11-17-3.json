[{"index": 0, "text": "Do you think you do a good American accent?", "start": 0.0, "end": 2.231, "zh": "你觉得自己美式口音说得好吗？", "zh_hant": "你覺得自己美式口音說得好嗎？"}, {"index": 1, "text": "I do.", "start": 2.361, "end": 3.051, "zh": "我觉得好。", "zh_hant": "我覺得好。"}, {"index": 2, "text": "She's telling the truth.", "start": 3.162, "end": 4.812, "zh": "她说的是真话。", "zh_hant": "她說的是真話。"}, {"index": 3, "text": "Do you ever judge the American accents of other British actors?", "start": 4.502, "end": 8.094, "zh": "你会评价其他英国演员的美式口音吗？", "zh_hant": "你會評價其他英國演員的美式口音嗎？"}, {"index": 4, "text": "Yes.", "start": 8.504, "end": 9.354, "zh": "会。", "zh_hant": "會。"}, {"index": 5, "text": "Have any of your American co-stars ever tried a British accent in front of you?", "start": 9.425, "end": 13.396, "zh": "有美国搭档在你面前试过英式口音吗？", "zh_hant": "有美國搭檔在你面前試過英式口音嗎？"}, {"index": 6, "text": "Yes.", "start": 13.627, "end": 14.437, "zh": "有。", "zh_hant": "有。"}, {"index": 7, "text": "Who is the worst?", "start": 15.108, "end": 16.378, "zh": "谁最差？", "zh_hant": "誰最差？"}, {"index": 8, "text": "Too broad of a question. I feel as though all of them.", "start": 16.828, "end": 20.34, "zh": "这问题太宽泛了。我感觉个个都差。", "zh_hant": "這問題太寬泛了。我感覺個個都差。"}, {"index": 9, "text": "That's a lie.", "start": 20.41, "end": 21.601, "zh": "那是假话。", "zh_hant": "那是假話。"}, {"index": 10, "text": "Who are you trying to protect, Millie?", "start": 21.631, "end": 23.622, "zh": "你想保护谁，米莉？", "zh_hant": "你想保護誰，米莉？"}, {"index": 11, "text": "Everyone, you exclaimed, \"Kissing sucks!\"", "start": 24.052, "end": 26.983, "zh": "所有人，你当时大喊：“接吻糟透了！”", "zh_hant": "所有人，你當時大喊：“接吻糟透了！”"}, {"index": 12, "text": "after your first kiss with Finn Wolfhard.", "start": 26.633, "end": 28.944, "zh": "在你和芬恩·沃尔夫哈德初吻之后。", "zh_hant": "在你和芬恩·沃爾夫哈德初吻之後。"}, {"index": 13, "text": "Mm-hmm.", "start": 28.594, "end": 29.344, "zh": "嗯哼。", "zh_hant": "嗯哼。"}, {"index": 14, "text": "Is Finn just a lousy kisser?", "start": 29.535, "end": 31.405, "zh": "芬恩是不是吻技很差？", "zh_hant": "芬恩是不是吻技很差？"}, {"index": 15, "text": "He is.", "start": 31.256, "end": 32.086, "zh": "是的。", "zh_hant": "是的。"}, {"index": 16, "text": "She's telling the truth.", "start": 32.036, "end": 33.526, "zh": "她说的是真话。", "zh_hant": "她說的是真話。"}, {"index": 17, "text": "He's a lousy kisser.", "start": 33.897, "end": 35.627, "zh": "他吻技很差。", "zh_hant": "他吻技很差。"}, {"index": 18, "text": "So he hasn't gotten better?", "start": 38.779, "end": 40.39, "zh": "那他后来有进步吗？", "zh_hant": "那他後來有進步嗎？"}, {"index": 19, "text": "Not with me, no.", "start": 40.921, "end": 42.591, "zh": "跟我没有，没有。", "zh_hant": "跟我沒有，沒有。"}, {"index": 20, "text": "Have you told him this?", "start": 42.902, "end": 44.212, "zh": "你跟他说过这些吗？", "zh_hant": "你跟他說過這些嗎？"}, {"index": 21, "text": "No.", "start": 44.603, "end": 45.273, "zh": "没有。", "zh_hant": "沒有。"}, {"index": 22, "text": "He's gonna find out.", "start": 45.964, "end": 47.314, "zh": "他会知道的。", "zh_hant": "他會知道的。"}, {"index": 23, "text": "That's okay.", "start": 47.385, "end": 48.395, "zh": "没关系。", "zh_hant": "沒關係。"}, {"index": 24, "text": "When you were 14 years old, you said on a TikTok live that you thought the earth was flat.", "start": 48.345, "end": 53.178, "zh": "你14岁时在TikTok直播上说你觉得地球是平的。", "zh_hant": "你14歲時在TikTok直播上說你覺得地球是平的。"}, {"index": 25, "text": "Unfortunately, yes, I did.", "start": 53.128, "end": 54.819, "zh": "不幸的是，是的，我说过。", "zh_hant": "不幸的是，是的，我說過。"}, {"index": 26, "text": "Do you still believe this?", "start": 55.37, "end": 56.84, "zh": "你现在还这么认为吗？", "zh_hant": "你現在還這麼認為嗎？"}, {"index": 27, "text": "No.", "start": 56.991, "end": 57.621, "zh": "不。", "zh_hant": "不。"}, {"index": 28, "text": "Although I've never seen like the, you know, you know when you're on a plane sometimes you can see it.", "start": 57.871, "end": 63.004, "zh": "虽然我从没见过那个，你知道，就是你在飞机上有时能看到它。", "zh_hant": "雖然我從沒見過那個，你知道，就是你在飛機上有時能看到它。"}, {"index": 29, "text": "The Cove, I've not seen that yet.", "start": 62.854, "end": 65.526, "zh": "《The Cove》，我还没看过那个。", "zh_hant": "《The Cove》，我還沒看過那個。"}, {"index": 30, "text": "You've seen satellite pictures, right?", "start": 65.736, "end": 68.668, "zh": "你见过卫星照片吧？", "zh_hant": "你見過衛星照片吧？"}, {"index": 31, "text": "I have, I have, yeah.", "start": 68.698, "end": 70.689, "zh": "见过，见过，是的。", "zh_hant": "見過，見過，是的。"}, {"index": 32, "text": "Thanks Judd.", "start": 70.699, "end": 71.73, "zh": "谢谢，贾德。", "zh_hant": "謝謝，賈德。"}]