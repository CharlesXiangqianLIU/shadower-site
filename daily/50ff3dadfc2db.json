[
  {
    "index": 0,
    "text": "Why was the writer's aunt surprised?",
    "start": 13.451,
    "end": 17.292,
    "zh": "为什么作家的姑妈感到惊讶？",
    "zh_hant": "為什麼作家的姑媽感到驚訝？"
  },
  {
    "index": 1,
    "text": "It was Sunday.",
    "start": 19.674,
    "end": 21.134,
    "zh": "那天是星期天。",
    "zh_hant": "那天是星期天。"
  },
  {
    "index": 2,
    "text": "I never get up early on Sundays.",
    "start": 21.855,
    "end": 24.616,
    "zh": "我星期天从不早起。",
    "zh_hant": "我星期天從不早起。"
  },
  {
    "index": 3,
    "text": "I sometimes stay in bed until lunchtime.",
    "start": 25.376,
    "end": 28.778,
    "zh": "我有时一直躺到午饭时间。",
    "zh_hant": "我有時一直躺到午飯時間。"
  },
  {
    "index": 4,
    "text": "Last Sunday I got up very late.",
    "start": 29.799,
    "end": 33.7,
    "zh": "上个星期天我起得很晚。",
    "zh_hant": "上個星期天我起得很晚。"
  },
  {
    "index": 5,
    "text": "I looked out of the window.",
    "start": 34.961,
    "end": 37.022,
    "zh": "我朝窗外望去。",
    "zh_hant": "我朝窗外望去。"
  },
  {
    "index": 6,
    "text": "It was dark outside.",
    "start": 38.603,
    "end": 41.044,
    "zh": "外面一片漆黑。",
    "zh_hant": "外面一片漆黑。"
  },
  {
    "index": 7,
    "text": "'What a day!'",
    "start": 42.225,
    "end": 43.925,
    "zh": "“什么鬼天气！”",
    "zh_hant": "“什麼鬼天氣！”"
  },
  {
    "index": 8,
    "text": "I thought.",
    "start": 44.206,
    "end": 45.206,
    "zh": "我想。",
    "zh_hant": "我想。"
  },
  {
    "index": 9,
    "text": "'It's raining again.'",
    "start": 44.886,
    "end": 49.088,
    "zh": "“又下雨了。”",
    "zh_hant": "“又下雨了。”"
  },
  {
    "index": 10,
    "text": "Just then, the telephone rang.",
    "start": 48.748,
    "end": 51.489,
    "zh": "就在这时，电话铃响了。",
    "zh_hant": "就在這時，電話鈴響了。"
  },
  {
    "index": 11,
    "text": "It was my aunt Lucy.",
    "start": 52.41,
    "end": 54.271,
    "zh": "是我的姑妈露西。",
    "zh_hant": "是我的姑媽露西。"
  },
  {
    "index": 12,
    "text": "'I've just arrived by train,' she said.",
    "start": 54.071,
    "end": 59.334,
    "zh": "“我刚坐火车到达，”她说。",
    "zh_hant": "“我剛坐火車到達，”她說。"
  },
  {
    "index": 13,
    "text": "'I'm coming to see you.'",
    "start": 59.595,
    "end": 61.275,
    "zh": "“我要来看你。”",
    "zh_hant": "“我要來看你。”"
  },
  {
    "index": 14,
    "text": "'But I'm still having breakfast,' I said.",
    "start": 61.336,
    "end": 66.659,
    "zh": "“但我还在吃早饭，”我说。",
    "zh_hant": "“但我還在吃早飯，”我說。"
  },
  {
    "index": 15,
    "text": "'What are you doing?'",
    "start": 66.419,
    "end": 69.841,
    "zh": "“你在干什么？”",
    "zh_hant": "“你在幹什麼？”"
  },
  {
    "index": 16,
    "text": "she asked.",
    "start": 69.981,
    "end": 71.302,
    "zh": "她问道。",
    "zh_hant": "她問道。"
  },
  {
    "index": 17,
    "text": "'I'm having breakfast,' I repeated.",
    "start": 71.382,
    "end": 75.704,
    "zh": "“我在吃早饭，”我重复道。",
    "zh_hant": "“我在吃早飯，”我重複道。"
  },
  {
    "index": 18,
    "text": "'Dear me,' she said.",
    "start": 75.354,
    "end": 79.287,
    "zh": "“天哪，”她说。",
    "zh_hant": "“天哪，”她說。"
  },
  {
    "index": 19,
    "text": "'Do you always get up so late?",
    "start": 78.937,
    "end": 82.549,
    "zh": "“你总是起这么晚吗？",
    "zh_hant": "“你總是起這麼晚嗎？"
  },
  {
    "index": 20,
    "text": "It's one o'clock!'",
    "start": 82.829,
    "end": 84.69,
    "zh": "已经一点钟了！”",
    "zh_hant": "已經一點鐘了！”"
  }
]
