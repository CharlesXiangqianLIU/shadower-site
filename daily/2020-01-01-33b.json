[
  {
    "index": 0,
    "text": "Lesson 65.",
    "start": 0.75,
    "end": 3.282,
    "zh": "第65课。",
    "zh_hant": "第65課。"
  },
  {
    "index": 1,
    "text": "Not a baby.",
    "start": 3.332,
    "end": 4.992,
    "zh": "不是婴儿。",
    "zh_hant": "不是嬰兒。"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 6.233,
    "end": 10.655,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "Does Jill take the key to the front door?",
    "start": 11.556,
    "end": 15.558,
    "zh": "吉尔拿前门的钥匙了吗？",
    "zh_hant": "吉爾拿前門的鑰匙了嗎？"
  },
  {
    "index": 4,
    "text": "What are you going to do this evening, Jill?",
    "start": 17.679,
    "end": 21.901,
    "zh": "吉尔，你今晚打算做什么？",
    "zh_hant": "吉爾，你今晚打算做什麼？"
  },
  {
    "index": 5,
    "text": "I'm going to meet some friends, Dad.",
    "start": 22.741,
    "end": 26.323,
    "zh": "我打算去见几个朋友，爸爸。",
    "zh_hant": "我打算去見幾個朋友，爸爸。"
  },
  {
    "index": 6,
    "text": "You mustn't come home late.",
    "start": 27.104,
    "end": 29.765,
    "zh": "你不能回家太晚。",
    "zh_hant": "你不能回家太晚。"
  },
  {
    "index": 7,
    "text": "You must be home at half past ten.",
    "start": 30.145,
    "end": 34.227,
    "zh": "你必须在十点半回家。",
    "zh_hant": "你必須在十點半回家。"
  },
  {
    "index": 8,
    "text": "I can't get home so early, Dad!",
    "start": 34.987,
    "end": 38.789,
    "zh": "我这么早回不了家，爸爸！",
    "zh_hant": "我這麼早回不了家，爸爸！"
  },
  {
    "index": 9,
    "text": "Can I have the key to the front door, please?",
    "start": 39.31,
    "end": 44.012,
    "zh": "我能拿前门的钥匙吗？",
    "zh_hant": "我能拿前門的鑰匙嗎？"
  },
  {
    "index": 10,
    "text": "No, you can't.",
    "start": 44.453,
    "end": 46.413,
    "zh": "不，你不能。",
    "zh_hant": "不，你不能。"
  },
  {
    "index": 11,
    "text": "Jill's eighteen years old, Tom.",
    "start": 47.594,
    "end": 51.456,
    "zh": "吉尔十八岁了，汤姆。",
    "zh_hant": "吉爾十八歲了，湯姆。"
  },
  {
    "index": 12,
    "text": "She's not a baby.",
    "start": 51.936,
    "end": 54.237,
    "zh": "她不是婴儿。",
    "zh_hant": "她不是嬰兒。"
  },
  {
    "index": 13,
    "text": "Give her the key.",
    "start": 54.698,
    "end": 56.418,
    "zh": "把钥匙给她。",
    "zh_hant": "把鑰匙給她。"
  },
  {
    "index": 14,
    "text": "She always comes home early.",
    "start": 56.979,
    "end": 60.22,
    "zh": "她总是早回家。",
    "zh_hant": "她總是早回家。"
  },
  {
    "index": 15,
    "text": "Oh, all right!",
    "start": 61.081,
    "end": 63.302,
    "zh": "哦，好吧！",
    "zh_hant": "哦，好吧！"
  },
  {
    "index": 16,
    "text": "Here you are.",
    "start": 64.403,
    "end": 65.943,
    "zh": "给你。",
    "zh_hant": "給你。"
  },
  {
    "index": 17,
    "text": "But you mustn't come home after a quarter past eleven.",
    "start": 66.224,
    "end": 71.226,
    "zh": "但你十一点一刻之后不能回家。",
    "zh_hant": "但你十一點一刻之後不能回家。"
  },
  {
    "index": 18,
    "text": "Do you hear?",
    "start": 71.426,
    "end": 72.947,
    "zh": "你听见了吗？",
    "zh_hant": "你聽見了嗎？"
  },
  {
    "index": 19,
    "text": "Yes, Dad.",
    "start": 73.567,
    "end": 75.148,
    "zh": "是的，爸爸。",
    "zh_hant": "是的，爸爸。"
  },
  {
    "index": 20,
    "text": "Thanks, Mum.",
    "start": 75.728,
    "end": 77.289,
    "zh": "谢谢，妈妈。",
    "zh_hant": "謝謝，媽媽。"
  },
  {
    "index": 21,
    "text": "That's all right.",
    "start": 77.849,
    "end": 79.53,
    "zh": "没关系。",
    "zh_hant": "沒關係。"
  },
  {
    "index": 22,
    "text": "Goodbye.",
    "start": 79.812,
    "end": 81.073,
    "zh": "再见。",
    "zh_hant": "再見。"
  },
  {
    "index": 23,
    "text": "Enjoy yourself!",
    "start": 81.495,
    "end": 83.379,
    "zh": "玩得开心！",
    "zh_hant": "玩得開心！"
  },
  {
    "index": 24,
    "text": "We always enjoy ourselves, Mum.",
    "start": 84.362,
    "end": 87.868,
    "zh": "我们总是玩得很开心，妈妈。",
    "zh_hant": "我們總是玩得很開心，媽媽。"
  },
  {
    "index": 25,
    "text": "Bye-bye.",
    "start": 87.518,
    "end": 87.989,
    "zh": "再见。",
    "zh_hant": "再見。"
  }
]
