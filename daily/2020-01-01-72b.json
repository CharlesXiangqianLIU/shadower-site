[
  {
    "index": 0,
    "text": "Lesson 143 A walk",
    "start": 0.95,
    "end": 4.892,
    "zh": "第143课 一次散步",
    "zh_hant": "第143課 一次散步"
  },
  {
    "index": 1,
    "text": "through the woods",
    "start": 4.672,
    "end": 6.233,
    "zh": "穿过树林",
    "zh_hant": "穿過樹林"
  },
  {
    "index": 2,
    "text": "Listen to the tape then",
    "start": 7.273,
    "end": 10.035,
    "zh": "先听录音，然后",
    "zh_hant": "先聽錄音，然後"
  },
  {
    "index": 3,
    "text": "answer this question.",
    "start": 9.875,
    "end": 11.795,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 4,
    "text": "What was so funny about the words",
    "start": 12.776,
    "end": 16.398,
    "zh": "牌子上的字",
    "zh_hant": "牌子上的字"
  },
  {
    "index": 5,
    "text": "on the sign?",
    "start": 16.158,
    "end": 17.578,
    "zh": "有什么好笑的？",
    "zh_hant": "有什麼好笑的？"
  },
  {
    "index": 6,
    "text": "I live in a very old town",
    "start": 19.98,
    "end": 23.321,
    "zh": "我住在一个非常古老的小镇上",
    "zh_hant": "我住在一個非常古老的小鎮上"
  },
  {
    "index": 7,
    "text": "which is surrounded by beautiful woods.",
    "start": 23.221,
    "end": 26.983,
    "zh": "四周环绕着美丽的树林。",
    "zh_hant": "四周環繞著美麗的樹林。"
  },
  {
    "index": 8,
    "text": "It is a famous beauty spot.",
    "start": 27.964,
    "end": 30.765,
    "zh": "这里是一个著名的风景胜地。",
    "zh_hant": "這裡是一個著名的風景勝地。"
  },
  {
    "index": 9,
    "text": "On Sundays,",
    "start": 32.086,
    "end": 33.586,
    "zh": "每逢星期天，",
    "zh_hant": "每逢星期天，"
  },
  {
    "index": 10,
    "text": "hundreds of people",
    "start": 33.546,
    "end": 35.367,
    "zh": "有数百人",
    "zh_hant": "有數百人"
  },
  {
    "index": 11,
    "text": "come from the city to see our town",
    "start": 35.067,
    "end": 38.609,
    "zh": "从城里来参观我们的小镇",
    "zh_hant": "從城裡來參觀我們的小鎮"
  },
  {
    "index": 12,
    "text": "and to walk through the woods.",
    "start": 38.669,
    "end": 41.631,
    "zh": "并在树林里散步。",
    "zh_hant": "並在樹林裡散步。"
  },
  {
    "index": 13,
    "text": "Visitors have been asked",
    "start": 42.491,
    "end": 45.032,
    "zh": "游客们已被要求",
    "zh_hant": "遊客們已被要求"
  },
  {
    "index": 14,
    "text": "to keep the woods clean",
    "start": 44.712,
    "end": 47.333,
    "zh": "保持树林干净",
    "zh_hant": "保持樹林乾淨"
  },
  {
    "index": 15,
    "text": "and tidy.",
    "start": 47.114,
    "end": 48.474,
    "zh": "整洁。",
    "zh_hant": "整潔。"
  },
  {
    "index": 16,
    "text": "Litter baskets have been placed under the trees,",
    "start": 49.475,
    "end": 53.476,
    "zh": "树下已经放置了垃圾篮，",
    "zh_hant": "樹下已經放置了垃圾籃，"
  },
  {
    "index": 17,
    "text": "but people still throw their rubbish",
    "start": 53.677,
    "end": 57.258,
    "zh": "但人们仍然把垃圾扔得",
    "zh_hant": "但人們仍然把垃圾扔得"
  },
  {
    "index": 18,
    "text": "everywhere.",
    "start": 57.038,
    "end": 58.219,
    "zh": "到处都是。",
    "zh_hant": "到處都是。"
  },
  {
    "index": 19,
    "text": "Last Wednesday,",
    "start": 58.959,
    "end": 60.76,
    "zh": "上个星期三，",
    "zh_hant": "上個星期三，"
  },
  {
    "index": 20,
    "text": "I went for a walk in the woods.",
    "start": 61.401,
    "end": 64.722,
    "zh": "我去树林里散步。",
    "zh_hant": "我去樹林裡散步。"
  },
  {
    "index": 21,
    "text": "What I saw made me very sad.",
    "start": 65.443,
    "end": 69.784,
    "zh": "我所看到的让我非常难过。",
    "zh_hant": "我所看到的讓我非常難過。"
  },
  {
    "index": 22,
    "text": "I counted seven old cars",
    "start": 70.785,
    "end": 74.127,
    "zh": "我数了数，有七辆旧汽车",
    "zh_hant": "我數了數，有七輛舊汽車"
  },
  {
    "index": 23,
    "text": "and three old refrigerators.",
    "start": 74.167,
    "end": 77.388,
    "zh": "和三台旧冰箱。",
    "zh_hant": "和三臺舊冰箱。"
  },
  {
    "index": 24,
    "text": "The little baskets were empty",
    "start": 78.129,
    "end": 80.75,
    "zh": "小篮子都是空的，",
    "zh_hant": "小籃子都是空的，"
  },
  {
    "index": 25,
    "text": "and the ground was covered with pieces of paper,",
    "start": 81.151,
    "end": 85.554,
    "zh": "而地面被纸片、",
    "zh_hant": "而地面被紙片、"
  },
  {
    "index": 26,
    "text": "cigarette ends, old tyres,",
    "start": 85.875,
    "end": 89.777,
    "zh": "烟头、旧轮胎、",
    "zh_hant": "菸頭、舊輪胎、"
  },
  {
    "index": 27,
    "text": "empty bottles and rusty tins.",
    "start": 90.118,
    "end": 93.68,
    "zh": "空瓶子和生锈的罐头盒覆盖着。",
    "zh_hant": "空瓶子和生鏽的罐頭盒覆蓋著。"
  },
  {
    "index": 28,
    "text": "Among the rubbish, I found",
    "start": 94.461,
    "end": 97.663,
    "zh": "在垃圾中，我发现",
    "zh_hant": "在垃圾中，我發現"
  },
  {
    "index": 29,
    "text": "a sign which said,",
    "start": 97.313,
    "end": 99.364,
    "zh": "一块牌子，上面写着：",
    "zh_hant": "一塊牌子，上面寫著："
  },
  {
    "index": 30,
    "text": "'Anyone who leaves litter",
    "start": 99.725,
    "end": 103.347,
    "zh": "“凡在此树林中",
    "zh_hant": "“凡在此樹林中"
  },
  {
    "index": 31,
    "text": "in these woods",
    "start": 103.208,
    "end": 104.949,
    "zh": "乱扔垃圾者，",
    "zh_hant": "亂扔垃圾者，"
  },
  {
    "index": 32,
    "text": "will be prosecuted!'",
    "start": 104.909,
    "end": 106.71,
    "zh": "将被起诉！”",
    "zh_hant": "將被起訴！”"
  }
]
