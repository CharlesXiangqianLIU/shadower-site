    "zh_hant": "它正在跑過草地。"
  },
  {
    "index": 17,
    "text": "It's running after a cat.",
    "start": 61.868,
    "end": 64.87,
    "zh": "它正在追一只猫。",
    "zh_hant": "它正在追一隻貓。"
