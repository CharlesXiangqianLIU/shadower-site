  {
    "index": 1,
    "text": "Where's Sally?",
    "start": 4.292,
    "end": 6.012,
    "zh": "萨莉在哪里？",
    "zh_hant": "薩莉在哪裡？"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 7.053,
    "end": 11.135,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "Is the cat climbing the tree?",
    "start": 13.256,
    "end": 16.518,
    "zh": "猫在爬树吗？",
    "zh_hant": "貓在爬樹嗎？"
  },
  {
    "index": 4,
    "text": "Where's Sally, Jack?",
    "start": 18.899,
    "end": 20.78,
    "zh": "杰克，萨莉在哪里？",
    "zh_hant": "傑克，薩莉在哪裡？"
  },
  {
    "index": 5,
    "text": "She's in the garden, Jean.",
    "start": 21.801,
    "end": 24.362,
    "zh": "她在花园里，琼。",
    "zh_hant": "她在花園裡，瓊。"
  },
  {
    "index": 6,
    "text": "What's she doing?",
    "start": 26.003,
    "end": 27.603,
    "zh": "她在做什么？",
    "zh_hant": "她在做什麼？"
  },
  {
    "index": 7,
    "text": "She's sitting under the tree.",
    "start": 28.544,
    "end": 31.305,
    "zh": "她正坐在树下。",
    "zh_hant": "她正坐在樹下。"
  },
  {
    "index": 8,
    "text": "Is Tim in the garden, too?",
    "start": 32.586,
    "end": 35.007,
    "zh": "蒂姆也在花园里吗？",
    "zh_hant": "蒂姆也在花園裡嗎？"
  },
  {
    "index": 9,
    "text": "Yes, he is.",
    "start": 36.028,
    "end": 38.288,
    "zh": "是的，他在。",
    "zh_hant": "是的，他在。"
  },
  {
    "index": 10,
    "text": "He's climbing the tree.",
    "start": 38.949,
    "end": 41.37,
    "zh": "他正在爬树。",
    "zh_hant": "他正在爬樹。"
  },
  {
    "index": 11,
    "text": "I beg your pardon?",
    "start": 42.931,
    "end": 44.732,
    "zh": "请再说一遍？",
    "zh_hant": "請再說一遍？"
  },
  {
    "index": 12,
    "text": "Who's climbing the tree?",
    "start": 45.934,
    "end": 47.955,
    "zh": "谁在爬树？",
    "zh_hant": "誰在爬樹？"
  },
  {
    "index": 13,
    "text": "Tim is.",
    "start": 48.616,
    "end": 50.037,
    "zh": "蒂姆。",
    "zh_hant": "蒂姆。"
  },
  {
    "index": 14,
    "text": "What about the dog?",
    "start": 51.659,
    "end": 53.54,
    "zh": "那只狗呢？",
    "zh_hant": "那隻狗呢？"
  },
  {
    "index": 15,
    "text": "The dog's in the garden, too.",
    "start": 54.361,
