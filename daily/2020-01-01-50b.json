[
  {
    "index": 0,
    "text": "Lesson 99 Ow!",
    "start": 0.61,
    "end": 3.712,
    "zh": "第99课 哎哟！",
    "zh_hant": "第99課 哎喲！"
  },
  {
    "index": 1,
    "text": "Listen to the tape then",
    "start": 4.772,
    "end": 7.674,
    "zh": "听录音，然后",
    "zh_hant": "聽錄音，然後"
  },
  {
    "index": 2,
    "text": "answer this question.",
    "start": 7.434,
    "end": 9.354,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 3,
    "text": "Must Andy go to see the doctor?",
    "start": 10.535,
    "end": 13.817,
    "zh": "安迪必须去看医生吗？",
    "zh_hant": "安迪必須去看醫生嗎？"
  },
  {
    "index": 4,
    "text": "Ow!",
    "start": 15.558,
    "end": 16.578,
    "zh": "哎哟！",
    "zh_hant": "哎喲！"
  },
  {
    "index": 5,
    "text": "What's the matter, Andy?",
    "start": 16.958,
    "end": 19.399,
    "zh": "怎么了，安迪？",
    "zh_hant": "怎麼了，安迪？"
  },
  {
    "index": 6,
    "text": "I slipped and fell downstairs.",
    "start": 20.14,
    "end": 23.401,
    "zh": "我滑倒了，摔下了楼梯。",
    "zh_hant": "我滑倒了，摔下了樓梯。"
  },
  {
    "index": 7,
    "text": "Have you hurt yourself?",
    "start": 23.582,
    "end": 26.063,
    "zh": "你伤着自己了吗？",
    "zh_hant": "你傷著自己了嗎？"
  },
  {
    "index": 8,
    "text": "Yes, I have.",
    "start": 26.183,
    "end": 28.004,
    "zh": "是的，我伤了。",
    "zh_hant": "是的，我傷了。"
  },
  {
    "index": 9,
    "text": "I think that I've hurt my back.",
    "start": 28.564,
    "end": 31.646,
    "zh": "我想我伤到了背。",
    "zh_hant": "我想我傷到了背。"
  },
  {
    "index": 10,
    "text": "Try and stand up.",
    "start": 32.466,
    "end": 34.827,
    "zh": "试着站起来。",
    "zh_hant": "試著站起來。"
  },
  {
    "index": 11,
    "text": "Can you stand up?",
    "start": 35.208,
    "end": 37.208,
    "zh": "你能站起来吗？",
    "zh_hant": "你能站起來嗎？"
  },
  {
    "index": 12,
    "text": "Here.",
    "start": 37.429,
    "end": 38.289,
    "zh": "来。",
    "zh_hant": "來。"
  },
  {
    "index": 13,
    "text": "Let me help you.",
    "start": 38.509,
    "end": 40.31,
    "zh": "让我帮你。",
    "zh_hant": "讓我幫你。"
  },
  {
    "index": 14,
    "text": "I'm sorry, Lucy.",
    "start": 41.591,
    "end": 43.252,
    "zh": "对不起，露西。",
    "zh_hant": "對不起，露西。"
  },
  {
    "index": 15,
    "text": "I'm afraid that I can't get up.",
    "start": 43.933,
    "end": 47.035,
    "zh": "恐怕我站不起来了。",
    "zh_hant": "恐怕我站不起來了。"
  },
  {
    "index": 16,
    "text": "I think that the doctor had better see you.",
    "start": 48.196,
    "end": 52.379,
    "zh": "我想医生最好来看看你。",
    "zh_hant": "我想醫生最好來看看你。"
  },
  {
    "index": 17,
    "text": "I'll phone Dr. Carter.",
    "start": 53.1,
    "end": 55.742,
    "zh": "我会给卡特医生打电话。",
    "zh_hant": "我會給卡特醫生打電話。"
  },
  {
    "index": 18,
    "text": "The doctor says that he will come at once.",
    "start": 56.943,
    "end": 61.386,
    "zh": "医生说他会马上来。",
    "zh_hant": "醫生說他會馬上來。"
  },
  {
    "index": 19,
    "text": "I'm sure that you need an X-ray,",
    "start": 61.907,
    "end": 65.769,
    "zh": "我确信你需要拍X光片，",
    "zh_hant": "我確信你需要拍X光片，"
  },
  {
    "index": 20,
    "text": "Andy.",
    "start": 65.569,
    "end": 66.45,
    "zh": "安迪。",
    "zh_hant": "安迪。"
  }
]
