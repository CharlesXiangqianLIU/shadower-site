[
  {
    "index": 0,
    "text": "Lesson 105.",
    "start": 1.53,
    "end": 4.702,
    "zh": "第105课。",
    "zh_hant": "第105課。"
  },
  {
    "index": 1,
    "text": "Full of mistakes.",
    "start": 4.752,
    "end": 6.273,
    "zh": "错误百出。",
    "zh_hant": "錯誤百出。"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 7.353,
    "end": 10.995,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "What was Sandra's present?",
    "start": 13.136,
    "end": 15.357,
    "zh": "桑德拉的礼物是什么？",
    "zh_hant": "桑德拉的禮物是什麼？"
  },
  {
    "index": 4,
    "text": "Where's Sandra, Bob?",
    "start": 17.758,
    "end": 19.459,
    "zh": "桑德拉在哪儿，鲍勃？",
    "zh_hant": "桑德拉在哪兒，鮑勃？"
  },
  {
    "index": 5,
    "text": "I want her.",
    "start": 19.94,
    "end": 20.94,
    "zh": "我要找她。",
    "zh_hant": "我要找她。"
  },
  {
    "index": 6,
    "text": "Do you want to speak to her?",
    "start": 22.221,
    "end": 23.681,
    "zh": "你想和她说话吗？",
    "zh_hant": "你想和她說話嗎？"
  },
  {
    "index": 7,
    "text": "Yes, I do.",
    "start": 24.282,
    "end": 25.442,
    "zh": "是的，我想。",
    "zh_hant": "是的，我想。"
  },
  {
    "index": 8,
    "text": "I want her to come to my office.",
    "start": 25.902,
    "end": 28.063,
    "zh": "我要她来我的办公室。",
    "zh_hant": "我要她來我的辦公室。"
  },
  {
    "index": 9,
    "text": "Tell her to come at once.",
    "start": 28.444,
    "end": 30.685,
    "zh": "告诉她马上来。",
    "zh_hant": "告訴她馬上來。"
  },
  {
    "index": 10,
    "text": "Did you want to see me?",
    "start": 31.945,
    "end": 33.446,
    "zh": "你想见我吗？",
    "zh_hant": "你想見我嗎？"
  },
  {
    "index": 11,
    "text": "Ah, yes, Sandra.",
    "start": 34.207,
    "end": 35.887,
    "zh": "啊，是的，桑德拉。",
    "zh_hant": "啊，是的，桑德拉。"
  },
  {
    "index": 12,
    "text": "How do you spell 'intelligent'?",
    "start": 36.328,
    "end": 39.029,
    "zh": "你怎么拼写‘intelligent’？",
    "zh_hant": "你怎麼拼寫‘intelligent’？"
  },
  {
    "index": 13,
    "text": "Can you tell me?",
    "start": 39.189,
    "end": 40.389,
    "zh": "你能告诉我吗？",
    "zh_hant": "你能告訴我嗎？"
  },
  {
    "index": 14,
    "text": "I-N-T-E-L-L-I-G-E-N-T.",
    "start": 40.169,
    "end": 41.81,
    "zh": "I-N-T-E-L-L-I-G-E-N-T。",
    "zh_hant": "I-N-T-E-L-L-I-G-E-N-T。"
  },
  {
    "index": 15,
    "text": "That's right.",
    "start": 49.991,
    "end": 51.391,
    "zh": "没错。",
    "zh_hant": "沒錯。"
  },
  {
    "index": 16,
    "text": "You've typed it with only one 'L'.",
    "start": 51.612,
    "end": 54.874,
    "zh": "你只打了一个‘L’。",
    "zh_hant": "你只打了一個‘L’。"
  },
  {
    "index": 17,
    "text": "This letter's full of mistakes.",
    "start": 55.275,
    "end": 57.697,
    "zh": "这封信错误百出。",
    "zh_hant": "這封信錯誤百出。"
  },
  {
    "index": 18,
    "text": "I want you to type it again.",
    "start": 57.977,
    "end": 60.319,
    "zh": "我要你再打一遍。",
    "zh_hant": "我要你再打一遍。"
  },
  {
    "index": 19,
    "text": "Yes, I'll do that.",
    "start": 60.739,
    "end": 62.2,
    "zh": "好的，我会做的。",
    "zh_hant": "好的，我會做的。"
  },
  {
    "index": 20,
    "text": "I'm sorry about that.",
    "start": 62.741,
    "end": 64.122,
    "zh": "对此我很抱歉。",
    "zh_hant": "對此我很抱歉。"
  },
  {
    "index": 21,
    "text": "And here's a little present for you.",
    "start": 65.003,
    "end": 67.685,
    "zh": "这里还有一个小礼物给你。",
    "zh_hant": "這裡還有一個小禮物給你。"
  },
  {
    "index": 22,
    "text": "What is it?",
    "start": 67.845,
    "end": 68.846,
    "zh": "这是什么？",
    "zh_hant": "這是什麼？"
  },
  {
    "index": 23,
    "text": "It's a dictionary.",
    "start": 69.466,
    "end": 71.528,
    "zh": "这是一本词典。",
    "zh_hant": "這是一本詞典。"
  },
  {
    "index": 24,
    "text": "I hope it'll help you.",
    "start": 71.968,
    "end": 73.89,
    "zh": "我希望它能帮到你。",
    "zh_hant": "我希望它能幫到你。"
  }
]
