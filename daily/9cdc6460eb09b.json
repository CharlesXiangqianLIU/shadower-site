[
  {
    "index": 0,
    "text": "Lesson 37 Making",
    "start": 1.551,
    "end": 5.392,
    "zh": "第37课 制作",
    "zh_hant": "第37課 製作"
  },
  {
    "index": 1,
    "text": "a bookcase",
    "start": 5.332,
    "end": 6.733,
    "zh": "一个书柜",
    "zh_hant": "一個書櫃"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 8.094,
    "end": 12.096,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "What is Susan's favourite colour?",
    "start": 14.277,
    "end": 17.478,
    "zh": "苏珊最喜欢的颜色是什么？",
    "zh_hant": "蘇珊最喜歡的顏色是什麼？"
  },
  {
    "index": 4,
    "text": "You're working hard, George.",
    "start": 19.86,
    "end": 22.02,
    "zh": "乔治，你干活真卖力。",
    "zh_hant": "喬治，你幹活真賣力。"
  },
  {
    "index": 5,
    "text": "What are you doing?",
    "start": 22.741,
    "end": 24.301,
    "zh": "你在做什么？",
    "zh_hant": "你在做什麼？"
  },
  {
    "index": 6,
    "text": "I'm making a bookcase.",
    "start": 25.983,
    "end": 28.524,
    "zh": "我在做一个书柜。",
    "zh_hant": "我在做一個書櫃。"
  },
  {
    "index": 7,
    "text": "Give me that hammer please, Dan.",
    "start": 30.485,
    "end": 33.206,
    "zh": "丹，请把那把锤子给我。",
    "zh_hant": "丹，請把那把錘子給我。"
  },
  {
    "index": 8,
    "text": "Which hammer?",
    "start": 35.047,
    "end": 36.147,
    "zh": "哪把锤子？",
    "zh_hant": "哪把錘子？"
  },
  {
    "index": 9,
    "text": "This one?",
    "start": 37.068,
    "end": 38.068,
    "zh": "这把吗？",
    "zh_hant": "這把嗎？"
  },
  {
    "index": 10,
    "text": "No, not that one.",
    "start": 39.269,
    "end": 41.63,
    "zh": "不，不是那把。",
    "zh_hant": "不，不是那把。"
  },
  {
    "index": 11,
    "text": "The big one.",
    "start": 42.191,
    "end": 43.732,
    "zh": "那把大的。",
    "zh_hant": "那把大的。"
  },
  {
    "index": 12,
    "text": "Here you are.",
    "start": 45.693,
    "end": 46.813,
    "zh": "给你。",
    "zh_hant": "給你。"
  },
  {
    "index": 13,
    "text": "Thanks, Dan.",
    "start": 47.814,
    "end": 49.074,
    "zh": "谢谢，丹。",
    "zh_hant": "謝謝，丹。"
  },
  {
    "index": 14,
    "text": "What are you going to do now, George?",
    "start": 50.855,
    "end": 53.817,
    "zh": "乔治，你接下来打算做什么？",
    "zh_hant": "喬治，你接下來打算做什麼？"
  },
  {
    "index": 15,
    "text": "I'm going to paint it.",
    "start": 55.298,
    "end": 57.579,
    "zh": "我打算给它上漆。",
    "zh_hant": "我打算給它上漆。"
  },
  {
    "index": 16,
    "text": "What colour are you going to paint it?",
    "start": 59.78,
    "end": 62.641,
    "zh": "你打算把它漆成什么颜色？",
    "zh_hant": "你打算把它漆成什麼顏色？"
  },
  {
    "index": 17,
    "text": "I'm going to paint it pink.",
    "start": 64.342,
    "end": 66.763,
    "zh": "我打算把它漆成粉色。",
    "zh_hant": "我打算把它漆成粉色。"
  },
  {
    "index": 18,
    "text": "This bookcase isn't for me.",
    "start": 71.006,
    "end": 73.326,
    "zh": "这个书柜不是给我自己做的。",
    "zh_hant": "這個書櫃不是給我自己做的。"
  },
  {
    "index": 19,
    "text": "It's for my daughter, Susan.",
    "start": 74.007,
    "end": 76.648,
    "zh": "是给我女儿苏珊做的。",
    "zh_hant": "是給我女兒蘇珊做的。"
  },
  {
    "index": 20,
    "text": "Pink's her favourite colour.",
    "start": 77.609,
    "end": 80.17,
    "zh": "粉色是她最喜欢的颜色。",
    "zh_hant": "粉色是她最喜歡的顏色。"
  }
]
