[
  {
    "index": 0,
    "text": "Lesson 37.",
    "start": 1.551,
    "end": 4.442,
    "zh": "第37课。",
    "zh_hant": "第37課。"
  },
  {
    "index": 1,
    "text": "Making a bookcase.",
    "start": 4.492,
    "end": 6.733,
    "zh": "制作一个书架。",
    "zh_hant": "製作一個書架。"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 8.094,
    "end": 12.096,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "What is Susan's favourite colour?",
    "start": 14.277,
    "end": 17.478,
    "zh": "苏珊最喜欢的颜色是什么？",
    "zh_hant": "蘇珊最喜歡的顏色是什麼？"
  },
  {
    "index": 4,
    "text": "You're working hard, George.",
    "start": 19.86,
    "end": 22.02,
    "zh": "你干得很辛苦，乔治。",
    "zh_hant": "你乾得很辛苦，喬治。"
  },
  {
    "index": 5,
    "text": "What are you doing?",
    "start": 22.741,
    "end": 24.301,
    "zh": "你在做什么？",
    "zh_hant": "你在做什麼？"
  },
  {
    "index": 6,
    "text": "I'm making a bookcase.",
    "start": 25.983,
    "end": 28.524,
    "zh": "我在做一个书架。",
    "zh_hant": "我在做一個書架。"
  },
  {
    "index": 7,
    "text": "Give me that hammer please, Dan.",
    "start": 30.485,
    "end": 33.206,
    "zh": "把那个锤子给我，丹。",
    "zh_hant": "把那個錘子給我，丹。"
  },
  {
    "index": 8,
    "text": "Which hammer?",
    "start": 35.047,
    "end": 36.147,
    "zh": "哪个锤子？",
    "zh_hant": "哪個錘子？"
  },
  {
    "index": 9,
    "text": "This one?",
    "start": 37.068,
    "end": 38.068,
    "zh": "这个吗？",
    "zh_hant": "這個嗎？"
  },
  {
    "index": 10,
    "text": "No, not that one.",
    "start": 39.269,
    "end": 41.63,
    "zh": "不，不是那个。",
    "zh_hant": "不，不是那個。"
  },
  {
    "index": 11,
    "text": "The big one.",
    "start": 42.191,
    "end": 43.732,
    "zh": "大的那个。",
    "zh_hant": "大的那個。"
  },
  {
    "index": 12,
    "text": "Here you are.",
    "start": 45.693,
    "end": 46.813,
    "zh": "给你。",
    "zh_hant": "給你。"
  },
  {
    "index": 13,
    "text": "Thanks, Dan.",
    "start": 47.814,
    "end": 49.074,
    "zh": "谢谢，丹。",
    "zh_hant": "謝謝，丹。"
  },
  {
    "index": 14,
    "text": "What are you going to do now, George?",
    "start": 50.855,
    "end": 53.817,
    "zh": "你现在打算做什么，乔治？",
    "zh_hant": "你現在打算做什麼，喬治？"
  },
  {
    "index": 15,
    "text": "I'm going to paint it.",
    "start": 55.298,
    "end": 57.579,
    "zh": "我打算把它刷漆。",
    "zh_hant": "我打算把它刷漆。"
  },
  {
    "index": 16,
    "text": "What colour are you going to paint it?",
    "start": 59.78,
    "end": 62.641,
    "zh": "你打算把它刷成什么颜色？",
    "zh_hant": "你打算把它刷成什麼顏色？"
  },
  {
    "index": 17,
    "text": "I'm going to paint it pink.",
    "start": 64.342,
    "end": 66.763,
    "zh": "我打算把它刷成粉红色。",
    "zh_hant": "我打算把它刷成粉紅色。"
  },
  {
    "index": 18,
    "text": "This bookcase isn't for me.",
    "start": 71.006,
    "end": 73.326,
    "zh": "这个书架不是给我做的。",
    "zh_hant": "這個書架不是給我做的。"
  },
  {
    "index": 19,
    "text": "It's for my daughter, Susan.",
    "start": 74.007,
    "end": 76.648,
    "zh": "是给我女儿苏珊做的。",
    "zh_hant": "是給我女兒蘇珊做的。"
  },
  {
    "index": 20,
    "text": "Pink's her favourite colour.",
    "start": 77.609,
    "end": 80.17,
    "zh": "粉红色是她最喜欢的颜色。",
    "zh_hant": "粉紅色是她最喜歡的顏色。"
  }
]
