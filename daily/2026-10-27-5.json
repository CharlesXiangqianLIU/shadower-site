[{"index": 0, "text": "No, I don't know what this is.", "start": 0.0, "end": 2.031, "zh": "不，我不知道这是什么。", "zh_hant": "不，我不知道這是什麼。"}, {"index": 1, "text": "No, you don't.", "start": 1.681, "end": 2.631, "zh": "不，你并不知道。", "zh_hant": "不，你並不知道。"}, {"index": 2, "text": "OK.", "start": 2.281, "end": 2.871, "zh": "好的。", "zh_hant": "好的。"}, {"index": 3, "text": "All right.", "start": 2.641, "end": 3.472, "zh": "好吧。", "zh_hant": "好吧。"}, {"index": 4, "text": "Well, I think everyone should have one of these.", "start": 3.322, "end": 6.173, "zh": "嗯，我觉得每个人都该有一个这个。", "zh_hant": "嗯，我覺得每個人都該有一個這個。"}, {"index": 5, "text": "It is versatile.", "start": 5.823, "end": 8.054, "zh": "它很百搭。", "zh_hant": "它很百搭。"}, {"index": 6, "text": "It is hypoallergenic.", "start": 9.205, "end": 11.035, "zh": "它防过敏。", "zh_hant": "它防過敏。"}, {"index": 7, "text": "It comes in a variety of sizes.", "start": 12.646, "end": 17.359, "zh": "它有各种尺寸。", "zh_hant": "它有各種尺寸。"}, {"index": 8, "text": "And Mother's Day is around the corner.", "start": 19.45, "end": 21.841, "zh": "而且母亲节就要到了。", "zh_hant": "而且母親節就要到了。"}, {"index": 9, "text": "Oh, I don't want to brag, but I have a couple.", "start": 23.252, "end": 26.363, "zh": "哦，我不想炫耀，但我有好几个。", "zh_hant": "哦，我不想炫耀，但我有好幾個。"}, {"index": 10, "text": "A couple.", "start": 27.934, "end": 28.884, "zh": "好几个。", "zh_hant": "好幾個。"}, {"index": 11, "text": "A lot.", "start": 29.135, "end": 30.085, "zh": "很多。", "zh_hant": "很多。"}, {"index": 12, "text": "More than a couple?", "start": 30.355, "end": 31.346, "zh": "不止好几个？", "zh_hant": "不止好幾個？"}, {"index": 13, "text": "Seven.", "start": 32.496, "end": 33.327, "zh": "七个。", "zh_hant": "七個。"}, {"index": 14, "text": "Right.", "start": 33.077, "end": 33.847, "zh": "对。", "zh_hant": "對。"}, {"index": 15, "text": "OK.", "start": 33.597, "end": 34.267, "zh": "好。", "zh_hant": "好。"}, {"index": 16, "text": "When you wear it, what does it make you feel like?", "start": 34.778, "end": 37.669, "zh": "穿上它的时候，你感觉怎么样？", "zh_hant": "穿上它的時候，你感覺怎麼樣？"}, {"index": 17, "text": "Really empowered and just ready for any kind of challenge.", "start": 38.099, "end": 45.798, "zh": "真的很有力量，随时准备好迎接任何挑战。", "zh_hant": "真的很有力量，隨時準備好迎接任何挑戰。"}, {"index": 18, "text": "Your favorite activity to do when you have it on?", "start": 46.43, "end": 49.723, "zh": "穿着它时你最喜欢做什么活动？", "zh_hant": "穿著它時你最喜歡做什麼活動？"}, {"index": 19, "text": "If the weather is nice, tennis.", "start": 49.754, "end": 55.05, "zh": "天气好的话，打网球。", "zh_hant": "天氣好的話，打網球。"}]