[
  {
    "index": 0,
    "text": "Lesson 97 A small",
    "start": 0.55,
    "end": 3.952,
    "zh": "第97课 一个小",
    "zh_hant": "第97課 一個小"
  },
  {
    "index": 1,
    "text": "blue case",
    "start": 3.732,
    "end": 5.232,
    "zh": "蓝色箱子",
    "zh_hant": "藍色箱子"
  },
  {
    "index": 2,
    "text": "Listen to the tape then",
    "start": 7.014,
    "end": 9.855,
    "zh": "听录音，然后",
    "zh_hant": "聽錄音，然後"
  },
  {
    "index": 3,
    "text": "answer this question.",
    "start": 9.715,
    "end": 11.616,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 4,
    "text": "Does Mr. Hall get his case back?",
    "start": 12.796,
    "end": 16.498,
    "zh": "霍尔先生拿回他的箱子了吗？",
    "zh_hant": "霍爾先生拿回他的箱子了嗎？"
  },
  {
    "index": 5,
    "text": "I left a suitcase",
    "start": 18.619,
    "end": 20.66,
    "zh": "我前几天把一个手提箱",
    "zh_hant": "我前幾天把一個手提箱"
  },
  {
    "index": 6,
    "text": "on the train to London the other day.",
    "start": 20.34,
    "end": 23.662,
    "zh": "落在了去伦敦的火车上。",
    "zh_hant": "落在了去倫敦的火車上。"
  },
  {
    "index": 7,
    "text": "Can you describe it, sir?",
    "start": 24.322,
    "end": 26.763,
    "zh": "先生，您能描述一下它吗？",
    "zh_hant": "先生，您能描述一下它嗎？"
  },
  {
    "index": 8,
    "text": "It's a small blue case",
    "start": 27.804,
    "end": 30.865,
    "zh": "它是一个小蓝箱子",
    "zh_hant": "它是一個小藍箱子"
  },
  {
    "index": 9,
    "text": "and it's got a zip.",
    "start": 30.725,
    "end": 32.926,
    "zh": "而且有个拉链。",
    "zh_hant": "而且有個拉鍊。"
  },
  {
    "index": 10,
    "text": "There's a label on the handle",
    "start": 34.247,
    "end": 36.868,
    "zh": "把手上有个标签",
    "zh_hant": "把手上有個標籤"
  },
  {
    "index": 11,
    "text": "with my name and address on it.",
    "start": 36.849,
    "end": 39.89,
    "zh": "上面写着我的名字和地址。",
    "zh_hant": "上面寫著我的名字和地址。"
  },
  {
    "index": 12,
    "text": "Is this case yours?",
    "start": 40.39,
    "end": 42.751,
    "zh": "这个箱子是你的吗？",
    "zh_hant": "這個箱子是你的嗎？"
  },
  {
    "index": 13,
    "text": "No, that's not mine.",
    "start": 43.092,
    "end": 45.413,
    "zh": "不，那不是我的。",
    "zh_hant": "不，那不是我的。"
  },
  {
    "index": 14,
    "text": "What about this one?",
    "start": 45.793,
    "end": 48.134,
    "zh": "那这个呢？",
    "zh_hant": "那這個呢？"
  },
  {
    "index": 15,
    "text": "This one's got a label.",
    "start": 48.214,
    "end": 50.635,
    "zh": "这个有标签。",
    "zh_hant": "這個有標籤。"
  },
  {
    "index": 16,
    "text": "Let me see it.",
    "start": 51.556,
    "end": 53.237,
    "zh": "让我看看。",
    "zh_hant": "讓我看看。"
  },
  {
    "index": 17,
    "text": "What's your name and address?",
    "start": 53.917,
    "end": 56.638,
    "zh": "你叫什么名字和地址？",
    "zh_hant": "你叫什麼名字和地址？"
  },
  {
    "index": 18,
    "text": "David Hall, 83, Bridge",
    "start": 57.519,
    "end": 61.561,
    "zh": "大卫·霍尔，布里奇街83号。",
    "zh_hant": "大衛·霍爾，布里奇街83號。"
  },
  {
    "index": 19,
    "text": "Street.",
    "start": 61.261,
    "end": 62.141,
    "zh": "街。",
    "zh_hant": "街。"
  },
  {
    "index": 20,
    "text": "That's right.",
    "start": 62.542,
    "end": 63.782,
    "zh": "没错。",
    "zh_hant": "沒錯。"
  },
  {
    "index": 21,
    "text": "D. N. Hall, 83, Bridge",
    "start": 64.062,
    "end": 68.264,
    "zh": "D. N. 霍尔，布里奇",
    "zh_hant": "D. N. 霍爾，布里奇"
  },
  {
    "index": 22,
    "text": "Street.",
    "start": 67.914,
    "end": 68.764,
    "zh": "街83号。",
    "zh_hant": "街83號。"
  },
  {
    "index": 23,
    "text": "Three pounds fifty pence, please.",
    "start": 69.965,
    "end": 73.187,
    "zh": "请付三英镑五十便士。",
    "zh_hant": "請付三英鎊五十便士。"
  },
  {
    "index": 24,
    "text": "Here you are.",
    "start": 73.707,
    "end": 75.268,
    "zh": "给你。",
    "zh_hant": "給你。"
  },
  {
    "index": 25,
    "text": "Thank you.",
    "start": 75.488,
    "end": 76.468,
    "zh": "谢谢。",
    "zh_hant": "謝謝。"
  },
  {
    "index": 26,
    "text": "Hey!",
    "start": 76.849,
    "end": 77.729,
    "zh": "嘿！",
    "zh_hant": "嘿！"
  },
  {
    "index": 27,
    "text": "What's the matter?",
    "start": 78.069,
    "end": 79.341,
    "zh": "怎么了？",
    "zh_hant": "怎麼了？"
  },
  {
    "index": 28,
    "text": "This case doesn't belong to me!",
    "start": 78.941,
    "end": 83.1,
    "zh": "这个箱子不是我的！",
    "zh_hant": "這個箱子不是我的！"
  },
  {
    "index": 29,
    "text": "You've given me the wrong case!",
    "start": 84.524,
    "end": 87.43,
    "zh": "你给错我箱子了！",
    "zh_hant": "你給錯我箱子了！"
  }
]
