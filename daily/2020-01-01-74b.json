[
  {
    "index": 0,
    "text": "Why was the writer's aunt surprised?",
    "start": 10.51,
    "end": 14.352,
    "zh": "为什么作家的姑妈感到惊讶？",
    "zh_hant": "為什麼作家的姑媽感到驚訝？"
  },
  {
    "index": 1,
    "text": "It was Sunday.",
    "start": 15.973,
    "end": 17.434,
    "zh": "那天是星期天。",
    "zh_hant": "那天是星期天。"
  },
  {
    "index": 2,
    "text": "I never get up early on Sundays.",
    "start": 18.134,
    "end": 21.456,
    "zh": "我星期天从来不早起。",
    "zh_hant": "我星期天從來不早起。"
  },
  {
    "index": 3,
    "text": "I sometimes stay in bed until lunchtime.",
    "start": 22.136,
    "end": 26.058,
    "zh": "我有时躺在床上一直待到午饭时间。",
    "zh_hant": "我有時躺在床上一直待到午飯時間。"
  },
  {
    "index": 4,
    "text": "Last Sunday I got up very late.",
    "start": 26.858,
    "end": 30.38,
    "zh": "上个星期天我起得很晚。",
    "zh_hant": "上個星期天我起得很晚。"
  },
  {
    "index": 5,
    "text": "I looked out of the window.",
    "start": 31.141,
    "end": 33.121,
    "zh": "我朝窗外望去。",
    "zh_hant": "我朝窗外望去。"
  },
  {
    "index": 6,
    "text": "It was dark outside.",
    "start": 33.442,
    "end": 35.462,
    "zh": "外面很黑。",
    "zh_hant": "外面很黑。"
  },
  {
    "index": 7,
    "text": "'What a day!'",
    "start": 35.112,
    "end": 38.144,
    "zh": "‘真是糟糕的一天！’",
    "zh_hant": "‘真是糟糕的一天！’"
  },
  {
    "index": 8,
    "text": "I thought.",
    "start": 38.264,
    "end": 39.164,
    "zh": "我想。",
    "zh_hant": "我想。"
  },
  {
    "index": 9,
    "text": "'It's raining again.'",
    "start": 38.814,
    "end": 41.745,
    "zh": "‘又下雨了。’",
    "zh_hant": "‘又下雨了。’"
  },
  {
    "index": 10,
    "text": "Just then, the telephone rang.",
    "start": 42.646,
    "end": 45.547,
    "zh": "就在那时，电话铃响了。",
    "zh_hant": "就在那時，電話鈴響了。"
  },
  {
    "index": 11,
    "text": "It was my aunt Lucy.",
    "start": 46.028,
    "end": 48.029,
    "zh": "是我姑妈露西打来的。",
    "zh_hant": "是我姑媽露西打來的。"
  },
  {
    "index": 12,
    "text": "'I've just arrived by train,' she said.",
    "start": 49.089,
    "end": 52.672,
    "zh": "她说：‘我刚坐火车到。’",
    "zh_hant": "她說：‘我剛坐火車到。’"
  },
  {
    "index": 13,
    "text": "'I'm coming to see you.'",
    "start": 52.392,
    "end": 55.414,
    "zh": "‘我正要来看你。’",
    "zh_hant": "‘我正要來看你。’"
  },
  {
    "index": 14,
    "text": "'But I'm still having breakfast,' I said.",
    "start": 55.064,
    "end": 59.938,
    "zh": "我说：‘但我还在吃早饭呢。’",
    "zh_hant": "我說：‘但我還在吃早飯呢。’"
  },
  {
    "index": 15,
    "text": "'What are you doing?'",
    "start": 59.588,
    "end": 62.56,
    "zh": "‘你在干什么？’",
    "zh_hant": "‘你在幹什麼？’"
  },
  {
    "index": 16,
    "text": "she asked.",
    "start": 62.26,
    "end": 63.461,
    "zh": "她问道。",
    "zh_hant": "她問道。"
  },
  {
    "index": 17,
    "text": "'I'm having breakfast,' I repeated.",
    "start": 63.121,
    "end": 67.043,
    "zh": "我重复道：‘我在吃早饭。’",
    "zh_hant": "我重複道：‘我在吃早飯。’"
  },
  {
    "index": 18,
    "text": "'Dear me,' she said.",
    "start": 66.693,
    "end": 70.026,
    "zh": "她说：‘哎呀。’",
    "zh_hant": "她說：‘哎呀。’"
  },
  {
    "index": 19,
    "text": "'Do you always get up so late?",
    "start": 69.686,
    "end": 73.068,
    "zh": "‘你总是起这么晚吗？",
    "zh_hant": "‘你總是起這麼晚嗎？"
  },
  {
    "index": 20,
    "text": "It's one o'clock!'",
    "start": 73.389,
    "end": 75.31,
    "zh": "都一点钟了！’",
    "zh_hant": "都一點鐘了！’"
  }
]
