[
  {
    "index": 0,
    "text": "Lesson 101.",
    "start": 0.851,
    "end": 4.182,
    "zh": "第101课。",
    "zh_hant": "第101課。"
  },
  {
    "index": 1,
    "text": "A card from Jimmy.",
    "start": 4.232,
    "end": 6.253,
    "zh": "吉米寄来的一张明信片。",
    "zh_hant": "吉米寄來的一張明信片。"
  },
  {
    "index": 2,
    "text": "Listen to the tape then",
    "start": 7.434,
    "end": 10.315,
    "zh": "听录音，然后",
    "zh_hant": "聽錄音，然後"
  },
  {
    "index": 3,
    "text": "answer this question.",
    "start": 10.055,
    "end": 12.016,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 4,
    "text": "Does grandmother seem pleased",
    "start": 12.897,
    "end": 16.078,
    "zh": "祖母收到吉米的明信片",
    "zh_hant": "祖母收到吉米的明信片"
  },
  {
    "index": 5,
    "text": "to get a card from Jimmy?",
    "start": 15.778,
    "end": 18.459,
    "zh": "似乎很高兴吗？",
    "zh_hant": "似乎很高興嗎？"
  },
  {
    "index": 6,
    "text": "Why/Why not?",
    "start": 19.16,
    "end": 21.481,
    "zh": "为什么/为什么不？",
    "zh_hant": "為什麼/為什麼不？"
  },
  {
    "index": 7,
    "text": "Read Jimmy's card to me please, Penny.",
    "start": 23.662,
    "end": 27.764,
    "zh": "请给我读一下吉米的明信片，彭妮。",
    "zh_hant": "請給我讀一下吉米的明信片，彭妮。"
  },
  {
    "index": 8,
    "text": "'I have just arrived",
    "start": 27.414,
    "end": 31.345,
    "zh": "‘我刚到达",
    "zh_hant": "‘我剛到達"
  },
  {
    "index": 9,
    "text": "in Scotland",
    "start": 31.006,
    "end": 32.606,
    "zh": "苏格兰’",
    "zh_hant": "蘇格蘭’"
  },
  {
    "index": 10,
    "text": "and I'm staying at a Youth",
    "start": 32.646,
    "end": 35.708,
    "zh": "而且我现在住在青年",
    "zh_hant": "而且我現在住在青年"
  },
  {
    "index": 11,
    "text": "Hostel.'",
    "start": 35.388,
    "end": 37.409,
    "zh": "旅舍。’",
    "zh_hant": "旅舍。’"
  },
  {
    "index": 12,
    "text": "Eh?",
    "start": 37.149,
    "end": 37.929,
    "zh": "嗯？",
    "zh_hant": "嗯？"
  },
  {
    "index": 13,
    "text": "He says he's just arrived",
    "start": 38.87,
    "end": 42.391,
    "zh": "他说他刚到",
    "zh_hant": "他說他剛到"
  },
  {
    "index": 14,
    "text": "in Scotland.",
    "start": 42.072,
    "end": 43.692,
    "zh": "苏格兰。",
    "zh_hant": "蘇格蘭。"
  },
  {
    "index": 15,
    "text": "He says he's staying",
    "start": 43.973,
    "end": 46.674,
    "zh": "他说他现在住在",
    "zh_hant": "他說他現在住在"
  },
  {
    "index": 16,
    "text": "at a Youth Hostel.",
    "start": 46.454,
    "end": 48.935,
    "zh": "青年旅舍。",
    "zh_hant": "青年旅舍。"
  },
  {
    "index": 17,
    "text": "You know he's",
    "start": 49.375,
    "end": 51.376,
    "zh": "你知道他是",
    "zh_hant": "你知道他是"
  },
  {
    "index": 18,
    "text": "a member of the Y.H.A.",
    "start": 51.056,
    "end": 54.818,
    "zh": "Y.H.A.的成员。",
    "zh_hant": "Y.H.A.的成員。"
  },
  {
    "index": 19,
    "text": "The what?",
    "start": 56.299,
    "end": 57.499,
    "zh": "什么协会？",
    "zh_hant": "什麼協會？"
  },
  {
    "index": 20,
    "text": "The Y.H.A., Mum.",
    "start": 58.059,
    "end": 60.801,
    "zh": "Y.H.A.，妈妈。",
    "zh_hant": "Y.H.A.，媽媽。"
  },
  {
    "index": 21,
    "text": "The Youth Hostels Association.",
    "start": 61.281,
    "end": 64.722,
    "zh": "青年旅舍协会。",
    "zh_hant": "青年旅舍協會。"
  },
  {
    "index": 22,
    "text": "What else does he say?",
    "start": 65.823,
    "end": 68.224,
    "zh": "他还说了什么？",
    "zh_hant": "他還說了什麼？"
  },
  {
    "index": 23,
    "text": "'I'll write a letter soon.",
    "start": 68.364,
    "end": 72.006,
    "zh": "‘我很快就会写信。",
    "zh_hant": "‘我很快就會寫信。"
  },
  {
    "index": 24,
    "text": "I hope you are all well.'",
    "start": 72.547,
    "end": 77.008,
    "zh": "希望你们都很好。’",
    "zh_hant": "希望你們都很好。’"
  },
  {
    "index": 25,
    "text": "What?",
    "start": 76.709,
    "end": 77.689,
    "zh": "什么？",
    "zh_hant": "什麼？"
  },
  {
    "index": 26,
    "text": "Speak up, Penny.",
    "start": 77.989,
    "end": 79.77,
    "zh": "大声点，彭妮。",
    "zh_hant": "大聲點，彭妮。"
  },
  {
    "index": 27,
    "text": "I'm afraid I can't hear you.",
    "start": 80.371,
    "end": 83.113,
    "zh": "恐怕我听不清你说话。",
    "zh_hant": "恐怕我聽不清你說話。"
  },
  {
    "index": 28,
    "text": "He says he'll write a letter soon.",
    "start": 84.154,
    "end": 88.076,
    "zh": "他说他很快就会写信。",
    "zh_hant": "他說他很快就會寫信。"
  },
  {
    "index": 29,
    "text": "He hopes we are all well.",
    "start": 88.377,
    "end": 91.819,
    "zh": "他希望我们都很好。",
    "zh_hant": "他希望我們都很好。"
  },
  {
    "index": 30,
    "text": "'Love, Jimmy.'",
    "start": 91.699,
    "end": 94.501,
    "zh": "‘爱你们的，吉米。’",
    "zh_hant": "‘愛你們的，吉米。’"
  },
  {
    "index": 31,
    "text": "Is that all?",
    "start": 95.682,
    "end": 97.263,
    "zh": "就这些吗？",
    "zh_hant": "就這些嗎？"
  },
  {
    "index": 32,
    "text": "He doesn't say very much,",
    "start": 97.864,
    "end": 100.645,
    "zh": "他没写多少内容，",
    "zh_hant": "他沒寫多少內容，"
  },
  {
    "index": 33,
    "text": "does he?",
    "start": 100.445,
    "end": 102.947,
    "zh": "是吗？",
    "zh_hant": "是嗎？"
  },
  {
    "index": 34,
    "text": "can't write very much on a card, Mum.",
    "start": 102.607,
    "end": 107.07,
    "zh": "明信片上写不了太多字，妈妈。",
    "zh_hant": "明信片上寫不了太多字，媽媽。"
  }
]
