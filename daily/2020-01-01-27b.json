[
  {
    "index": 0,
    "text": "Lesson 53.",
    "start": 0.65,
    "end": 3.422,
    "zh": "第53课。",
    "zh_hant": "第53課。"
  },
  {
    "index": 1,
    "text": "An interesting climate.",
    "start": 3.472,
    "end": 5.873,
    "zh": "有趣的气候。",
    "zh_hant": "有趣的氣候。"
  },
  {
    "index": 2,
    "text": "Listen to the tape then",
    "start": 7.234,
    "end": 10.095,
    "zh": "听录音，然后",
    "zh_hant": "聽錄音，然後"
  },
  {
    "index": 3,
    "text": "answer this question.",
    "start": 9.895,
    "end": 11.816,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 4,
    "text": "What is the favourite subject of conversation",
    "start": 13.617,
    "end": 18.039,
    "zh": "人们最喜欢谈论的话题是什么",
    "zh_hant": "人們最喜歡談論的話題是什麼"
  },
  {
    "index": 5,
    "text": "in England?",
    "start": 17.879,
    "end": 19.199,
    "zh": "在英格兰？",
    "zh_hant": "在英格蘭？"
  },
  {
    "index": 6,
    "text": "Where do you come from?",
    "start": 21.621,
    "end": 23.742,
    "zh": "你来自哪里？",
    "zh_hant": "你來自哪裡？"
  },
  {
    "index": 7,
    "text": "I come from England.",
    "start": 25.002,
    "end": 27.043,
    "zh": "我来自英格兰。",
    "zh_hant": "我來自英格蘭。"
  },
  {
    "index": 8,
    "text": "What's the climate like in your country?",
    "start": 27.744,
    "end": 30.925,
    "zh": "你们国家的气候怎么样？",
    "zh_hant": "你們國家的氣候怎麼樣？"
  },
  {
    "index": 9,
    "text": "It's mild, but it's not always pleasant.",
    "start": 31.786,
    "end": 36.188,
    "zh": "温和，但并非总是宜人。",
    "zh_hant": "溫和，但並非總是宜人。"
  },
  {
    "index": 10,
    "text": "The weather's often cold in the North",
    "start": 37.469,
    "end": 41.031,
    "zh": "北方天气经常寒冷",
    "zh_hant": "北方天氣經常寒冷"
  },
  {
    "index": 11,
    "text": "and windy in the East.",
    "start": 41.231,
    "end": 43.872,
    "zh": "东方常刮风。",
    "zh_hant": "東方常颳風。"
  },
  {
    "index": 12,
    "text": "It's often wet in the West",
    "start": 44.373,
    "end": 47.394,
    "zh": "西方经常潮湿",
    "zh_hant": "西方經常潮溼"
  },
  {
    "index": 13,
    "text": "and sometimes warm in the South.",
    "start": 47.674,
    "end": 51.356,
    "zh": "南方有时暖和。",
    "zh_hant": "南方有時暖和。"
  },
  {
    "index": 14,
    "text": "Which seasons do you like best?",
    "start": 52.236,
    "end": 55.438,
    "zh": "你最喜欢哪些季节？",
    "zh_hant": "你最喜歡哪些季節？"
  },
  {
    "index": 15,
    "text": "I like spring and summer.",
    "start": 56.779,
    "end": 59.42,
    "zh": "我喜欢春天和夏天。",
    "zh_hant": "我喜歡春天和夏天。"
  },
  {
    "index": 16,
    "text": "The days are long",
    "start": 59.96,
    "end": 62.181,
    "zh": "白天长",
    "zh_hant": "白天長"
  },
  {
    "index": 17,
    "text": "and the nights are short.",
    "start": 62.402,
    "end": 64.943,
    "zh": "夜晚短。",
    "zh_hant": "夜晚短。"
  },
  {
    "index": 18,
    "text": "The sun rises early and sets late.",
    "start": 65.643,
    "end": 69.865,
    "zh": "太阳升得早，落得晚。",
    "zh_hant": "太陽昇得早，落得晚。"
  },
  {
    "index": 19,
    "text": "I don't like autumn and winter.",
    "start": 70.926,
    "end": 74.047,
    "zh": "我不喜欢秋天和冬天。",
    "zh_hant": "我不喜歡秋天和冬天。"
  },
  {
    "index": 20,
    "text": "The days are short and the nights",
    "start": 74.908,
    "end": 78.669,
    "zh": "白天短，夜晚",
    "zh_hant": "白天短，夜晚"
  },
  {
    "index": 21,
    "text": "are long.",
    "start": 78.43,
    "end": 79.79,
    "zh": "长。",
    "zh_hant": "長。"
  },
  {
    "index": 22,
    "text": "The sun rises late and sets",
    "start": 80.732,
    "end": 84.696,
    "zh": "太阳升得晚，落得",
    "zh_hant": "太陽昇得晚，落得"
  },
  {
    "index": 23,
    "text": "early.",
    "start": 84.576,
    "end": 85.396,
    "zh": "早。",
    "zh_hant": "早。"
  },
  {
    "index": 24,
    "text": "Our climate is not very good,",
    "start": 86.538,
    "end": 89.701,
    "zh": "我们的气候不太好，",
    "zh_hant": "我們的氣候不太好，"
  },
  {
    "index": 25,
    "text": "but it's certainly interesting.",
    "start": 89.922,
    "end": 93.045,
    "zh": "但确实很有趣。",
    "zh_hant": "但確實很有趣。"
  },
  {
    "index": 26,
    "text": "It's our favourite subject of conversation.",
    "start": 93.726,
    "end": 97.57,
    "zh": "这是我们最喜欢谈论的话题。",
    "zh_hant": "這是我們最喜歡談論的話題。"
  }
]
