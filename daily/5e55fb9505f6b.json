[
  {
    "index": 0,
    "text": "Lesson 129.",
    "start": 1.55,
    "end": 5.042,
    "zh": "第129课。",
    "zh_hant": "第129課。"
  },
  {
    "index": 1,
    "text": "Seventy miles an hour.",
    "start": 5.092,
    "end": 7.233,
    "zh": "每小时七十英里。",
    "zh_hant": "每小時七十英里。"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 8.193,
    "end": 11.535,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "What does Ann advise her husband to do next time?",
    "start": 13.716,
    "end": 17.618,
    "zh": "安建议她丈夫下次做什么？",
    "zh_hant": "安建議她丈夫下次做什麼？"
  },
  {
    "index": 4,
    "text": "Look, Gary!",
    "start": 19.919,
    "end": 21.159,
    "zh": "看，加里！",
    "zh_hant": "看，加里！"
  },
  {
    "index": 5,
    "text": "That policeman's waving to you.",
    "start": 21.1,
    "end": 23.401,
    "zh": "那个警察在向你挥手。",
    "zh_hant": "那個警察在向你揮手。"
  },
  {
    "index": 6,
    "text": "He wants you to stop.",
    "start": 23.441,
    "end": 25.141,
    "zh": "他想让你停下来。",
    "zh_hant": "他想讓你停下來。"
  },
  {
    "index": 7,
    "text": "Where do you think you are?",
    "start": 26.502,
    "end": 28.663,
    "zh": "你以为你在哪儿？",
    "zh_hant": "你以為你在哪兒？"
  },
  {
    "index": 8,
    "text": "On a race track?",
    "start": 28.844,
    "end": 30.464,
    "zh": "在赛道上吗？",
    "zh_hant": "在賽道上嗎？"
  },
  {
    "index": 9,
    "text": "You must have been driving at seventy miles an hour.",
    "start": 31.045,
    "end": 35.226,
    "zh": "你刚才一定是每小时七十英里的速度开车。",
    "zh_hant": "你剛才一定是每小時七十英里的速度開車。"
  },
  {
    "index": 10,
    "text": "I can't have been.",
    "start": 36.367,
    "end": 37.908,
    "zh": "我不可能那样。",
    "zh_hant": "我不可能那樣。"
  },
  {
    "index": 11,
    "text": "I was doing eighty when I overtook you.",
    "start": 39.349,
    "end": 42.07,
    "zh": "我超过你时是每小时八十英里。",
    "zh_hant": "我超過你時是每小時八十英里。"
  },
  {
    "index": 12,
    "text": "Didn't you see the speed limit?",
    "start": 43.45,
    "end": 45.831,
    "zh": "你没看到限速标志吗？",
    "zh_hant": "你沒看到限速標誌嗎？"
  },
  {
    "index": 13,
    "text": "I'm afraid I didn't, officer.",
    "start": 47.232,
    "end": 49.253,
    "zh": "恐怕我没看到，警官。",
    "zh_hant": "恐怕我沒看到，警官。"
  },
  {
    "index": 14,
    "text": "I must have been dreaming.",
    "start": 49.734,
    "end": 51.574,
    "zh": "我一定是在做梦。",
    "zh_hant": "我一定是在做夢。"
  },
  {
    "index": 15,
    "text": "He wasn't dreaming, officer.",
    "start": 52.255,
    "end": 54.396,
    "zh": "他没有做梦，警官。",
    "zh_hant": "他沒有做夢，警官。"
  },
  {
    "index": 16,
    "text": "I was telling him to drive slowly.",
    "start": 54.816,
    "end": 57.337,
    "zh": "我当时在告诉他开慢点。",
    "zh_hant": "我當時在告訴他開慢點。"
  },
  {
    "index": 17,
    "text": "That's why I didn't see the sign.",
    "start": 57.637,
    "end": 60.639,
    "zh": "所以我才没看到标志。",
    "zh_hant": "所以我才沒看到標誌。"
  },
  {
    "index": 18,
    "text": "Let me see your driving licence.",
    "start": 62.0,
    "end": 64.641,
    "zh": "让我看看你的驾驶执照。",
    "zh_hant": "讓我看看你的駕駛執照。"
  },
  {
    "index": 19,
    "text": "I won't charge you this time.",
    "start": 66.182,
    "end": 68.302,
    "zh": "这次我不罚你。",
    "zh_hant": "這次我不罰你。"
  },
  {
    "index": 20,
    "text": "But you'd better not do it again!",
    "start": 68.463,
    "end": 70.824,
    "zh": "但你最好别再这样了！",
    "zh_hant": "但你最好別再這樣了！"
  },
  {
    "index": 21,
    "text": "Thank you.",
    "start": 71.464,
    "end": 72.344,
    "zh": "谢谢。",
    "zh_hant": "謝謝。"
  },
  {
    "index": 22,
    "text": "I'll certainly be more careful.",
    "start": 72.945,
    "end": 74.866,
    "zh": "我一定会更小心的。",
    "zh_hant": "我一定會更小心的。"
  },
  {
    "index": 23,
    "text": "I told you to drive slowly, Gary.",
    "start": 75.726,
    "end": 78.567,
    "zh": "我告诉过你开慢点，加里。",
    "zh_hant": "我告訴過你開慢點，加里。"
  },
  {
    "index": 24,
    "text": "You always tell me to drive slowly, darling.",
    "start": 79.148,
    "end": 82.509,
    "zh": "你总是叫我开慢点，亲爱的。",
    "zh_hant": "你總是叫我開慢點，親愛的。"
  },
  {
    "index": 25,
    "text": "Well, next time you'd better take my advice!",
    "start": 82.81,
    "end": 86.449,
    "zh": "好吧，下次你最好听我的建议！",
    "zh_hant": "好吧，下次你最好聽我的建議！"
  }
]
