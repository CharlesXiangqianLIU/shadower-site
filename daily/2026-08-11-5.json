[{"index": 0, "text": "Tell me what the movie's about.", "start": 0.0, "end": 1.791, "zh": "告诉我这部电影讲了什么。", "zh_hant": "告訴我這部電影講了什麼。"}, {"index": 1, "text": "Well, it's a movie about...", "start": 1.441, "end": 3.992, "zh": "嗯，这是一部关于……", "zh_hant": "嗯，這是一部關於……"}, {"index": 2, "text": "Can you not tell me?", "start": 7.884, "end": 9.154, "zh": "你能不跟我说吗？", "zh_hant": "你能不跟我說嗎？"}, {"index": 3, "text": "Is it like...", "start": 8.804, "end": 9.575, "zh": "它是不是像……", "zh_hant": "它是不是像……"}, {"index": 4, "text": "No, it's that I am an idiot.", "start": 9.225, "end": 11.336, "zh": "不，是因为我太蠢了。", "zh_hant": "不，是因為我太蠢了。"}, {"index": 5, "text": "I've been having a problem the whole day remembering these words.", "start": 12.627, "end": 15.918, "zh": "我一整天都在为记住这些词发愁。", "zh_hant": "我一整天都在為記住這些詞發愁。"}, {"index": 6, "text": "So I wrote it in my finger, in my hand.", "start": 15.728, "end": 19.34, "zh": "所以我把它写在手指上，手心里。", "zh_hant": "所以我把它寫在手指上，手心裡。"}, {"index": 7, "text": "But I have my glasses on.", "start": 19.09, "end": 21.341, "zh": "但我戴着眼镜。", "zh_hant": "但我戴著眼鏡。"}, {"index": 8, "text": "Can I see?", "start": 20.991, "end": 21.741, "zh": "我能看一下吗？", "zh_hant": "我能看一下嗎？"}, {"index": 9, "text": "No, I know...", "start": 21.871, "end": 23.322, "zh": "不，我知道……", "zh_hant": "不，我知道……"}, {"index": 10, "text": "I'll whisper it in your ear.", "start": 22.972, "end": 24.542, "zh": "我会在你耳边悄悄告诉你。", "zh_hant": "我會在你耳邊悄悄告訴你。"}, {"index": 11, "text": "It's my English.", "start": 25.713, "end": 27.164, "zh": "这是我的英语问题。", "zh_hant": "這是我的英語問題。"}, {"index": 12, "text": "Okay, so it was...", "start": 29.795, "end": 32.126, "zh": "好吧，所以它是……", "zh_hant": "好吧，所以它是……"}, {"index": 13, "text": "So, what's the movie about?", "start": 31.776, "end": 33.007, "zh": "那么，这部电影讲了什么？", "zh_hant": "那麼，這部電影講了什麼？"}, {"index": 14, "text": "So, it was a movie about redemption.", "start": 34.998, "end": 37.529, "zh": "所以，这是一部关于救赎的电影。", "zh_hant": "所以，這是一部關於救贖的電影。"}, {"index": 15, "text": "Redemption.", "start": 37.919, "end": 39.35, "zh": "救赎。", "zh_hant": "救贖。"}, {"index": 16, "text": "I'm an idiot.", "start": 47.44, "end": 49.112, "zh": "我真是个白痴。", "zh_hant": "我真是個白痴。"}, {"index": 17, "text": "I'm jet-lagged.", "start": 48.762, "end": 50.073, "zh": "我时差还没倒过来。", "zh_hant": "我時差還沒倒過來。"}, {"index": 18, "text": "I'm sorry.", "start": 49.723, "end": 50.634, "zh": "对不起。", "zh_hant": "對不起。"}, {"index": 19, "text": "It's about redemption, but I kept thinking constipation, like, congestion, like, everything.", "start": 50.605, "end": 57.284, "zh": "是关于救赎的，但我一直想到便秘、堵塞之类的词。", "zh_hant": "是關於救贖的，但我一直想到便秘、堵塞之類的詞。"}]