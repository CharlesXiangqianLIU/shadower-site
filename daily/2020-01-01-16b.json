[
  {
    "index": 0,
    "text": "Lesson 31.",
    "start": 0.49,
    "end": 2.962,
    "zh": "第31课。",
    "zh_hant": "第31課。"
  },
  {
    "index": 1,
    "text": "Where's Sally?",
    "start": 3.012,
    "end": 4.592,
    "zh": "莎莉在哪里？",
    "zh_hant": "莎莉在哪裡？"
  },
  {
    "index": 2,
    "text": "Listen to the tape then",
    "start": 5.633,
    "end": 8.534,
    "zh": "听录音，然后",
    "zh_hant": "聽錄音，然後"
  },
  {
    "index": 3,
    "text": "answer this question.",
    "start": 8.334,
    "end": 10.275,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 4,
    "text": "Is the cat climbing the tree?",
    "start": 11.416,
    "end": 14.137,
    "zh": "猫在爬树吗？",
    "zh_hant": "貓在爬樹嗎？"
  },
  {
    "index": 5,
    "text": "Where's Sally, Jack?",
    "start": 15.738,
    "end": 18.139,
    "zh": "莎莉在哪里，杰克？",
    "zh_hant": "莎莉在哪裡，傑克？"
  },
  {
    "index": 6,
    "text": "She's in the garden, Jean.",
    "start": 18.679,
    "end": 21.14,
    "zh": "她在花园里，琼。",
    "zh_hant": "她在花園裡，瓊。"
  },
  {
    "index": 7,
    "text": "What's she doing?",
    "start": 21.401,
    "end": 23.161,
    "zh": "她在做什么？",
    "zh_hant": "她在做什麼？"
  },
  {
    "index": 8,
    "text": "She's sitting under the tree.",
    "start": 23.442,
    "end": 26.083,
    "zh": "她正坐在树下。",
    "zh_hant": "她正坐在樹下。"
  },
  {
    "index": 9,
    "text": "Is Tim in the garden, too?",
    "start": 26.563,
    "end": 29.565,
    "zh": "蒂姆也在花园里吗？",
    "zh_hant": "蒂姆也在花園裡嗎？"
  },
  {
    "index": 10,
    "text": "Yes, he is.",
    "start": 29.885,
    "end": 31.626,
    "zh": "是的，他在。",
    "zh_hant": "是的，他在。"
  },
  {
    "index": 11,
    "text": "He's climbing the tree.",
    "start": 31.766,
    "end": 33.907,
    "zh": "他正在爬树。",
    "zh_hant": "他正在爬樹。"
  },
  {
    "index": 12,
    "text": "I beg your pardon?",
    "start": 34.827,
    "end": 36.608,
    "zh": "请再说一遍？",
    "zh_hant": "請再說一遍？"
  },
  {
    "index": 13,
    "text": "Who's climbing the tree?",
    "start": 36.808,
    "end": 39.109,
    "zh": "谁在爬树？",
    "zh_hant": "誰在爬樹？"
  },
  {
    "index": 14,
    "text": "Tim is.",
    "start": 39.41,
    "end": 40.792,
    "zh": "蒂姆。",
    "zh_hant": "蒂姆。"
  },
  {
    "index": 15,
    "text": "What about the dog?",
    "start": 41.393,
    "end": 43.476,
    "zh": "那只狗呢？",
    "zh_hant": "那隻狗呢？"
  },
  {
    "index": 16,
    "text": "The dog's in the garden, too.",
    "start": 43.897,
    "end": 46.64,
    "zh": "狗也在花园里。",
    "zh_hant": "狗也在花園裡。"
  },
  {
    "index": 17,
    "text": "It's running across the grass.",
    "start": 46.861,
    "end": 49.785,
    "zh": "它正在跑过草地。",
    "zh_hant": "它正在跑過草地。"
  },
  {
    "index": 18,
    "text": "It's running after a cat.",
    "start": 50.006,
    "end": 52.85,
    "zh": "它正在追一只猫。",
    "zh_hant": "它正在追一隻貓。"
  }
]
