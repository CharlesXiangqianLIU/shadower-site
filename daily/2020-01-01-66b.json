[
  {
    "index": 0,
    "text": "Lesson 131.",
    "start": 0.71,
    "end": 3.322,
    "zh": "第131课。",
    "zh_hant": "第131課。"
  },
  {
    "index": 1,
    "text": "Don't be so sure!",
    "start": 3.372,
    "end": 5.913,
    "zh": "别这么肯定！",
    "zh_hant": "別這麼肯定！"
  },
  {
    "index": 2,
    "text": "Listen to the tape then",
    "start": 7.294,
    "end": 10.315,
    "zh": "先听录音，",
    "zh_hant": "先聽錄音，"
  },
  {
    "index": 3,
    "text": "answer this question.",
    "start": 10.095,
    "end": 11.996,
    "zh": "然后回答这个问题。",
    "zh_hant": "然後回答這個問題。"
  },
  {
    "index": 4,
    "text": "What's the problem about deciding on a holiday?",
    "start": 13.037,
    "end": 17.459,
    "zh": "决定假期有什么问题？",
    "zh_hant": "決定假期有什麼問題？"
  },
  {
    "index": 5,
    "text": "Where are you going to spend your holidays",
    "start": 19.68,
    "end": 23.522,
    "zh": "你今年假期打算去哪儿过，",
    "zh_hant": "你今年假期打算去哪兒過，"
  },
  {
    "index": 6,
    "text": "this year, Gary?",
    "start": 23.202,
    "end": 24.922,
    "zh": "加里？",
    "zh_hant": "加里？"
  },
  {
    "index": 7,
    "text": "We may go abroad.",
    "start": 25.803,
    "end": 28.064,
    "zh": "我们可能出国。",
    "zh_hant": "我們可能出國。"
  },
  {
    "index": 8,
    "text": "I'm not sure.",
    "start": 28.724,
    "end": 30.245,
    "zh": "我不确定。",
    "zh_hant": "我不確定。"
  },
  {
    "index": 9,
    "text": "My wife wants to go to Egypt.",
    "start": 30.925,
    "end": 33.967,
    "zh": "我妻子想去埃及。",
    "zh_hant": "我妻子想去埃及。"
  },
  {
    "index": 10,
    "text": "I'd like to go there, too.",
    "start": 34.767,
    "end": 36.928,
    "zh": "我也想去那儿。",
    "zh_hant": "我也想去那兒。"
  },
  {
    "index": 11,
    "text": "We can't make up our minds.",
    "start": 37.889,
    "end": 40.711,
    "zh": "我们拿不定主意。",
    "zh_hant": "我們拿不定主意。"
  },
  {
    "index": 12,
    "text": "Will you travel by sea or by air?",
    "start": 41.831,
    "end": 45.673,
    "zh": "你们乘船去还是乘飞机去？",
    "zh_hant": "你們乘船去還是乘飛機去？"
  },
  {
    "index": 13,
    "text": "We may travel by sea.",
    "start": 45.974,
    "end": 48.434,
    "zh": "我们可能乘船去。",
    "zh_hant": "我們可能乘船去。"
  },
  {
    "index": 14,
    "text": "It's cheaper, isn't it?",
    "start": 49.315,
    "end": 52.376,
    "zh": "更便宜，不是吗？",
    "zh_hant": "更便宜，不是嗎？"
  },
  {
    "index": 15,
    "text": "may be cheaper, but it takes a long time.",
    "start": 52.077,
    "end": 56.438,
    "zh": "可能更便宜，但很耗时。",
    "zh_hant": "可能更便宜，但很耗時。"
  },
  {
    "index": 16,
    "text": "I'm sure you'll enjoy yourselves.",
    "start": 57.299,
    "end": 60.02,
    "zh": "我相信你们会玩得开心。",
    "zh_hant": "我相信你們會玩得開心。"
  },
  {
    "index": 17,
    "text": "Don't be so sure.",
    "start": 60.261,
    "end": 62.241,
    "zh": "别这么肯定。",
    "zh_hant": "別這麼肯定。"
  },
  {
    "index": 18,
    "text": "We might not go anywhere.",
    "start": 62.302,
    "end": 64.903,
    "zh": "我们可能哪儿都不去。",
    "zh_hant": "我們可能哪兒都不去。"
  },
  {
    "index": 19,
    "text": "My wife always worries too much.",
    "start": 65.063,
    "end": 68.605,
    "zh": "我妻子总是担心太多。",
    "zh_hant": "我妻子總是擔心太多。"
  },
  {
    "index": 20,
    "text": "Who's going to look after the dog?",
    "start": 69.005,
    "end": 72.166,
    "zh": "谁来照看狗呢？",
    "zh_hant": "誰來照看狗呢？"
  },
  {
    "index": 21,
    "text": "Who's going to look after the house?",
    "start": 72.467,
    "end": 75.768,
    "zh": "谁来照看房子呢？",
    "zh_hant": "誰來照看房子呢？"
  },
  {
    "index": 22,
    "text": "Who's going to look after the garden?",
    "start": 76.069,
    "end": 79.19,
    "zh": "谁来照看花园呢？",
    "zh_hant": "誰來照看花園呢？"
  },
  {
    "index": 23,
    "text": "We have this problem every year.",
    "start": 79.573,
    "end": 82.598,
    "zh": "我们每年都有这个问题。",
    "zh_hant": "我們每年都有這個問題。"
  },
  {
    "index": 24,
    "text": "In the end, we stay at home",
    "start": 83.08,
    "end": 86.045,
    "zh": "最后，我们就待在家里",
    "zh_hant": "最後，我們就待在家裡"
  },
  {
    "index": 25,
    "text": "and look after everything!",
    "start": 85.866,
    "end": 88.35,
    "zh": "照看一切！",
    "zh_hant": "照看一切！"
  }
]
