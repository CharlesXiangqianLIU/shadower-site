[
  {
    "index": 0,
    "text": "Lesson 51 A pleasant",
    "start": 0.49,
    "end": 4.352,
    "zh": "第51课 宜人的",
    "zh_hant": "第51課 宜人的"
  },
  {
    "index": 1,
    "text": "climate Listen to the tape",
    "start": 4.052,
    "end": 8.234,
    "zh": "气候 听录音",
    "zh_hant": "氣候 聽錄音"
  },
  {
    "index": 2,
    "text": "then answer this question.",
    "start": 8.394,
    "end": 10.935,
    "zh": "然后回答这个问题。",
    "zh_hant": "然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "Does it ever snow in Greece?",
    "start": 11.856,
    "end": 15.277,
    "zh": "希腊下过雪吗？",
    "zh_hant": "希臘下過雪嗎？"
  },
  {
    "index": 4,
    "text": "Where do you come from?",
    "start": 16.998,
    "end": 19.219,
    "zh": "你来自哪里？",
    "zh_hant": "你來自哪裡？"
  },
  {
    "index": 5,
    "text": "I come from Greece.",
    "start": 20.12,
    "end": 22.261,
    "zh": "我来自希腊。",
    "zh_hant": "我來自希臘。"
  },
  {
    "index": 6,
    "text": "What's the climate like in your country?",
    "start": 22.921,
    "end": 26.303,
    "zh": "你们国家的气候怎么样？",
    "zh_hant": "你們國家的氣候怎麼樣？"
  },
  {
    "index": 7,
    "text": "It's very pleasant.",
    "start": 27.284,
    "end": 29.564,
    "zh": "非常宜人。",
    "zh_hant": "非常宜人。"
  },
  {
    "index": 8,
    "text": "What's the weather like in spring?",
    "start": 30.305,
    "end": 33.186,
    "zh": "春天的天气怎么样？",
    "zh_hant": "春天的天氣怎麼樣？"
  },
  {
    "index": 9,
    "text": "It's often windy in March.",
    "start": 34.267,
    "end": 37.288,
    "zh": "三月经常刮风。",
    "zh_hant": "三月經常颳風。"
  },
  {
    "index": 10,
    "text": "It's always warm in April and May,",
    "start": 37.749,
    "end": 41.751,
    "zh": "四月和五月总是很暖和，",
    "zh_hant": "四月和五月總是很暖和，"
  },
  {
    "index": 11,
    "text": "but it rains sometimes.",
    "start": 42.312,
    "end": 44.652,
    "zh": "但有时下雨。",
    "zh_hant": "但有時下雨。"
  },
  {
    "index": 12,
    "text": "What's it like in summer?",
    "start": 45.473,
    "end": 47.994,
    "zh": "夏天怎么样？",
    "zh_hant": "夏天怎麼樣？"
  },
  {
    "index": 13,
    "text": "It's always hot in June,",
    "start": 48.995,
    "end": 51.936,
    "zh": "六月总是很热，",
    "zh_hant": "六月總是很熱，"
  },
  {
    "index": 14,
    "text": "July and August.",
    "start": 51.716,
    "end": 53.937,
    "zh": "七月和八月。",
    "zh_hant": "七月和八月。"
  },
  {
    "index": 15,
    "text": "The sun shines every day.",
    "start": 54.678,
    "end": 57.519,
    "zh": "每天阳光普照。",
    "zh_hant": "每天陽光普照。"
  },
  {
    "index": 16,
    "text": "Is it cold or warm in autumn?",
    "start": 58.139,
    "end": 62.641,
    "zh": "秋天是冷还是暖和？",
    "zh_hant": "秋天是冷還是暖和？"
  },
  {
    "index": 17,
    "text": "It's always warm in September and October.",
    "start": 62.291,
    "end": 66.563,
    "zh": "九月和十月总是很暖和。",
    "zh_hant": "九月和十月總是很暖和。"
  },
  {
    "index": 18,
    "text": "It's often cold in November",
    "start": 67.064,
    "end": 70.205,
    "zh": "十一月经常很冷，",
    "zh_hant": "十一月經常很冷，"
  },
  {
    "index": 19,
    "text": "and it rains sometimes.",
    "start": 70.405,
    "end": 73.046,
    "zh": "而且有时下雨。",
    "zh_hant": "而且有時下雨。"
  },
  {
    "index": 20,
    "text": "Is it very cold in winter?",
    "start": 73.507,
    "end": 76.288,
    "zh": "冬天很冷吗？",
    "zh_hant": "冬天很冷嗎？"
  },
  {
    "index": 21,
    "text": "It's often cold in December,",
    "start": 77.229,
    "end": 80.25,
    "zh": "十二月经常很冷，",
    "zh_hant": "十二月經常很冷，"
  },
  {
    "index": 22,
    "text": "January and February.",
    "start": 80.354,
    "end": 82.901,
    "zh": "一月和二月。",
    "zh_hant": "一月和二月。"
  },
  {
    "index": 23,
    "text": "It snows sometimes.",
    "start": 83.284,
    "end": 85.35,
    "zh": "有时下雪。",
    "zh_hant": "有時下雪。"
  }
]
