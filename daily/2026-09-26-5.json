[{"index": 0, "text": "Can we just play it now?", "start": 0.0, "end": 1.07, "zh": "我们现在能放一下吗？", "zh_hant": "我們現在能放一下嗎？"}, {"index": 1, "text": "Cold Michelle Pfeiffer, that?", "start": 0.72, "end": 8.275, "zh": "冷酷的米歇尔·菲佛，那个？", "zh_hant": "冷酷的米歇爾·菲佛，那個？"}, {"index": 2, "text": "You're in a song.", "start": 7.925, "end": 8.895, "zh": "你出现在一首歌里。", "zh_hant": "你出現在一首歌裡。"}, {"index": 3, "text": "It's good.", "start": 8.646, "end": 9.536, "zh": "挺好的。", "zh_hant": "挺好的。"}, {"index": 4, "text": "It's very good.", "start": 9.186, "end": 9.984, "zh": "非常好。", "zh_hant": "非常好。"}, {"index": 5, "text": "It's very good.", "start": 10.006, "end": 11.277, "zh": "非常好。", "zh_hant": "非常好。"}, {"index": 6, "text": "Yeah, yeah.", "start": 10.927, "end": 11.957, "zh": "是啊，是啊。", "zh_hant": "是啊，是啊。"}, {"index": 7, "text": "But do they ask your permission?", "start": 11.607, "end": 13.458, "zh": "但他们会征求你的同意吗？", "zh_hant": "但他們會徵求你的同意嗎？"}, {"index": 8, "text": "I suppose they don't need to.", "start": 13.108, "end": 14.019, "zh": "我想他们不需要吧。", "zh_hant": "我想他們不需要吧。"}, {"index": 9, "text": "No, no, I don't think they have to.", "start": 13.669, "end": 14.599, "zh": "不，不，我觉得他们不必。", "zh_hant": "不，不，我覺得他們不必。"}, {"index": 10, "text": "I don't think they have to.", "start": 14.249, "end": 15.46, "zh": "我觉得他们不必。", "zh_hant": "我覺得他們不必。"}, {"index": 11, "text": "Yeah, it was very cool.", "start": 16.31, "end": 18.121, "zh": "是啊，那挺酷的。", "zh_hant": "是啊，那挺酷的。"}, {"index": 12, "text": "It was a little embarrassing at times.", "start": 17.771, "end": 19.682, "zh": "有时候有点尴尬。", "zh_hant": "有時候有點尷尬。"}, {"index": 13, "text": "I'm in carpool with the kids and the song comes on, and my son's like...", "start": 19.933, "end": 23.945, "zh": "我和孩子们拼车的时候，那首歌一放，我儿子就……", "zh_hant": "我和孩子們拼車的時候，那首歌一放，我兒子就……"}, {"index": 14, "text": "or I'm in exercise class and the song comes on and", "start": 28.578, "end": 31.63, "zh": "或者我在上健身课的时候，那首歌一放，", "zh_hant": "或者我在上健身課的時候，那首歌一放，"}]