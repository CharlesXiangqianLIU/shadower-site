[{"index": 0, "text": "Watch yourself around Rihanna.", "start": 0.0, "end": 2.171, "zh": "在蕾哈娜身边你得小心点。", "zh_hant": "在蕾哈娜身邊你得小心點。"}, {"index": 1, "text": "Now, Rihanna, I don't know if you know how criminal you are.", "start": 1.821, "end": 4.832, "zh": "蕾哈娜，我不知道你知不知道你有多像个罪犯。", "zh_hant": "蕾哈娜，我不知道你知不知道你有多像個罪犯。"}, {"index": 2, "text": "OK, let's just look at this picture.", "start": 4.562, "end": 6.373, "zh": "好，我们来看看这张照片。", "zh_hant": "好，我們來看看這張照片。"}, {"index": 3, "text": "Did you ask permission from the club when you left holding this glass?", "start": 6.243, "end": 10.635, "zh": "你拿着这个杯子离开时，问过俱乐部是否允许吗？", "zh_hant": "你拿著這個杯子離開時，問過俱樂部是否允許嗎？"}, {"index": 4, "text": "Might have been one that I took to the club.", "start": 13.067, "end": 17.299, "zh": "可能是我自己带去俱乐部的那个。", "zh_hant": "可能是我自己帶去俱樂部的那個。"}, {"index": 5, "text": "What about this one?", "start": 16.949, "end": 17.979, "zh": "那这个呢？", "zh_hant": "那這個呢？"}, {"index": 6, "text": "What about this one?", "start": 17.629, "end": 18.599, "zh": "那这个呢？", "zh_hant": "那這個呢？"}, {"index": 7, "text": "Did you ask about that glass?", "start": 18.429, "end": 20.76, "zh": "那个杯子你问过吗？", "zh_hant": "那個杯子你問過嗎？"}, {"index": 8, "text": "That looks kind of familiar.", "start": 22.732, "end": 25.463, "zh": "那个看着有点眼熟。", "zh_hant": "那個看著有點眼熟。"}, {"index": 9, "text": "What about this one?", "start": 25.113, "end": 26.323, "zh": "那这个呢？", "zh_hant": "那這個呢？"}, {"index": 10, "text": "What about this one?", "start": 25.973, "end": 26.963, "zh": "那这个呢？", "zh_hant": "那這個呢？"}, {"index": 11, "text": "Did you ask about that one?", "start": 26.613, "end": 28.484, "zh": "那个你问过吗？", "zh_hant": "那個你問過嗎？"}, {"index": 12, "text": "That's the same one.", "start": 28.134, "end": 29.425, "zh": "是同一个。", "zh_hant": "是同一個。"}, {"index": 13, "text": "That's coming out of my wages!", "start": 29.075, "end": 30.865, "zh": "那要从我工资里扣的！", "zh_hant": "那要從我工資里扣的！"}, {"index": 14, "text": "That's the same!", "start": 30.716, "end": 31.686, "zh": "是一样的！", "zh_hant": "是一樣的！"}, {"index": 15, "text": "Okay, what about this one?", "start": 31.556, "end": 33.187, "zh": "好，那这个呢？", "zh_hant": "好，那這個呢？"}, {"index": 16, "text": "There you are leaving the fashion show.", "start": 33.457, "end": 35.408, "zh": "你从时装秀出来的时候在这儿。", "zh_hant": "你從時裝秀出來的時候在這兒。"}, {"index": 17, "text": "I took that back to the hotel that I took it from.", "start": 35.458, "end": 38.389, "zh": "我把它带回了我拿它的那家酒店。", "zh_hant": "我把它帶回了我拿它的那家酒店。"}, {"index": 18, "text": "Of course you did.", "start": 38.039, "end": 39.19, "zh": "你当然会这么说。", "zh_hant": "你當然會這麼說。"}, {"index": 19, "text": "This one.", "start": 38.92, "end": 42.175, "zh": "这个。", "zh_hant": "這個。"}, {"index": 20, "text": "There's another one.", "start": 41.825, "end": 43.377, "zh": "还有一个。", "zh_hant": "還有一個。"}, {"index": 21, "text": "There's another one.", "start": 44.35, "end": 46.182, "zh": "还有一个。", "zh_hant": "還有一個。"}, {"index": 22, "text": "And sometimes you don't even bother to seal the glass, just a ball.", "start": 46.193, "end": 50.369, "zh": "有时候你连封口都懒得封，直接就一饮而尽。", "zh_hant": "有時候你連封口都懶得封，直接就一飲而盡。"}]