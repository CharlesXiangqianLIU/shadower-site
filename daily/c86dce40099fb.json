[
  {
    "index": 0,
    "text": "Lesson 91.",
    "start": 1.55,
    "end": 4.022,
    "zh": "第91课。",
    "zh_hant": "第91課。"
  },
  {
    "index": 1,
    "text": "Poor Ian!",
    "start": 4.072,
    "end": 5.592,
    "zh": "可怜的伊恩！",
    "zh_hant": "可憐的伊恩！"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 6.273,
    "end": 9.874,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "Who wanted to sell the house?",
    "start": 11.956,
    "end": 14.497,
    "zh": "谁想卖房子？",
    "zh_hant": "誰想賣房子？"
  },
  {
    "index": 4,
    "text": "Has Ian sold his house yet?",
    "start": 16.838,
    "end": 19.619,
    "zh": "伊恩已经卖掉他的房子了吗？",
    "zh_hant": "伊恩已經賣掉他的房子了嗎？"
  },
  {
    "index": 5,
    "text": "Yes, he has.",
    "start": 20.7,
    "end": 22.461,
    "zh": "是的，他已经卖掉了。",
    "zh_hant": "是的，他已經賣掉了。"
  },
  {
    "index": 6,
    "text": "He sold it last week.",
    "start": 22.521,
    "end": 24.642,
    "zh": "他上周卖掉的。",
    "zh_hant": "他上週賣掉的。"
  },
  {
    "index": 7,
    "text": "Has he moved to his new house yet?",
    "start": 25.942,
    "end": 29.084,
    "zh": "他已经搬进新房子了吗？",
    "zh_hant": "他已經搬進新房子了嗎？"
  },
  {
    "index": 8,
    "text": "No, not yet.",
    "start": 30.064,
    "end": 32.265,
    "zh": "没有，还没搬。",
    "zh_hant": "沒有，還沒搬。"
  },
  {
    "index": 9,
    "text": "He's still here.",
    "start": 32.446,
    "end": 33.926,
    "zh": "他还在这里。",
    "zh_hant": "他還在這裡。"
  },
  {
    "index": 10,
    "text": "He's going to move tomorrow.",
    "start": 34.487,
    "end": 36.848,
    "zh": "他打算明天搬。",
    "zh_hant": "他打算明天搬。"
  },
  {
    "index": 11,
    "text": "When?",
    "start": 39.049,
    "end": 39.869,
    "zh": "什么时候？",
    "zh_hant": "什麼時候？"
  },
  {
    "index": 12,
    "text": "Tomorrow morning?",
    "start": 40.189,
    "end": 41.71,
    "zh": "明天早上吗？",
    "zh_hant": "明天早上嗎？"
  },
  {
    "index": 13,
    "text": "No. Tomorrow afternoon.",
    "start": 42.59,
    "end": 45.612,
    "zh": "不，明天下午。",
    "zh_hant": "不，明天下午。"
  },
  {
    "index": 14,
    "text": "I'll miss him.",
    "start": 46.472,
    "end": 47.813,
    "zh": "我会想念他的。",
    "zh_hant": "我會想念他的。"
  },
  {
    "index": 15,
    "text": "He has always been a good neighbour.",
    "start": 48.153,
    "end": 51.134,
    "zh": "他一直是个好邻居。",
    "zh_hant": "他一直是個好鄰居。"
  },
  {
    "index": 16,
    "text": "He's a very nice person.",
    "start": 52.195,
    "end": 54.356,
    "zh": "他是个非常好的人。",
    "zh_hant": "他是個非常好的人。"
  },
  {
    "index": 17,
    "text": "We'll all miss him.",
    "start": 54.896,
    "end": 56.637,
    "zh": "我们都会想念他的。",
    "zh_hant": "我們都會想念他的。"
  },
  {
    "index": 18,
    "text": "When will the new people move into this house?",
    "start": 59.499,
    "end": 63.681,
    "zh": "新房客什么时候搬进这栋房子？",
    "zh_hant": "新房客什麼時候搬進這棟房子？"
  },
  {
    "index": 19,
    "text": "I think that they'll move in the day after tomorrow.",
    "start": 65.482,
    "end": 69.203,
    "zh": "我想他们后天会搬进来。",
    "zh_hant": "我想他們後天會搬進來。"
  },
  {
    "index": 20,
    "text": "Will you see Ian today, Jenny?",
    "start": 71.084,
    "end": 73.545,
    "zh": "珍妮，你今天会见到伊恩吗？",
    "zh_hant": "珍妮，你今天會見到伊恩嗎？"
  },
  {
    "index": 21,
    "text": "Yes, I will.",
    "start": 74.886,
    "end": 76.747,
    "zh": "是的，我会。",
    "zh_hant": "是的，我會。"
  },
  {
    "index": 22,
    "text": "Please give him my regards.",
    "start": 77.948,
    "end": 80.229,
    "zh": "请代我向他问好。",
    "zh_hant": "請代我向他問好。"
  },
  {
    "index": 23,
    "text": "Poor Ian!",
    "start": 81.489,
    "end": 82.85,
    "zh": "可怜的伊恩！",
    "zh_hant": "可憐的伊恩！"
  },
  {
    "index": 24,
    "text": "He didn't want to leave this house.",
    "start": 83.333,
    "end": 86.297,
    "zh": "他不想离开这栋房子。",
    "zh_hant": "他不想離開這棟房子。"
  },
  {
    "index": 25,
    "text": "No, he didn't want to leave,",
    "start": 87.24,
    "end": 90.466,
    "zh": "是的，他不想离开，",
    "zh_hant": "是的，他不想離開，"
  },
  {
    "index": 26,
    "text": "but his wife did!",
    "start": 90.627,
    "end": 92.469,
    "zh": "但他妻子想！",
    "zh_hant": "但他妻子想！"
  }
]
