[
  {
    "index": 0,
    "text": "Lesson 133.",
    "start": 1.47,
    "end": 4.622,
    "zh": "第133课。",
    "zh_hant": "第133課。"
  },
  {
    "index": 1,
    "text": "Sensational news!",
    "start": 4.672,
    "end": 6.352,
    "zh": "轰动性的新闻！",
    "zh_hant": "轟動性的新聞！"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 7.693,
    "end": 11.055,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "What reasons did Karen Marsh give for wanting to retire?",
    "start": 13.156,
    "end": 17.258,
    "zh": "卡伦·马什给出什么理由想退休？",
    "zh_hant": "卡倫·馬什給出什麼理由想退休？"
  },
  {
    "index": 4,
    "text": "Have you just made a new film, Miss Marsh?",
    "start": 19.519,
    "end": 22.04,
    "zh": "马什小姐，你刚拍完一部新电影吗？",
    "zh_hant": "馬什小姐，你剛拍完一部新電影嗎？"
  },
  {
    "index": 5,
    "text": "Yes, I have.",
    "start": 22.44,
    "end": 24.561,
    "zh": "是的，我拍完了。",
    "zh_hant": "是的，我拍完了。"
  },
  {
    "index": 6,
    "text": "Are you going to make another?",
    "start": 24.722,
    "end": 26.462,
    "zh": "你打算再拍一部吗？",
    "zh_hant": "你打算再拍一部嗎？"
  },
  {
    "index": 7,
    "text": "No, I'm not.",
    "start": 26.803,
    "end": 28.523,
    "zh": "不，我不打算。",
    "zh_hant": "不，我不打算。"
  },
  {
    "index": 8,
    "text": "I'm going to retire.",
    "start": 28.804,
    "end": 30.584,
    "zh": "我要退休了。",
    "zh_hant": "我要退休了。"
  },
  {
    "index": 9,
    "text": "I feel very tired.",
    "start": 31.125,
    "end": 33.346,
    "zh": "我感到非常疲惫。",
    "zh_hant": "我感到非常疲憊。"
  },
  {
    "index": 10,
    "text": "I don't want to make another film for a long time.",
    "start": 33.626,
    "end": 37.268,
    "zh": "我想很长时间不再拍电影了。",
    "zh_hant": "我想很長時間不再拍電影了。"
  },
  {
    "index": 11,
    "text": "Let's buy a newspaper, Liz.",
    "start": 38.348,
    "end": 40.509,
    "zh": "利兹，我们买份报纸吧。",
    "zh_hant": "利茲，我們買份報紙吧。"
  },
  {
    "index": 12,
    "text": "Listen to this!",
    "start": 40.67,
    "end": 41.42,
    "zh": "听这个！",
    "zh_hant": "聽這個！"
  },
  {
    "index": 13,
    "text": "'Karen Marsh:",
    "start": 41.02,
    "end": 44.032,
    "zh": "'卡伦·马什：",
    "zh_hant": "'卡倫·馬什："
  },
  {
    "index": 14,
    "text": "Sensational News!",
    "start": 43.772,
    "end": 45.653,
    "zh": "轰动性的新闻！",
    "zh_hant": "轟動性的新聞！"
  },
  {
    "index": 15,
    "text": "By our reporter, Alan Jones.",
    "start": 45.513,
    "end": 47.834,
    "zh": "本报记者艾伦·琼斯报道。",
    "zh_hant": "本報記者艾倫·瓊斯報道。"
  },
  {
    "index": 16,
    "text": "Karen Marsh arrived at London Airport today.",
    "start": 48.275,
    "end": 51.777,
    "zh": "卡伦·马什今天抵达伦敦机场。",
    "zh_hant": "卡倫·馬什今天抵達倫敦機場。"
  },
  {
    "index": 17,
    "text": "She was wearing a blue dress and a mink coat.",
    "start": 51.877,
    "end": 55.019,
    "zh": "她穿着一件蓝色连衣裙和一件貂皮大衣。",
    "zh_hant": "她穿著一件藍色連衣裙和一件貂皮大衣。"
  },
  {
    "index": 18,
    "text": "She told me she had just made a new film.",
    "start": 55.479,
    "end": 58.381,
    "zh": "她告诉我她刚拍完一部新电影。",
    "zh_hant": "她告訴我她剛拍完一部新電影。"
  },
  {
    "index": 19,
    "text": "she said she was not going to make another.",
    "start": 58.861,
    "end": 61.523,
    "zh": "她说她不打算再拍一部了。",
    "zh_hant": "她說她不打算再拍一部了。"
  },
  {
    "index": 20,
    "text": "She said she was going to retire.",
    "start": 61.783,
    "end": 64.124,
    "zh": "她说她要退休。",
    "zh_hant": "她說她要退休。"
  },
  {
    "index": 21,
    "text": "She told reporters",
    "start": 64.525,
    "end": 66.106,
    "zh": "她告诉记者们",
    "zh_hant": "她告訴記者們"
  },
  {
    "index": 22,
    "text": "she felt very tired and didn't want to make another film",
    "start": 65.756,
    "end": 69.508,
    "zh": "她感到非常疲惫，不想再拍电影",
    "zh_hant": "她感到非常疲憊，不想再拍電影"
  },
  {
    "index": 23,
    "text": "for a long time.'",
    "start": 69.158,
    "end": 70.949,
    "zh": "很长时间。",
    "zh_hant": "很長時間。"
  },
  {
    "index": 24,
    "text": "I wonder why!",
    "start": 71.729,
    "end": 73.09,
    "zh": "我想知道为什么！",
    "zh_hant": "我想知道為什麼！"
  }
]
