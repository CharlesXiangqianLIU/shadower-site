[
  {
    "index": 0,
    "text": "When will the writer see the play?",
    "start": 10.211,
    "end": 13.212,
    "zh": "作者什么时候会看这场戏？",
    "zh_hant": "作者什麼時候會看這場戲？"
  },
  {
    "index": 1,
    "text": "'The play may begin at any moment,' I said.",
    "start": 13.033,
    "end": 19.175,
    "zh": "“戏可能随时开始，”我说。",
    "zh_hant": "“戲可能隨時開始，”我說。"
  },
  {
    "index": 2,
    "text": "'It may have begun already,' Susan answered.",
    "start": 18.855,
    "end": 23.958,
    "zh": "“它可能已经开始了，”苏珊回答。",
    "zh_hant": "“它可能已經開始了，”蘇珊回答。"
  },
  {
    "index": 3,
    "text": "I hurried to the ticket office.",
    "start": 24.678,
    "end": 27.139,
    "zh": "我赶紧跑到售票处。",
    "zh_hant": "我趕緊跑到售票處。"
  },
  {
    "index": 4,
    "text": "'May I have two tickets please?'",
    "start": 26.859,
    "end": 30.701,
    "zh": "“请给我两张票，好吗？”",
    "zh_hant": "“請給我兩張票，好嗎？”"
  },
  {
    "index": 5,
    "text": "I asked.",
    "start": 30.961,
    "end": 31.982,
    "zh": "我问。",
    "zh_hant": "我問。"
  },
  {
    "index": 6,
    "text": "'I'm sorry, we've sold out,' the girl said.",
    "start": 31.642,
    "end": 36.584,
    "zh": "“对不起，票已经卖完了，”那个女孩说。",
    "zh_hant": "“對不起，票已經賣完了，”那個女孩說。"
  },
  {
    "index": 7,
    "text": "'What a pity!'",
    "start": 36.444,
    "end": 38.905,
    "zh": "“真遗憾！”",
    "zh_hant": "“真遺憾！”"
  },
  {
    "index": 8,
    "text": "Susan exclaimed.",
    "start": 39.225,
    "end": 40.906,
    "zh": "苏珊喊道。",
    "zh_hant": "蘇珊喊道。"
  },
  {
    "index": 9,
    "text": "Just then, a man hurried to the ticket office.",
    "start": 41.527,
    "end": 45.848,
    "zh": "就在这时，一个男人匆匆来到售票处。",
    "zh_hant": "就在這時，一個男人匆匆來到售票處。"
  },
  {
    "index": 10,
    "text": "'Can I return these two tickets?'",
    "start": 46.509,
    "end": 49.531,
    "zh": "“我能退这两张票吗？”",
    "zh_hant": "“我能退這兩張票嗎？”"
  },
  {
    "index": 11,
    "text": "he asked.",
    "start": 49.551,
    "end": 50.692,
    "zh": "他问。",
    "zh_hant": "他問。"
  },
  {
    "index": 12,
    "text": "'Certainly,' the girl said.",
    "start": 50.342,
    "end": 54.114,
    "zh": "“当然可以，”那个女孩说。",
    "zh_hant": "“當然可以，”那個女孩說。"
  },
  {
    "index": 13,
    "text": "I went back to the ticket office at once.",
    "start": 55.115,
    "end": 58.476,
    "zh": "我立刻回到售票处。",
    "zh_hant": "我立刻回到售票處。"
  },
  {
    "index": 14,
    "text": "'Could I have those two tickets please?'",
    "start": 58.297,
    "end": 62.959,
    "zh": "“请把那两张票给我，好吗？”",
    "zh_hant": "“請把那兩張票給我，好嗎？”"
  },
  {
    "index": 15,
    "text": "I asked.",
    "start": 63.24,
    "end": 64.28,
    "zh": "我问。",
    "zh_hant": "我問。"
  },
  {
    "index": 16,
    "text": "'Certainly,' the girl said,",
    "start": 64.1,
    "end": 68.042,
    "zh": "“当然可以，”那个女孩说，",
    "zh_hant": "“當然可以，”那個女孩說，"
  },
  {
    "index": 17,
    "text": "'but they're for next Wednesday's performance.",
    "start": 67.692,
    "end": 72.065,
    "zh": "“但是它们是下周三演出的票。",
    "zh_hant": "“但是它們是下週三演出的票。"
  },
  {
    "index": 18,
    "text": "Do you still want them?'",
    "start": 72.405,
    "end": 74.827,
    "zh": "你还要吗？”",
    "zh_hant": "你還要嗎？”"
  },
  {
    "index": 19,
    "text": "'I might as well have them,' I said sadly.",
    "start": 74.507,
    "end": 80.11,
    "zh": "“我还是把它们买了吧，”我伤心地说。",
    "zh_hant": "“我還是把它們買了吧，”我傷心地說。"
  }
]
