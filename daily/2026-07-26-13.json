[{"index": 0, "text": "Hello and welcome to Real Easy English.", "start": 0.0, "end": 3.351, "zh": "大家好,欢迎收听Real Easy English。", "zh_hant": "大家好,歡迎收聽Real Easy English。"}, {"index": 1, "text": "In this podcast,", "start": 3.131, "end": 4.611, "zh": "在这档播客节目中,", "zh_hant": "在這檔播客節目中,"}, {"index": 2, "text": "we have real conversations in easy English", "start": 4.472, "end": 8.033, "zh": "我们会用简单的英语进行真实对话,", "zh_hant": "我們會用簡單的英語進行真實對話,"}, {"index": 3, "text": "to help you learn.", "start": 7.873, "end": 9.153, "zh": "帮助你学习英语。", "zh_hant": "幫助你學習英語。"}, {"index": 4, "text": "I'm Neil.", "start": 9.293, "end": 10.093, "zh": "我是Neil。", "zh_hant": "我是Neil。"}, {"index": 5, "text": "And I'm Beth.", "start": 10.374, "end": 11.774, "zh": "我是Beth。", "zh_hant": "我是Beth。"}, {"index": 6, "text": "You can find a video version of this podcast", "start": 11.934, "end": 15.555, "zh": "你可以找到这档播客的视频版本,", "zh_hant": "你可以找到這檔播客的影片版本,"}, {"index": 7, "text": "and a free worksheet to help you learn", "start": 15.555, "end": 18.696, "zh": "还有一份免费的学习讲义,", "zh_hant": "還有一份免費的學習講義,"}, {"index": 8, "text": "on our website, bbclearningenglish.com.", "start": 18.396, "end": 22.137, "zh": "就在我们的网站bbclearningenglish.com上。", "zh_hant": "就在我們的網站bbclearningenglish.com上。"}, {"index": 9, "text": "Hi Beth.", "start": 28.099, "end": 29.12, "zh": "嗨,Beth。", "zh_hant": "嗨,Beth。"}, {"index": 10, "text": "How are you?", "start": 28.78, "end": 29.7, "zh": "你好吗?", "zh_hant": "你好嗎?"}, {"index": 11, "text": "I'm good, Neil.", "start": 29.64, "end": 30.88, "zh": "我很好,Neil。", "zh_hant": "我很好,Neil。"}, {"index": 12, "text": "How are you?", "start": 30.48, "end": 31.32, "zh": "你呢?", "zh_hant": "你呢?"}, {"index": 13, "text": "Very well, thank you.", "start": 31.26, "end": 32.661, "zh": "很好,谢谢。", "zh_hant": "很好,謝謝。"}, {"index": 14, "text": "What are we talking about today?", "start": 32.841, "end": 35.382, "zh": "我们今天要聊什么话题?", "zh_hant": "我們今天要聊什麼話題?"}, {"index": 15, "text": "we are talking about housemates.", "start": 35.622, "end": 39.383, "zh": "我们要聊的是室友。", "zh_hant": "我們要聊的是室友。"}, {"index": 16, "text": "the people", "start": 40.364, "end": 42.604, "zh": "也就是那些", "zh_hant": "也就是那些"}, {"index": 17, "text": "that you share a house with who aren't your family.", "start": 42.624, "end": 46.625, "zh": "和你同住一间房子、但不是你家人的人。", "zh_hant": "和你同住一間房子、但不是你家人的人。"}, {"index": 18, "text": "Maybe they're your friends, or even strangers", "start": 46.906, "end": 50.747, "zh": "他们可能是你的朋友,甚至是", "zh_hant": "他們可能是你的朋友,甚至是"}, {"index": 19, "text": "who just need somewhere to live.", "start": 50.567, "end": 52.607, "zh": "只是需要地方住的陌生人。", "zh_hant": "只是需要地方住的陌生人。"}, {"index": 20, "text": "Exactly.", "start": 52.468, "end": 53.608, "zh": "没错。", "zh_hant": "沒錯。"}, {"index": 21, "text": "And it's quite common", "start": 53.348, "end": 55.648, "zh": "在英国,", "zh_hant": "在英國,"}, {"index": 22, "text": "in the UK to live with housemates when you're younger.", "start": 55.408, "end": 59.449, "zh": "年轻时和室友一起住是很常见的。", "zh_hant": "年輕時和室友一起住是很常見的。"}, {"index": 23, "text": "Have you ever lived with housemates ?", "start": 60.43, "end": 63.531, "zh": "你有过室友吗?", "zh_hant": "你有過室友嗎?"}, {"index": 24, "text": "Yes, of course.", "start": 63.131, "end": 64.411, "zh": "当然有。", "zh_hant": "當然有。"}, {"index": 25, "text": "I had house or flatmates", "start": 64.011, "end": 67.132, "zh": "我有过室友或合租的舍友,", "zh_hant": "我有過室友或合租的舍友,"}, {"index": 26, "text": "when I was a student and then", "start": 67.332, "end": 70.153, "zh": "那是在我上学的时候,", "zh_hant": "那是在我上學的時候,"}, {"index": 27, "text": "after I was a student", "start": 69.853, "end": 72.354, "zh": "还有毕业之后", "zh_hant": "還有畢業之後"}, {"index": 28, "text": "in my first jobs and before I got married.", "start": 72.354, "end": 75.875, "zh": "刚工作那几年,以及结婚之前。", "zh_hant": "剛工作那幾年,以及結婚之前。"}, {"index": 29, "text": "That's exactly the same as me.", "start": 76.415, "end": 78.356, "zh": "我的情况和你一模一样。", "zh_hant": "我的情況和你一模一樣。"}, {"index": 30, "text": "So when I went to university,", "start": 78.896, "end": 81.297, "zh": "我上大学的时候,", "zh_hant": "我上大學的時候,"}, {"index": 31, "text": "I moved in with five people,", "start": 80.897, "end": 84.298, "zh": "搬进去和五个人一起住,", "zh_hant": "搬進去和五個人一起住,"}, {"index": 32, "text": "and we all had a separate room and a separate", "start": 84.318, "end": 88.379, "zh": "我们各自有独立的房间,还有各自的", "zh_hant": "我們各自有獨立的房間,還有各自的"}, {"index": 33, "text": "bathroom.", "start": 87.979, "end": 89.139, "zh": "卫生间。", "zh_hant": "衛生間。"}, {"index": 34, "text": "But yeah, they were my flatmates for my first year of university.", "start": 89.9, "end": 94.181, "zh": "没错,那是我大一时的舍友。", "zh_hant": "沒錯,那是我大一時的舍友。"}, {"index": 35, "text": "But in my second year,", "start": 93.781, "end": 96.082, "zh": "但到了大二,", "zh_hant": "但到了大二,"}, {"index": 36, "text": "then I moved into a house and we all shared a bathroom,", "start": 95.682, "end": 99.483, "zh": "我搬进了一栋房子,大家共用一个卫生间,", "zh_hant": "我搬進了一棟房子,大家共用一個衛生間,"}, {"index": 37, "text": "and they were my housemates because we were in a house.", "start": 99.163, "end": 102.624, "zh": "因为是住在一栋房子里,所以他们算是我的室友。", "zh_hant": "因為是住在一棟房子裡,所以他們算是我的室友。"}, {"index": 38, "text": "Did you enjoy having housemates?", "start": 103.064, "end": 106.465, "zh": "你喜欢有室友吗?", "zh_hant": "你喜歡有室友嗎?"}, {"index": 39, "text": "I think", "start": 106.065, "end": 108.826, "zh": "我觉得", "zh_hant": "我覺得"}, {"index": 40, "text": "it really depends on the people that you live with.", "start": 108.426, "end": 112.287, "zh": "这真的取决于和你一起住的人。", "zh_hant": "這真的取決於和你一起住的人。"}, {"index": 41, "text": "I have had some bad housemates.", "start": 111.887, "end": 115.548, "zh": "我遇到过一些不太好的室友。", "zh_hant": "我遇到過一些不太好的室友。"}, {"index": 42, "text": "Bad because they weren't tidy,", "start": 116.368, "end": 119.589, "zh": "说不好是因为他们不整洁,", "zh_hant": "說不好是因為他們不整潔,"}, {"index": 43, "text": "didn't clean.", "start": 119.65, "end": 121.05, "zh": "也不打扫卫生。", "zh_hant": "也不打掃衛生。"}, {"index": 44, "text": "There were dishes in the kitchen", "start": 121.13, "end": 124.311, "zh": "厨房里的碗碟", "zh_hant": "廚房裡的碗碟"}, {"index": 45, "text": "that were dirty and not cleaned for a long time.", "start": 123.911, "end": 127.172, "zh": "脏了很久也不洗。", "zh_hant": "髒了很久也不洗。"}, {"index": 46, "text": "But I've also had some really nice housemates", "start": 128.372, "end": 132.013, "zh": "不过我也遇到过一些真的很好的室友。", "zh_hant": "不過我也遇到過一些真的很好的室友。"}, {"index": 47, "text": "as well.", "start": 131.613, "end": 136.995, "zh": "也有过。", "zh_hant": "也有過。"}, {"index": 48, "text": "I think,", "start": 136.595, "end": 139.236, "zh": "我觉得,", "zh_hant": "我覺得,"}, {"index": 49, "text": "as you said, it really depends on the person,", "start": 139.196, "end": 143.097, "zh": "就像你说的,这真的取决于人,", "zh_hant": "就像你說的,這真的取決於人,"}, {"index": 50, "text": "so you mentioned people", "start": 143.537, "end": 146.218, "zh": "你提到了有人", "zh_hant": "你提到了有人"}, {"index": 51, "text": "being messy and that kind of thing.", "start": 145.818, "end": 148.539, "zh": "邋遢之类的问题。", "zh_hant": "邋遢之類的問題。"}, {"index": 52, "text": "Also, noisy people are difficult.", "start": 148.459, "end": 152.48, "zh": "还有,吵闹的人也很难相处。", "zh_hant": "還有,吵鬧的人也很難相處。"}, {"index": 53, "text": "But some of my best friends now", "start": 152.6, "end": 156.702, "zh": "不过我现在最好的一些朋友,", "zh_hant": "不過我現在最好的一些朋友,"}, {"index": 54, "text": "have been my housemates in the past.", "start": 157.022, "end": 160.163, "zh": "以前都是我的室友。", "zh_hant": "以前都是我的室友。"}, {"index": 55, "text": "So I think", "start": 160.023, "end": 161.683, "zh": "所以我觉得", "zh_hant": "所以我覺得"}, {"index": 56, "text": "you can really get to know people very well,", "start": 161.443, "end": 165.324, "zh": "和室友同住能让你真正了解一个人,", "zh_hant": "和室友同住能讓你真正瞭解一個人,"}, {"index": 57, "text": "and you can also meet some people", "start": 166.185, "end": 168.565, "zh": "但也可能遇到一些", "zh_hant": "但也可能遇到一些"}, {"index": 58, "text": "who you never want to see again in your life.", "start": 168.165, "end": 171.706, "zh": "你这辈子再也不想见的人。", "zh_hant": "你這輩子再也不想見的人。"}, {"index": 59, "text": "That's true.", "start": 171.386, "end": 172.307, "zh": "确实如此。", "zh_hant": "確實如此。"}, {"index": 60, "text": "So, Neil, what do you think is the best", "start": 172.607, "end": 176.708, "zh": "那么Neil,你觉得", "zh_hant": "那麼Neil,你覺得"}, {"index": 61, "text": "kind of personality,", "start": 176.328, "end": 178.569, "zh": "什么样的性格,", "zh_hant": "什麼樣的性格,"}, {"index": 62, "text": "the best kind of person to live with?", "start": 178.209, "end": 180.889, "zh": "什么样的人最适合一起住?", "zh_hant": "什麼樣的人最適合一起住?"}, {"index": 63, "text": "They have to be easy-going .", "start": 181.27, "end": 184.791, "zh": "他们必须随和好相处。", "zh_hant": "他們必須隨和好相處。"}, {"index": 64, "text": "What does that mean?", "start": 184.391, "end": 185.531, "zh": "这是什么意思?", "zh_hant": "這是什麼意思?"}, {"index": 65, "text": "Somebody who is easy-going is relaxed,", "start": 185.691, "end": 189.752, "zh": "随和的人比较放松,", "zh_hant": "隨和的人比較放鬆,"}, {"index": 66, "text": "and they don't get too upset", "start": 189.733, "end": 192.433, "zh": "不会因为一点小事", "zh_hant": "不會因為一點小事"}, {"index": 67, "text": "or angry over little things.", "start": 192.313, "end": 195.294, "zh": "就生气或不高兴。", "zh_hant": "就生氣或不高興。"}, {"index": 68, "text": "And they're quite easy", "start": 196.015, "end": 199.976, "zh": "他们相处起来也", "zh_hant": "他們相處起來也"}, {"index": 69, "text": "to live with,", "start": 199.776, "end": 200.856, "zh": "比较容易,", "zh_hant": "比較容易,"}, {"index": 70, "text": "snd there's the clue – easy-going .", "start": 200.456, "end": 202.977, "zh": "这就是重点——随和好相处。", "zh_hant": "這就是重點——隨和好相處。"}, {"index": 71, "text": "I think something else important", "start": 202.577, "end": 205.218, "zh": "我觉得还有一件重要的事,", "zh_hant": "我覺得還有一件重要的事,"}, {"index": 72, "text": "about living with other people", "start": 204.918, "end": 208.339, "zh": "就是和别人同住,", "zh_hant": "就是和別人同住,"}, {"index": 73, "text": "or renting somewhere, so paying monthly,", "start": 207.939, "end": 211.84, "zh": "或者说租房、按月付房租的时候,", "zh_hant": "或者說租房、按月付房租的時候,"}, {"index": 74, "text": "is having a good landlord.", "start": 212.18, "end": 214.461, "zh": "有一个好房东也很重要。", "zh_hant": "有一個好房東也很重要。"}, {"index": 75, "text": "It's very important.", "start": 214.061, "end": 216.261, "zh": "这非常重要。", "zh_hant": "這非常重要。"}, {"index": 76, "text": "So who is a landlord?", "start": 215.961, "end": 217.822, "zh": "那么房东是谁呢?", "zh_hant": "那麼房東是誰呢?"}, {"index": 77, "text": "What is a landlord?", "start": 217.662, "end": 219.102, "zh": "房东是什么意思?", "zh_hant": "房東是什麼意思?"}, {"index": 78, "text": "So the landlord is, or landlady,", "start": 218.862, "end": 221.943, "zh": "房东,或者说女房东,", "zh_hant": "房東,或者說女房東,"}, {"index": 79, "text": "is the person that owns the house or flat", "start": 221.963, "end": 225.864, "zh": "就是拥有你所住的房子或公寓的人,", "zh_hant": "就是擁有你所住的房子或公寓的人,"}, {"index": 80, "text": "that you're in and you pay them rent.", "start": 225.744, "end": 228.585, "zh": "你要付房租给他们。", "zh_hant": "你要付房租給他們。"}, {"index": 81, "text": "So you pay them a monthly amount.", "start": 228.365, "end": 231.266, "zh": "也就是每个月付一定的金额。", "zh_hant": "也就是每個月付一定的金額。"}, {"index": 82, "text": "But you might live there", "start": 230.966, "end": 233.007, "zh": "你可能会在那里住", "zh_hant": "你可能會在那裡住"}, {"index": 83, "text": "for a year or two years or three years,", "start": 232.607, "end": 236.788, "zh": "一年、两年或三年,", "zh_hant": "一年、兩年或三年,"}, {"index": 84, "text": "but you don't own the place.", "start": 236.388, "end": 238.528, "zh": "但你并不拥有那个地方。", "zh_hant": "但你並不擁有那個地方。"}, {"index": 85, "text": "It's the landlord that owns the place.", "start": 238.128, "end": 240.689, "zh": "是房东拥有那个地方。", "zh_hant": "是房東擁有那個地方。"}, {"index": 86, "text": "Yeah, and a good landlord can make a big difference.", "start": 240.509, "end": 244.43, "zh": "没错,一个好房东真的能带来很大不同。", "zh_hant": "沒錯,一個好房東真的能帶來很大不同。"}, {"index": 87, "text": "Neil, are you easy to live with?", "start": 244.41, "end": 246.891, "zh": "Neil,你好相处吗?", "zh_hant": "Neil,你好相處嗎?"}, {"index": 88, "text": "Should we be flatmates ?", "start": 248.092, "end": 250.212, "zh": "我们要不要当室友?", "zh_hant": "我們要不要當室友?"}, {"index": 89, "text": "I don't know,", "start": 249.812, "end": 251.493, "zh": "我不知道,", "zh_hant": "我不知道,"}, {"index": 90, "text": "but I think", "start": 252.433, "end": 253.934, "zh": "不过我觉得", "zh_hant": "不過我覺得"}, {"index": 91, "text": "I have made some good friends", "start": 253.534, "end": 257.815, "zh": "我在当室友的时候", "zh_hant": "我在當室友的時候"}, {"index": 92, "text": "when I've been a housemate.", "start": 258.275, "end": 261.036, "zh": "交到了一些不错的朋友。", "zh_hant": "交到了一些不錯的朋友。"}, {"index": 93, "text": "So they think that I was a good housemate.", "start": 260.736, "end": 264.237, "zh": "所以他们应该觉得我是个不错的室友。", "zh_hant": "所以他們應該覺得我是個不錯的室友。"}, {"index": 94, "text": "OK.", "start": 263.897, "end": 264.497, "zh": "好的。", "zh_hant": "好的。"}, {"index": 95, "text": "How about you?", "start": 264.637, "end": 265.637, "zh": "那你呢?", "zh_hant": "那你呢?"}, {"index": 96, "text": "Yeah, I think I'm easy to live with, but I like to sing a lot,", "start": 266.138, "end": 270.359, "zh": "嗯,我觉得我挺好相处的,不过我很喜欢唱歌,", "zh_hant": "嗯,我覺得我挺好相處的,不過我很喜歡唱歌,"}, {"index": 97, "text": "so maybe people would tell me to be quiet.", "start": 270.079, "end": 274.22, "zh": "所以可能有人会让我安静点。", "zh_hant": "所以可能有人會讓我安靜點。"}, {"index": 98, "text": "Although no one's ever told me to be quiet,", "start": 274.24, "end": 276.441, "zh": "虽然从来没人真的让我安静过,", "zh_hant": "雖然從來沒人真的讓我安靜過,"}, {"index": 99, "text": "but maybe they wanted me to and just didn't say.", "start": 276.041, "end": 279.462, "zh": "但也许他们其实想说,只是没说出口。", "zh_hant": "但也許他們其實想說,只是沒說出口。"}, {"index": 100, "text": "Let's recap the vocabulary we've heard in this podcast,", "start": 285.864, "end": 289.785, "zh": "我们来回顾一下这期节目中学到的词汇,", "zh_hant": "我們來回顧一下這期節目中學到的詞彙,"}, {"index": 101, "text": "starting with housemate.", "start": 289.765, "end": 292.286, "zh": "先从housemate(室友)开始。", "zh_hant": "先從housemate(室友)開始。"}, {"index": 102, "text": "A housemate is someone", "start": 291.886, "end": 294.427, "zh": "housemate指的是", "zh_hant": "housemate指的是"}, {"index": 103, "text": "you live with who probably isn't", "start": 294.087, "end": 297.428, "zh": "和你同住、但很可能", "zh_hant": "和你同住、但很可能"}, {"index": 104, "text": "part of your family.", "start": 297.368, "end": 298.948, "zh": "不是你家人的人。", "zh_hant": "不是你家人的人。"}, {"index": 105, "text": "We also hear flatmate.", "start": 299.329, "end": 301.249, "zh": "我们还听到了flatmate(合租舍友)。", "zh_hant": "我們還聽到了flatmate(合租舍友)。"}, {"index": 106, "text": "And we had easy-going", "start": 301.909, "end": 304.19, "zh": "还有easy-going,", "zh_hant": "還有easy-going,"}, {"index": 107, "text": "which means relaxed and not easily", "start": 304.07, "end": 307.031, "zh": "意思是随和、不容易", "zh_hant": "意思是隨和、不容易"}, {"index": 108, "text": "upset.", "start": 306.631, "end": 311.292, "zh": "生气。", "zh_hant": "生氣。"}, {"index": 109, "text": "And the person", "start": 312.333, "end": 316.394, "zh": "还有那个", "zh_hant": "還有那個"}, {"index": 110, "text": "who owns", "start": 315.994, "end": 319.875, "zh": "拥有", "zh_hant": "擁有"}, {"index": 111, "text": "the house or flat", "start": 319.475, "end": 321.096, "zh": "这栋房子或公寓的人,", "zh_hant": "這棟房子或公寓的人,"}, {"index": 112, "text": "is the landlord.", "start": 321.116, "end": 322.696, "zh": "就叫landlord(房东)。", "zh_hant": "就叫landlord(房東)。"}, {"index": 113, "text": "That's who you pay every month and they own the property.", "start": 322.616, "end": 326.277, "zh": "你每个月付钱给他,他拥有这处房产。", "zh_hant": "你每個月付錢給他,他擁有這處房產。"}, {"index": 114, "text": "That's it for this episode of Real Easy English.", "start": 326.918, "end": 330.319, "zh": "这期Real Easy English节目就到这里。", "zh_hant": "這期Real Easy English節目就到這裡。"}, {"index": 115, "text": "To test what you've learnt,", "start": 330.039, "end": 331.92, "zh": "想测试一下自己学到了多少,", "zh_hant": "想測試一下自己學到了多少,"}, {"index": 116, "text": "there's a worksheet on our website,", "start": 331.541, "end": 334.062, "zh": "可以去我们网站上的讲义,", "zh_hant": "可以去我們網站上的講義,"}, {"index": 117, "text": "bbclearningenglish.com.", "start": 333.682, "end": 336.264, "zh": "bbclearningenglish.com。", "zh_hant": "bbclearningenglish.com。"}, {"index": 118, "text": "And we'll be back next week with another", "start": 336.164, "end": 338.946, "zh": "我们下周会带来另一期", "zh_hant": "我們下週會帶來另一期"}, {"index": 119, "text": "easy English conversation.", "start": 338.747, "end": 340.928, "zh": "简单英语对话节目。", "zh_hant": "簡單英語對話節目。"}, {"index": 120, "text": "Bye for now.", "start": 340.788, "end": 341.789, "zh": "再见啦。", "zh_hant": "再見啦。"}, {"index": 121, "text": "Goodbye.", "start": 341.509, "end": 342.349, "zh": "再见。", "zh_hant": "再見。"}]