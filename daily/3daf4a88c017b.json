[
  {
    "index": 0,
    "text": "Lesson 41 Penny's bag",
    "start": 1.51,
    "end": 5.532,
    "zh": "第41课 彭妮的袋子",
    "zh_hant": "第41課 彭妮的袋子"
  },
  {
    "index": 1,
    "text": "Listen to the tape then answer this question.",
    "start": 6.953,
    "end": 11.115,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 2,
    "text": "Who is the tin of tobacco for?",
    "start": 13.216,
    "end": 16.198,
    "zh": "那罐烟草是给谁的？",
    "zh_hant": "那罐菸草是給誰的？"
  },
  {
    "index": 3,
    "text": "Is that bag heavy, Penny?",
    "start": 18.599,
    "end": 20.7,
    "zh": "彭妮，那个袋子重吗？",
    "zh_hant": "彭妮，那個袋子重嗎？"
  },
  {
    "index": 4,
    "text": "Not very.",
    "start": 21.06,
    "end": 22.081,
    "zh": "不太重。",
    "zh_hant": "不太重。"
  },
  {
    "index": 5,
    "text": "Here!",
    "start": 22.821,
    "end": 23.641,
    "zh": "给！",
    "zh_hant": "給！"
  },
  {
    "index": 6,
    "text": "Put it on this chair.",
    "start": 24.002,
    "end": 25.742,
    "zh": "把它放在这把椅子上。",
    "zh_hant": "把它放在這把椅子上。"
  },
  {
    "index": 7,
    "text": "What's in it?",
    "start": 26.503,
    "end": 27.563,
    "zh": "里面有什么？",
    "zh_hant": "裡面有什麼？"
  },
  {
    "index": 8,
    "text": "A piece of cheese.",
    "start": 28.224,
    "end": 29.824,
    "zh": "一块奶酪。",
    "zh_hant": "一塊乳酪。"
  },
  {
    "index": 9,
    "text": "A loaf of bread.",
    "start": 30.645,
    "end": 32.166,
    "zh": "一条面包。",
    "zh_hant": "一條麵包。"
  },
  {
    "index": 10,
    "text": "A bar of soap.",
    "start": 32.746,
    "end": 34.147,
    "zh": "一块肥皂。",
    "zh_hant": "一塊肥皂。"
  },
  {
    "index": 11,
    "text": "A bar of chocolate.",
    "start": 34.727,
    "end": 36.388,
    "zh": "一块巧克力。",
    "zh_hant": "一塊巧克力。"
  },
  {
    "index": 12,
    "text": "A bottle of milk.",
    "start": 36.988,
    "end": 38.389,
    "zh": "一瓶牛奶。",
    "zh_hant": "一瓶牛奶。"
  },
  {
    "index": 13,
    "text": "A pound of sugar.",
    "start": 39.229,
    "end": 40.67,
    "zh": "一磅糖。",
    "zh_hant": "一磅糖。"
  },
  {
    "index": 14,
    "text": "Half a pound of coffee.",
    "start": 41.871,
    "end": 43.573,
    "zh": "半磅咖啡。",
    "zh_hant": "半磅咖啡。"
  },
  {
    "index": 15,
    "text": "A quarter of a pound of tea.",
    "start": 44.775,
    "end": 46.778,
    "zh": "四分之一磅茶叶。",
    "zh_hant": "四分之一磅茶葉。"
  },
  {
    "index": 16,
    "text": "And a tin of tobacco.",
    "start": 47.439,
    "end": 49.041,
    "zh": "还有一罐烟草。",
    "zh_hant": "還有一罐菸草。"
  },
  {
    "index": 17,
    "text": "Is that tin of tobacco for me?",
    "start": 50.223,
    "end": 52.646,
    "zh": "那罐烟草是给我的吗？",
    "zh_hant": "那罐菸草是給我的嗎？"
  },
  {
    "index": 18,
    "text": "Well, it's certainly not for me!",
    "start": 52.747,
    "end": 54.809,
    "zh": "嗯，肯定不是给我的！",
    "zh_hant": "嗯，肯定不是給我的！"
  }
]
