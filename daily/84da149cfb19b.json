[
  {
    "index": 0,
    "text": "When will the writer see the play?",
    "start": 13.991,
    "end": 17.012,
    "zh": "作者什么时候会看这场戏？",
    "zh_hant": "作者什麼時候會看這場戲？"
  },
  {
    "index": 1,
    "text": "'The play may begin at any moment,'",
    "start": 16.662,
    "end": 22.595,
    "zh": "“戏可能随时开始，”",
    "zh_hant": "“戲可能隨時開始，”"
  },
  {
    "index": 2,
    "text": "I said.",
    "start": 22.655,
    "end": 23.575,
    "zh": "我说。",
    "zh_hant": "我說。"
  },
  {
    "index": 3,
    "text": "'It may have begun already,' Susan answered.",
    "start": 23.876,
    "end": 29.438,
    "zh": "“它可能已经开始了，”苏珊回答。",
    "zh_hant": "“它可能已經開始了，”蘇珊回答。"
  },
  {
    "index": 4,
    "text": "I hurried to the ticket office.",
    "start": 30.779,
    "end": 33.1,
    "zh": "我赶紧跑到售票处。",
    "zh_hant": "我趕緊跑到售票處。"
  },
  {
    "index": 5,
    "text": "'May I have two tickets please?'",
    "start": 33.32,
    "end": 36.542,
    "zh": "“我可以买两张票吗？”",
    "zh_hant": "“我可以買兩張票嗎？”"
  },
  {
    "index": 6,
    "text": "I asked.",
    "start": 36.642,
    "end": 37.742,
    "zh": "我问。",
    "zh_hant": "我問。"
  },
  {
    "index": 7,
    "text": "'I'm sorry, we've sold out,' the girl said.",
    "start": 37.982,
    "end": 43.825,
    "zh": "“对不起，我们卖光了，”那女孩说。",
    "zh_hant": "“對不起，我們賣光了，”那女孩說。"
  },
  {
    "index": 8,
    "text": "'What a pity!'",
    "start": 44.826,
    "end": 46.386,
    "zh": "“真可惜！”",
    "zh_hant": "“真可惜！”"
  },
  {
    "index": 9,
    "text": "Susan exclaimed.",
    "start": 46.467,
    "end": 48.187,
    "zh": "苏珊喊道。",
    "zh_hant": "蘇珊喊道。"
  },
  {
    "index": 10,
    "text": "Just then, a man hurried to the ticket office.",
    "start": 49.108,
    "end": 52.78,
    "zh": "就在这时，一个男人匆忙赶到售票处。",
    "zh_hant": "就在這時，一個男人匆忙趕到售票處。"
  },
  {
    "index": 11,
    "text": "'Can I return these two tickets?'",
    "start": 52.38,
    "end": 57.753,
    "zh": "“我能退这两张票吗？”",
    "zh_hant": "“我能退這兩張票嗎？”"
  },
  {
    "index": 12,
    "text": "he asked.",
    "start": 57.753,
    "end": 59.014,
    "zh": "他问。",
    "zh_hant": "他問。"
  },
  {
    "index": 13,
    "text": "'Certainly,' the girl said.",
    "start": 58.674,
    "end": 62.856,
    "zh": "“当然可以，”那女孩说。",
    "zh_hant": "“當然可以，”那女孩說。"
  },
  {
    "index": 14,
    "text": "I went back to the ticket office at once.",
    "start": 64.237,
    "end": 67.438,
    "zh": "我立刻回到售票处。",
    "zh_hant": "我立刻回到售票處。"
  },
  {
    "index": 15,
    "text": "'Could I have those two tickets please?'",
    "start": 67.088,
    "end": 71.861,
    "zh": "“我能买那两张票吗？”",
    "zh_hant": "“我能買那兩張票嗎？”"
  },
  {
    "index": 16,
    "text": "I asked.",
    "start": 71.741,
    "end": 72.881,
    "zh": "我问。",
    "zh_hant": "我問。"
  },
  {
    "index": 17,
    "text": "'Certainly,' the girl said, 'but they're for next Wednesday's performance.",
    "start": 73.502,
    "end": 79.585,
    "zh": "“当然可以，”那女孩说，“但这是下周三的演出。",
    "zh_hant": "“當然可以，”那女孩說，“但這是下週三的演出。"
  },
  {
    "index": 18,
    "text": "Do you still want them?'",
    "start": 79.906,
    "end": 82.447,
    "zh": "你们还要吗？”",
    "zh_hant": "你們還要嗎？”"
  },
  {
    "index": 19,
    "text": "'I might as well have them,' I said sadly.",
    "start": 82.097,
    "end": 88.09,
    "zh": "“我还是买了吧，”我伤心地说。",
    "zh_hant": "“我還是買了吧，”我傷心地說。"
  }
]
