[
  {
    "index": 0,
    "text": "Why did the writer complain to the people behind him?",
    "start": 12.87,
    "end": 18.213,
    "zh": "作者为什么向坐在他后面的人抱怨？",
    "zh_hant": "作者為什麼向坐在他後面的人抱怨？"
  },
  {
    "index": 1,
    "text": "Last week I went to the theatre.",
    "start": 20.554,
    "end": 23.435,
    "zh": "上周我去看戏了。",
    "zh_hant": "上週我去看戲了。"
  },
  {
    "index": 2,
    "text": "I had a very good seat.",
    "start": 24.176,
    "end": 26.097,
    "zh": "我坐的位子很好。",
    "zh_hant": "我坐的位子很好。"
  },
  {
    "index": 3,
    "text": "The play was very interesting.",
    "start": 27.398,
    "end": 29.839,
    "zh": "那出戏很有趣。",
    "zh_hant": "那出戏很有趣。"
  },
  {
    "index": 4,
    "text": "I did not enjoy it.",
    "start": 30.839,
    "end": 32.62,
    "zh": "我却没看进去。",
    "zh_hant": "我卻沒看進去。"
  },
  {
    "index": 5,
    "text": "A young man and a young woman were sitting behind me.",
    "start": 33.461,
    "end": 37.622,
    "zh": "一个年轻男人和一个年轻女人坐在我后面。",
    "zh_hant": "一個年輕男人和一個年輕女人坐在我後面。"
  },
  {
    "index": 6,
    "text": "They were talking loudly.",
    "start": 38.143,
    "end": 40.404,
    "zh": "他们大声说话。",
    "zh_hant": "他們大聲說話。"
  },
  {
    "index": 7,
    "text": "I got very angry.",
    "start": 40.784,
    "end": 42.605,
    "zh": "我变得很生气。",
    "zh_hant": "我變得很生氣。"
  },
  {
    "index": 8,
    "text": "I could not hear the actors.",
    "start": 43.466,
    "end": 45.867,
    "zh": "我听不见演员的声音。",
    "zh_hant": "我聽不見演員的聲音。"
  },
  {
    "index": 9,
    "text": "I turned round.",
    "start": 46.587,
    "end": 48.268,
    "zh": "我转过身。",
    "zh_hant": "我轉過身。"
  },
  {
    "index": 10,
    "text": "I looked at the man and the woman angrily.",
    "start": 49.148,
    "end": 52.43,
    "zh": "我生气地看着那个男人和那个女人。",
    "zh_hant": "我生氣地看著那個男人和那個女人。"
  },
  {
    "index": 11,
    "text": "They did not pay any attention.",
    "start": 53.44,
    "end": 55.761,
    "zh": "他们没在意。",
    "zh_hant": "他們沒在意。"
  },
  {
    "index": 12,
    "text": "In the end, I could not bear it.",
    "start": 56.442,
    "end": 59.663,
    "zh": "到最后，我忍无可忍。",
    "zh_hant": "到最後，我忍無可忍。"
  },
  {
    "index": 13,
    "text": "I turned round again.",
    "start": 59.783,
    "end": 61.484,
    "zh": "我又转过身。",
    "zh_hant": "我又轉過身。"
  },
  {
    "index": 14,
    "text": "'I can't hear a word!'",
    "start": 61.624,
    "end": 64.986,
    "zh": "“我一个字都听不见！”",
    "zh_hant": "“我一個字都聽不見！”"
  },
  {
    "index": 15,
    "text": "I said angrily.",
    "start": 65.286,
    "end": 66.626,
    "zh": "我生气地说。",
    "zh_hant": "我生氣地說。"
  },
  {
    "index": 16,
    "text": "'It's none of your business,' the young man said rudely.",
    "start": 66.407,
    "end": 71.569,
    "zh": "“这不关你的事，”那个年轻男人粗鲁地说。",
    "zh_hant": "“這不關你的事，”那個年輕男人粗魯地說。"
  },
  {
    "index": 17,
    "text": "'This is a private conversation!'",
    "start": 71.389,
    "end": 74.19,
    "zh": "“这是私人谈话！”",
    "zh_hant": "“這是私人談話！”"
  }
]
