[
  {
    "index": 0,
    "text": "Lesson 45.",
    "start": 1.571,
    "end": 3.802,
    "zh": "第45课。",
    "zh_hant": "第45課。"
  },
  {
    "index": 1,
    "text": "The boss's letter.",
    "start": 3.852,
    "end": 5.672,
    "zh": "老板的信。",
    "zh_hant": "老闆的信。"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 6.973,
    "end": 10.875,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "Why can't Pamela type the letter?",
    "start": 13.076,
    "end": 16.197,
    "zh": "为什么帕梅拉不能打这封信？",
    "zh_hant": "為什麼帕梅拉不能打這封信？"
  },
  {
    "index": 4,
    "text": "Can you come here a minute please, Bob?",
    "start": 18.699,
    "end": 21.44,
    "zh": "鲍勃，你能过来一下吗？",
    "zh_hant": "鮑勃，你能過來一下嗎？"
  },
  {
    "index": 5,
    "text": "Yes, sir?",
    "start": 22.201,
    "end": 23.061,
    "zh": "什么事，先生？",
    "zh_hant": "什麼事，先生？"
  },
  {
    "index": 6,
    "text": "Where's Pamela?",
    "start": 24.322,
    "end": 25.822,
    "zh": "帕梅拉在哪儿？",
    "zh_hant": "帕梅拉在哪兒？"
  },
  {
    "index": 7,
    "text": "She's next door.",
    "start": 26.803,
    "end": 28.083,
    "zh": "她在隔壁。",
    "zh_hant": "她在隔壁。"
  },
  {
    "index": 8,
    "text": "She's in her office, sir.",
    "start": 28.464,
    "end": 30.324,
    "zh": "她在她的办公室，先生。",
    "zh_hant": "她在她的辦公室，先生。"
  },
  {
    "index": 9,
    "text": "Can she type this letter for me?",
    "start": 32.065,
    "end": 34.446,
    "zh": "她能帮我打这封信吗？",
    "zh_hant": "她能幫我打這封信嗎？"
  },
  {
    "index": 10,
    "text": "Ask her please.",
    "start": 35.187,
    "end": 36.507,
    "zh": "请叫她一下。",
    "zh_hant": "請叫她一下。"
  },
  {
    "index": 11,
    "text": "Yes, sir.",
    "start": 37.428,
    "end": 38.368,
    "zh": "好的，先生。",
    "zh_hant": "好的，先生。"
  },
  {
    "index": 12,
    "text": "Can you type this letter for the boss please, Pamela?",
    "start": 40.269,
    "end": 43.592,
    "zh": "帕梅拉，你能帮老板打这封信吗？",
    "zh_hant": "帕梅拉，你能幫老闆打這封信嗎？"
  },
  {
    "index": 13,
    "text": "Yes, of course I can.",
    "start": 43.993,
    "end": 45.914,
    "zh": "是的，我当然能。",
    "zh_hant": "是的，我當然能。"
  },
  {
    "index": 14,
    "text": "Here you are.",
    "start": 46.635,
    "end": 47.836,
    "zh": "给你。",
    "zh_hant": "給你。"
  },
  {
    "index": 15,
    "text": "Thank you, Bob.",
    "start": 48.537,
    "end": 49.757,
    "zh": "谢谢你，鲍勃。",
    "zh_hant": "謝謝你，鮑勃。"
  },
  {
    "index": 16,
    "text": "Bob!",
    "start": 51.539,
    "end": 52.44,
    "zh": "鲍勃！",
    "zh_hant": "鮑勃！"
  },
  {
    "index": 17,
    "text": "Yes?",
    "start": 52.7,
    "end": 53.521,
    "zh": "什么事？",
    "zh_hant": "什麼事？"
  },
  {
    "index": 18,
    "text": "What's the matter?",
    "start": 53.941,
    "end": 55.242,
    "zh": "怎么了？",
    "zh_hant": "怎麼了？"
  },
  {
    "index": 19,
    "text": "I can't type this letter.",
    "start": 56.383,
    "end": 58.405,
    "zh": "我打不了这封信。",
    "zh_hant": "我打不了這封信。"
  },
  {
    "index": 20,
    "text": "I can't read it!",
    "start": 58.886,
    "end": 60.226,
    "zh": "我读不懂它！",
    "zh_hant": "我讀不懂它！"
  },
  {
    "index": 21,
    "text": "The boss's handwriting is terrible!",
    "start": 61.107,
    "end": 64.61,
    "zh": "老板的字迹太潦草了！",
    "zh_hant": "老闆的字跡太潦草了！"
  }
]
