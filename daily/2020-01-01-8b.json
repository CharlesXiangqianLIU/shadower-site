[
  {
    "index": 0,
    "text": "Lesson 15 Your passports",
    "start": 0.53,
    "end": 4.672,
    "zh": "第15课 你们的护照",
    "zh_hant": "第15課 你們的護照"
  },
  {
    "index": 1,
    "text": "please.",
    "start": 4.322,
    "end": 5.333,
    "zh": "请。",
    "zh_hant": "請。"
  },
  {
    "index": 2,
    "text": "Listen to the tape then",
    "start": 6.353,
    "end": 9.355,
    "zh": "听录音，然后",
    "zh_hant": "聽錄音，然後"
  },
  {
    "index": 3,
    "text": "answer this question.",
    "start": 9.155,
    "end": 11.055,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 4,
    "text": "Is there a problem with the Customs officer?",
    "start": 12.256,
    "end": 16.198,
    "zh": "海关官员有什么问题吗？",
    "zh_hant": "海關官員有什麼問題嗎？"
  },
  {
    "index": 5,
    "text": "Are you Swedish?",
    "start": 18.8,
    "end": 20.66,
    "zh": "你们是瑞典人吗？",
    "zh_hant": "你們是瑞典人嗎？"
  },
  {
    "index": 6,
    "text": "No we are not.",
    "start": 21.361,
    "end": 23.782,
    "zh": "不，我们不是。",
    "zh_hant": "不，我們不是。"
  },
  {
    "index": 7,
    "text": "We are Danish.",
    "start": 23.942,
    "end": 25.683,
    "zh": "我们是丹麦人。",
    "zh_hant": "我們是丹麥人。"
  },
  {
    "index": 8,
    "text": "Are your friends Danish too?",
    "start": 26.604,
    "end": 29.465,
    "zh": "你们的朋友也是丹麦人吗？",
    "zh_hant": "你們的朋友也是丹麥人嗎？"
  },
  {
    "index": 9,
    "text": "No they aren't.",
    "start": 30.225,
    "end": 32.726,
    "zh": "不，他们不是。",
    "zh_hant": "不，他們不是。"
  },
  {
    "index": 10,
    "text": "They are Norwegian.",
    "start": 33.747,
    "end": 36.028,
    "zh": "他们是挪威人。",
    "zh_hant": "他們是挪威人。"
  },
  {
    "index": 11,
    "text": "Your passports please.",
    "start": 37.449,
    "end": 39.83,
    "zh": "请出示你们的护照。",
    "zh_hant": "請出示你們的護照。"
  },
  {
    "index": 12,
    "text": "Here they are.",
    "start": 40.471,
    "end": 43.792,
    "zh": "给你。",
    "zh_hant": "給你。"
  },
  {
    "index": 13,
    "text": "these your cases?",
    "start": 43.442,
    "end": 45.293,
    "zh": "这些是你们的箱子吗？",
    "zh_hant": "這些是你們的箱子嗎？"
  },
  {
    "index": 14,
    "text": "No they aren't.",
    "start": 46.034,
    "end": 47.895,
    "zh": "不，不是的。",
    "zh_hant": "不，不是的。"
  },
  {
    "index": 15,
    "text": "Our cases are brown.",
    "start": 48.896,
    "end": 51.477,
    "zh": "我们的箱子是棕色的。",
    "zh_hant": "我們的箱子是棕色的。"
  },
  {
    "index": 16,
    "text": "Here they are.",
    "start": 52.938,
    "end": 56.76,
    "zh": "在这儿呢。",
    "zh_hant": "在這兒呢。"
  },
  {
    "index": 17,
    "text": "you tourists?",
    "start": 56.41,
    "end": 57.981,
    "zh": "你们是游客吗？",
    "zh_hant": "你們是遊客嗎？"
  },
  {
    "index": 18,
    "text": "Yes we are.",
    "start": 58.842,
    "end": 62.524,
    "zh": "是的，我们是。",
    "zh_hant": "是的，我們是。"
  },
  {
    "index": 19,
    "text": "your friends tourists too?",
    "start": 62.174,
    "end": 64.845,
    "zh": "你们的朋友也是游客吗？",
    "zh_hant": "你們的朋友也是遊客嗎？"
  },
  {
    "index": 20,
    "text": "Yes they are.",
    "start": 65.406,
    "end": 67.367,
    "zh": "是的，他们是。",
    "zh_hant": "是的，他們是。"
  },
  {
    "index": 21,
    "text": "That's fine.",
    "start": 68.648,
    "end": 70.048,
    "zh": "那很好。",
    "zh_hant": "那很好。"
  },
  {
    "index": 22,
    "text": "Thank you very much.",
    "start": 70.649,
    "end": 72.75,
    "zh": "非常感谢。",
    "zh_hant": "非常感謝。"
  }
]
