[
  {
    "index": 0,
    "text": "Lesson 115 Knock,",
    "start": 0.61,
    "end": 5.052,
    "zh": "第115课 敲门",
    "zh_hant": "第115課 敲門"
  },
  {
    "index": 1,
    "text": "Listen to the tape then",
    "start": 6.994,
    "end": 9.895,
    "zh": "听录音，然后",
    "zh_hant": "聽錄音，然後"
  },
  {
    "index": 2,
    "text": "answer this question.",
    "start": 9.695,
    "end": 11.616,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 3,
    "text": "What does Jim have to drink?",
    "start": 12.757,
    "end": 15.818,
    "zh": "吉姆要喝什么？",
    "zh_hant": "吉姆要喝什麼？"
  },
  {
    "index": 4,
    "text": "Isn't there anyone at home?",
    "start": 18.019,
    "end": 20.76,
    "zh": "家里难道没人吗？",
    "zh_hant": "家裡難道沒人嗎？"
  },
  {
    "index": 5,
    "text": "I'll knock again, Helen.",
    "start": 21.681,
    "end": 23.882,
    "zh": "我再敲一次门，海伦。",
    "zh_hant": "我再敲一次門，海倫。"
  },
  {
    "index": 6,
    "text": "Everything's very quiet.",
    "start": 24.562,
    "end": 27.023,
    "zh": "一切都很安静。",
    "zh_hant": "一切都很安靜。"
  },
  {
    "index": 7,
    "text": "I'm sure there's no one at home.",
    "start": 27.724,
    "end": 30.785,
    "zh": "我确信家里没人。",
    "zh_hant": "我確信家裡沒人。"
  },
  {
    "index": 8,
    "text": "But that's impossible.",
    "start": 30.806,
    "end": 33.167,
    "zh": "但那不可能。",
    "zh_hant": "但那不可能。"
  },
  {
    "index": 9,
    "text": "Carol and Tom invited us to lunch.",
    "start": 33.547,
    "end": 37.469,
    "zh": "卡罗尔和汤姆邀请我们吃午饭。",
    "zh_hant": "卡羅爾和湯姆邀請我們吃午飯。"
  },
  {
    "index": 10,
    "text": "Look through the window.",
    "start": 37.749,
    "end": 39.67,
    "zh": "透过窗户看看。",
    "zh_hant": "透過窗戶看看。"
  },
  {
    "index": 11,
    "text": "Can you see anything?",
    "start": 40.631,
    "end": 42.711,
    "zh": "你能看到什么吗？",
    "zh_hant": "你能看到什麼嗎？"
  },
  {
    "index": 12,
    "text": "Nothing at all.",
    "start": 43.692,
    "end": 45.293,
    "zh": "什么都看不到。",
    "zh_hant": "什麼都看不到。"
  },
  {
    "index": 13,
    "text": "Let's try the back door.",
    "start": 45.773,
    "end": 48.394,
    "zh": "我们试试后门吧。",
    "zh_hant": "我們試試後門吧。"
  },
  {
    "index": 14,
    "text": "Look!",
    "start": 49.255,
    "end": 50.115,
    "zh": "看！",
    "zh_hant": "看！"
  },
  {
    "index": 15,
    "text": "Everyone's in the garden.",
    "start": 50.515,
    "end": 52.836,
    "zh": "大家都在花园里。",
    "zh_hant": "大家都在花園裡。"
  },
  {
    "index": 16,
    "text": "Hello, Helen.",
    "start": 53.177,
    "end": 54.917,
    "zh": "你好，海伦。",
    "zh_hant": "你好，海倫。"
  },
  {
    "index": 17,
    "text": "Hello, Jim.",
    "start": 55.098,
    "end": 56.718,
    "zh": "你好，吉姆。",
    "zh_hant": "你好，吉姆。"
  },
  {
    "index": 18,
    "text": "Everybody wants to have lunch in the garden.",
    "start": 57.319,
    "end": 61.04,
    "zh": "每个人都想在花园里吃午饭。",
    "zh_hant": "每個人都想在花園裡吃午飯。"
  },
  {
    "index": 19,
    "text": "It's nice and warm out here.",
    "start": 61.321,
    "end": 64.162,
    "zh": "这里又舒适又暖和。",
    "zh_hant": "這裡又舒適又暖和。"
  },
  {
    "index": 20,
    "text": "Come and have something to drink.",
    "start": 64.863,
    "end": 67.764,
    "zh": "过来喝点什么吧。",
    "zh_hant": "過來喝點什麼吧。"
  },
  {
    "index": 21,
    "text": "Thanks, Carol.",
    "start": 68.664,
    "end": 70.185,
    "zh": "谢谢，卡罗尔。",
    "zh_hant": "謝謝，卡羅爾。"
  },
  {
    "index": 22,
    "text": "May I have a glass of beer please?",
    "start": 70.725,
    "end": 74.267,
    "zh": "请给我一杯啤酒好吗？",
    "zh_hant": "請給我一杯啤酒好嗎？"
  },
  {
    "index": 23,
    "text": "Beer?",
    "start": 74.487,
    "end": 75.387,
    "zh": "啤酒？",
    "zh_hant": "啤酒？"
  },
  {
    "index": 24,
    "text": "There's none left.",
    "start": 75.728,
    "end": 77.669,
    "zh": "一点都没了。",
    "zh_hant": "一點都沒了。"
  },
  {
    "index": 25,
    "text": "You can have some lemonade.",
    "start": 77.849,
    "end": 80.61,
    "zh": "你可以喝点柠檬水。",
    "zh_hant": "你可以喝點檸檬水。"
  },
  {
    "index": 26,
    "text": "Lemonade!",
    "start": 81.114,
    "end": 82.517,
    "zh": "柠檬水！",
    "zh_hant": "檸檬水！"
  },
  {
    "index": 27,
    "text": "Don't believe her, Jim.",
    "start": 82.578,
    "end": 84.742,
    "zh": "别信她的话，吉姆。",
    "zh_hant": "別信她的話，吉姆。"
  },
  {
    "index": 28,
    "text": "She's only joking.",
    "start": 84.683,
    "end": 86.526,
    "zh": "她只是在开玩笑。",
    "zh_hant": "她只是在開玩笑。"
  },
  {
    "index": 29,
    "text": "Have some beer!",
    "start": 86.567,
    "end": 88.029,
    "zh": "来点啤酒吧！",
    "zh_hant": "來點啤酒吧！"
  }
]
