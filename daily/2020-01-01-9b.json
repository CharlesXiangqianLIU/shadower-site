[
  {
    "index": 0,
    "text": "Lesson 17 How do you do?",
    "start": 0.59,
    "end": 4.431,
    "zh": "第17课 你好吗?",
    "zh_hant": "第17課 你好嗎?"
  },
  {
    "index": 1,
    "text": "Listen to the tape then",
    "start": 6.373,
    "end": 9.435,
    "zh": "听磁带然后",
    "zh_hant": "聽磁帶然後"
  },
  {
    "index": 2,
    "text": "answer this question.",
    "start": 9.235,
    "end": 11.075,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 3,
    "text": "What are Michael Baker and Jeremy Short's",
    "start": 12.596,
    "end": 16.998,
    "zh": "迈克尔·贝克和杰里米·肖特的",
    "zh_hant": "邁克爾·貝克和傑里米·肖特的"
  },
  {
    "index": 4,
    "text": "jobs?",
    "start": 16.798,
    "end": 17.839,
    "zh": "工作是什么？",
    "zh_hant": "工作是什麼？"
  },
  {
    "index": 5,
    "text": "Come and meet our employees",
    "start": 19.5,
    "end": 22.581,
    "zh": "来见见我们的员工",
    "zh_hant": "來見見我們的員工"
  },
  {
    "index": 6,
    "text": "Mr.Richards.",
    "start": 22.421,
    "end": 24.102,
    "zh": "理查兹先生。",
    "zh_hant": "理查茲先生。"
  },
  {
    "index": 7,
    "text": "Thank you Mr. Jackson.",
    "start": 25.103,
    "end": 27.524,
    "zh": "谢谢你，杰克逊先生。",
    "zh_hant": "謝謝你，傑克遜先生。"
  },
  {
    "index": 8,
    "text": "This is Nicola Grey",
    "start": 28.424,
    "end": 30.785,
    "zh": "这是尼古拉·格雷",
    "zh_hant": "這是尼古拉·格雷"
  },
  {
    "index": 9,
    "text": "and this is Claire Taylor.",
    "start": 31.566,
    "end": 34.267,
    "zh": "这是克莱尔·泰勒。",
    "zh_hant": "這是克萊爾·泰勒。"
  },
  {
    "index": 10,
    "text": "How do you do?",
    "start": 35.248,
    "end": 36.728,
    "zh": "你好。",
    "zh_hant": "你好。"
  },
  {
    "index": 11,
    "text": "Those women are very hard-working.",
    "start": 38.409,
    "end": 41.911,
    "zh": "那些妇女很勤奋。",
    "zh_hant": "那些婦女很勤奮。"
  },
  {
    "index": 12,
    "text": "What are their jobs?",
    "start": 43.152,
    "end": 45.113,
    "zh": "她们的工作是什么？",
    "zh_hant": "她們的工作是什麼？"
  },
  {
    "index": 13,
    "text": "They're keyboard operators.",
    "start": 46.594,
    "end": 49.515,
    "zh": "她们是键盘操作员。",
    "zh_hant": "她們是鍵盤操作員。"
  },
  {
    "index": 14,
    "text": "This is Michael Baker and this is Jeremy Short.",
    "start": 50.856,
    "end": 56.759,
    "zh": "这是迈克尔·贝克，这是杰里米·肖特。",
    "zh_hant": "這是邁克爾·貝克，這是傑里米·肖特。"
  },
  {
    "index": 15,
    "text": "How do you do?",
    "start": 57.359,
    "end": 59.02,
    "zh": "你好。",
    "zh_hant": "你好。"
  },
  {
    "index": 16,
    "text": "They aren't very busy!",
    "start": 60.581,
    "end": 62.982,
    "zh": "他们不是很忙！",
    "zh_hant": "他們不是很忙！"
  },
  {
    "index": 17,
    "text": "What are their jobs?",
    "start": 63.803,
    "end": 66.263,
    "zh": "他们的工作是什么？",
    "zh_hant": "他們的工作是什麼？"
  },
  {
    "index": 18,
    "text": "They're sales reps.",
    "start": 67.925,
    "end": 69.825,
    "zh": "他们是销售代表。",
    "zh_hant": "他們是銷售代表。"
  },
  {
    "index": 19,
    "text": "They're very lazy.",
    "start": 70.166,
    "end": 72.307,
    "zh": "他们很懒。",
    "zh_hant": "他們很懶。"
  },
  {
    "index": 20,
    "text": "Who is this young man?",
    "start": 73.187,
    "end": 75.848,
    "zh": "这个年轻人是谁？",
    "zh_hant": "這個年輕人是誰？"
  },
  {
    "index": 21,
    "text": "This is Jim.",
    "start": 77.049,
    "end": 78.87,
    "zh": "这是吉姆。",
    "zh_hant": "這是吉姆。"
  },
  {
    "index": 22,
    "text": "He's our office assistant.",
    "start": 79.337,
    "end": 82.129,
    "zh": "他是我们的办公室助理。",
    "zh_hant": "他是我們的辦公室助理。"
  }
]
