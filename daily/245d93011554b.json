[
  {
    "index": 0,
    "text": "Lesson 125.",
    "start": 1.53,
    "end": 4.782,
    "zh": "第125课。",
    "zh_hant": "第125課。"
  },
  {
    "index": 1,
    "text": "Tea for two.",
    "start": 4.832,
    "end": 6.352,
    "zh": "两人喝茶。",
    "zh_hant": "兩人喝茶。"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 7.653,
    "end": 11.355,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "Does Susan have tea by herself?",
    "start": 13.556,
    "end": 16.357,
    "zh": "苏珊是一个人喝茶吗？",
    "zh_hant": "蘇珊是一個人喝茶嗎？"
  },
  {
    "index": 4,
    "text": "Can't you come in and have tea now, Peter?",
    "start": 18.639,
    "end": 21.44,
    "zh": "彼得，你现在能进来喝茶吗？",
    "zh_hant": "彼得，你現在能進來喝茶嗎？"
  },
  {
    "index": 5,
    "text": "Not yet.",
    "start": 22.22,
    "end": 23.181,
    "zh": "还不行。",
    "zh_hant": "還不行。"
  },
  {
    "index": 6,
    "text": "I must water the garden first.",
    "start": 23.441,
    "end": 25.662,
    "zh": "我得先给花园浇水。",
    "zh_hant": "我得先給花園澆水。"
  },
  {
    "index": 7,
    "text": "Do you have to water it now?",
    "start": 26.522,
    "end": 28.663,
    "zh": "你非得现在浇水吗？",
    "zh_hant": "你非得現在澆水嗎？"
  },
  {
    "index": 8,
    "text": "I'm afraid I must.",
    "start": 29.204,
    "end": 30.864,
    "zh": "恐怕我必须要。",
    "zh_hant": "恐怕我必須要。"
  },
  {
    "index": 9,
    "text": "Look at it!",
    "start": 31.125,
    "end": 32.185,
    "zh": "看看它！",
    "zh_hant": "看看它！"
  },
  {
    "index": 10,
    "text": "It's terribly dry.",
    "start": 32.185,
    "end": 34.106,
    "zh": "太干了。",
    "zh_hant": "太乾了。"
  },
  {
    "index": 11,
    "text": "What a nuisance!",
    "start": 34.506,
    "end": 36.067,
    "zh": "真讨厌！",
    "zh_hant": "真討厭！"
  },
  {
    "index": 12,
    "text": "Last summer it was very dry, too.",
    "start": 36.707,
    "end": 39.469,
    "zh": "去年夏天也很干。",
    "zh_hant": "去年夏天也很乾。"
  },
  {
    "index": 13,
    "text": "Don't you remember?",
    "start": 39.769,
    "end": 40.969,
    "zh": "你不记得了吗？",
    "zh_hant": "你不記得了嗎？"
  },
  {
    "index": 14,
    "text": "I had to water it every day.",
    "start": 41.25,
    "end": 43.512,
    "zh": "我每天都得浇水。",
    "zh_hant": "我每天都得澆水。"
  },
  {
    "index": 15,
    "text": "Well, I'll have tea by myself.",
    "start": 44.153,
    "end": 46.575,
    "zh": "好吧，那我就一个人喝茶了。",
    "zh_hant": "好吧，那我就一個人喝茶了。"
  },
  {
    "index": 16,
    "text": "That was quick!",
    "start": 48.096,
    "end": 49.377,
    "zh": "真快！",
    "zh_hant": "真快！"
  },
  {
    "index": 17,
    "text": "Have you finished already?",
    "start": 49.217,
    "end": 50.738,
    "zh": "你已经浇完了吗？",
    "zh_hant": "你已經澆完了嗎？"
  },
  {
    "index": 18,
    "text": "Yes.",
    "start": 50.999,
    "end": 51.799,
    "zh": "是的。",
    "zh_hant": "是的。"
  },
  {
    "index": 19,
    "text": "Look out of the window.",
    "start": 52.08,
    "end": 53.521,
    "zh": "看看窗外。",
    "zh_hant": "看看窗外。"
  },
  {
    "index": 20,
    "text": "It's raining!",
    "start": 54.042,
    "end": 55.463,
    "zh": "下雨了！",
    "zh_hant": "下雨了！"
  },
  {
    "index": 21,
    "text": "That means you don't need to water the garden.",
    "start": 55.583,
    "end": 58.285,
    "zh": "那意味着你不用给花园浇水了。",
    "zh_hant": "那意味著你不用給花園澆水了。"
  },
  {
    "index": 22,
    "text": "That was a pleasant surprise.",
    "start": 58.666,
    "end": 60.907,
    "zh": "真是个惊喜。",
    "zh_hant": "真是個驚喜。"
  },
  {
    "index": 23,
    "text": "It means I can have tea, instead.",
    "start": 61.108,
    "end": 63.65,
    "zh": "这意味着我可以改喝茶了。",
    "zh_hant": "這意味著我可以改喝茶了。"
  }
]
