[
  {
    "index": 0,
    "text": "Lesson 81 Roast",
    "start": 0.53,
    "end": 3.932,
    "zh": "第81课 烤",
    "zh_hant": "第81課 烤"
  },
  {
    "index": 1,
    "text": "beef and potatoes",
    "start": 3.592,
    "end": 5.853,
    "zh": "牛肉和土豆",
    "zh_hant": "牛肉和土豆"
  },
  {
    "index": 2,
    "text": "Listen to the tape then",
    "start": 6.893,
    "end": 9.815,
    "zh": "听磁带，然后",
    "zh_hant": "聽磁帶，然後"
  },
  {
    "index": 3,
    "text": "answer this question.",
    "start": 9.575,
    "end": 11.476,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 4,
    "text": "Why is Carol disappointed?",
    "start": 12.376,
    "end": 15.397,
    "zh": "卡罗尔为什么失望？",
    "zh_hant": "卡羅爾為什麼失望？"
  },
  {
    "index": 5,
    "text": "Hi, Carol!",
    "start": 16.958,
    "end": 18.359,
    "zh": "嗨，卡罗尔！",
    "zh_hant": "嗨，卡羅爾！"
  },
  {
    "index": 6,
    "text": "Where's Tom?",
    "start": 18.639,
    "end": 20.06,
    "zh": "汤姆在哪儿？",
    "zh_hant": "湯姆在哪兒？"
  },
  {
    "index": 7,
    "text": "He's upstairs.",
    "start": 20.32,
    "end": 22.381,
    "zh": "他在楼上。",
    "zh_hant": "他在樓上。"
  },
  {
    "index": 8,
    "text": "He's having a bath.",
    "start": 22.381,
    "end": 24.602,
    "zh": "他在洗澡。",
    "zh_hant": "他在洗澡。"
  },
  {
    "index": 9,
    "text": "Tom!",
    "start": 25.183,
    "end": 26.283,
    "zh": "汤姆！",
    "zh_hant": "湯姆！"
  },
  {
    "index": 10,
    "text": "Yes?",
    "start": 26.783,
    "end": 27.884,
    "zh": "什么事？",
    "zh_hant": "什麼事？"
  },
  {
    "index": 11,
    "text": "Sam's here.",
    "start": 27.984,
    "end": 29.404,
    "zh": "萨姆来了。",
    "zh_hant": "薩姆來了。"
  },
  {
    "index": 12,
    "text": "I'm nearly ready.",
    "start": 30.305,
    "end": 31.846,
    "zh": "我快准备好了。",
    "zh_hant": "我快準備好了。"
  },
  {
    "index": 13,
    "text": "Hello, Sam.",
    "start": 32.766,
    "end": 34.247,
    "zh": "你好，萨姆。",
    "zh_hant": "你好，薩姆。"
  },
  {
    "index": 14,
    "text": "Have a cigarette.",
    "start": 34.627,
    "end": 36.428,
    "zh": "抽支烟吧。",
    "zh_hant": "抽支菸吧。"
  },
  {
    "index": 15,
    "text": "No, thanks, Tom.",
    "start": 36.608,
    "end": 38.509,
    "zh": "不，谢谢，汤姆。",
    "zh_hant": "不，謝謝，湯姆。"
  },
  {
    "index": 16,
    "text": "Have a glass of whisky then.",
    "start": 39.049,
    "end": 41.491,
    "zh": "那喝杯威士忌吧。",
    "zh_hant": "那喝杯威士忌吧。"
  },
  {
    "index": 17,
    "text": "OK.",
    "start": 41.691,
    "end": 42.371,
    "zh": "好的。",
    "zh_hant": "好的。"
  },
  {
    "index": 18,
    "text": "Thanks.",
    "start": 42.532,
    "end": 43.452,
    "zh": "谢谢。",
    "zh_hant": "謝謝。"
  },
  {
    "index": 19,
    "text": "Is dinnner ready, Carol?",
    "start": 44.153,
    "end": 46.233,
    "zh": "晚饭准备好了吗，卡罗尔？",
    "zh_hant": "晚飯準備好了嗎，卡羅爾？"
  },
  {
    "index": 20,
    "text": "It's nearly ready.",
    "start": 47.774,
    "end": 49.695,
    "zh": "快准备好了。",
    "zh_hant": "快準備好了。"
  },
  {
    "index": 21,
    "text": "We can have dinner at seven o'clock.",
    "start": 50.036,
    "end": 53.677,
    "zh": "我们七点能吃晚饭。",
    "zh_hant": "我們七點能吃晚飯。"
  },
  {
    "index": 22,
    "text": "Sam and I had lunch together today.",
    "start": 54.858,
    "end": 58.16,
    "zh": "萨姆和我今天一起吃了午饭。",
    "zh_hant": "薩姆和我今天一起吃了午飯。"
  },
  {
    "index": 23,
    "text": "We went to a restaurant.",
    "start": 58.62,
    "end": 60.861,
    "zh": "我们去了一家餐馆。",
    "zh_hant": "我們去了一家餐館。"
  },
  {
    "index": 24,
    "text": "What did you have?",
    "start": 61.121,
    "end": 62.962,
    "zh": "你们吃了什么？",
    "zh_hant": "你們吃了什麼？"
  },
  {
    "index": 25,
    "text": "We had roast beef and potatoes.",
    "start": 63.403,
    "end": 66.844,
    "zh": "我们吃了烤牛肉和土豆。",
    "zh_hant": "我們吃了烤牛肉和土豆。"
  },
  {
    "index": 26,
    "text": "Oh!",
    "start": 67.065,
    "end": 67.905,
    "zh": "哦！",
    "zh_hant": "哦！"
  },
  {
    "index": 27,
    "text": "What's the matter, Carol?",
    "start": 68.685,
    "end": 70.666,
    "zh": "怎么了，卡罗尔？",
    "zh_hant": "怎麼了，卡羅爾？"
  },
  {
    "index": 28,
    "text": "Well, you're going to have roast beef",
    "start": 71.047,
    "end": 75.129,
    "zh": "唉，你今晚又要吃烤牛肉",
    "zh_hant": "唉，你今晚又要吃烤牛肉"
  },
  {
    "index": 29,
    "text": "and potatoes again tonight!",
    "start": 74.869,
    "end": 77.75,
    "zh": "和土豆了！",
    "zh_hant": "和土豆了！"
  }
]
