[
  {
    "index": 0,
    "text": "Lesson 81.",
    "start": 1.531,
    "end": 3.862,
    "zh": "第81课。",
    "zh_hant": "第81課。"
  },
  {
    "index": 1,
    "text": "Roast beef and potatoes.",
    "start": 3.912,
    "end": 6.493,
    "zh": "烤牛肉和土豆。",
    "zh_hant": "烤牛肉和土豆。"
  },
  {
    "index": 2,
    "text": "Listen to the tape then answer this question.",
    "start": 7.854,
    "end": 11.595,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 3,
    "text": "Why is Carol disappointed?",
    "start": 13.837,
    "end": 16.538,
    "zh": "卡罗尔为什么失望？",
    "zh_hant": "卡羅爾為什麼失望？"
  },
  {
    "index": 4,
    "text": "Hi, Carol!",
    "start": 18.819,
    "end": 19.899,
    "zh": "嗨，卡罗尔！",
    "zh_hant": "嗨，卡羅爾！"
  },
  {
    "index": 5,
    "text": "Where's Tom?",
    "start": 19.92,
    "end": 21.02,
    "zh": "汤姆在哪里？",
    "zh_hant": "湯姆在哪裡？"
  },
  {
    "index": 6,
    "text": "He's upstairs.",
    "start": 21.04,
    "end": 22.401,
    "zh": "他在楼上。",
    "zh_hant": "他在樓上。"
  },
  {
    "index": 7,
    "text": "He's having a bath.",
    "start": 22.301,
    "end": 23.721,
    "zh": "他在洗澡。",
    "zh_hant": "他在洗澡。"
  },
  {
    "index": 8,
    "text": "Tom!",
    "start": 24.542,
    "end": 25.622,
    "zh": "汤姆！",
    "zh_hant": "湯姆！"
  },
  {
    "index": 9,
    "text": "Yes?",
    "start": 25.643,
    "end": 26.643,
    "zh": "什么事？",
    "zh_hant": "什麼事？"
  },
  {
    "index": 10,
    "text": "Sam's here.",
    "start": 26.863,
    "end": 28.184,
    "zh": "萨姆在这里。",
    "zh_hant": "薩姆在這裡。"
  },
  {
    "index": 11,
    "text": "I'm nearly ready.",
    "start": 28.444,
    "end": 30.064,
    "zh": "我快准备好了。",
    "zh_hant": "我快準備好了。"
  },
  {
    "index": 12,
    "text": "Hello, Sam.",
    "start": 32.226,
    "end": 33.486,
    "zh": "你好，萨姆。",
    "zh_hant": "你好，薩姆。"
  },
  {
    "index": 13,
    "text": "Have a cigarette.",
    "start": 33.706,
    "end": 35.167,
    "zh": "抽支烟吧。",
    "zh_hant": "抽支菸吧。"
  },
  {
    "index": 14,
    "text": "No, thanks, Tom.",
    "start": 36.248,
    "end": 37.988,
    "zh": "不了，谢谢，汤姆。",
    "zh_hant": "不了，謝謝，湯姆。"
  },
  {
    "index": 15,
    "text": "Have a glass of whisky then.",
    "start": 38.989,
    "end": 40.87,
    "zh": "那喝杯威士忌吧。",
    "zh_hant": "那喝杯威士忌吧。"
  },
  {
    "index": 16,
    "text": "OK.",
    "start": 42.03,
    "end": 42.69,
    "zh": "好的。",
    "zh_hant": "好的。"
  },
  {
    "index": 17,
    "text": "Thanks.",
    "start": 43.171,
    "end": 44.031,
    "zh": "谢谢。",
    "zh_hant": "謝謝。"
  },
  {
    "index": 18,
    "text": "Is dinnner ready, Carol?",
    "start": 46.053,
    "end": 47.594,
    "zh": "晚饭准备好了吗，卡罗尔？",
    "zh_hant": "晚飯準備好了嗎，卡羅爾？"
  },
  {
    "index": 19,
    "text": "It's nearly ready.",
    "start": 47.794,
    "end": 49.055,
    "zh": "快好了。",
    "zh_hant": "快好了。"
  },
  {
    "index": 20,
    "text": "We can have dinner at seven o'clock.",
    "start": 49.275,
    "end": 51.736,
    "zh": "我们七点可以吃晚饭。",
    "zh_hant": "我們七點可以吃晚飯。"
  },
  {
    "index": 21,
    "text": "Sam and I had lunch together today.",
    "start": 52.457,
    "end": 55.139,
    "zh": "今天中午我和萨姆一起吃了午饭。",
    "zh_hant": "今天中午我和薩姆一起吃了午飯。"
  },
  {
    "index": 22,
    "text": "We went to a restaurant.",
    "start": 55.499,
    "end": 57.46,
    "zh": "我们去了餐馆。",
    "zh_hant": "我們去了餐館。"
  },
  {
    "index": 23,
    "text": "What did you have?",
    "start": 57.521,
    "end": 58.861,
    "zh": "你们吃了什么？",
    "zh_hant": "你們吃了什麼？"
  },
  {
    "index": 24,
    "text": "We had roast beef and potatoes.",
    "start": 59.242,
    "end": 62.784,
    "zh": "我们吃了烤牛肉和土豆。",
    "zh_hant": "我們吃了烤牛肉和土豆。"
  },
  {
    "index": 25,
    "text": "Oh!",
    "start": 63.404,
    "end": 64.145,
    "zh": "哦！",
    "zh_hant": "哦！"
  },
  {
    "index": 26,
    "text": "What's the matter, Carol?",
    "start": 65.066,
    "end": 66.786,
    "zh": "怎么了，卡罗尔？",
    "zh_hant": "怎麼了，卡羅爾？"
  },
  {
    "index": 27,
    "text": "Well, you're going to have roast beef",
    "start": 67.467,
    "end": 70.249,
    "zh": "嗯，你今晚又要吃烤牛肉",
    "zh_hant": "嗯，你今晚又要吃烤牛肉"
  },
  {
    "index": 28,
    "text": "and potatoes again tonight!",
    "start": 69.899,
    "end": 72.15,
    "zh": "和土豆了！",
    "zh_hant": "和土豆了！"
  }
]
