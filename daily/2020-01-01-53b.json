[
  {
    "index": 0,
    "text": "Lesson 105.",
    "start": 0.49,
    "end": 3.382,
    "zh": "第105课。",
    "zh_hant": "第105課。"
  },
  {
    "index": 1,
    "text": "Full of mistakes.",
    "start": 3.432,
    "end": 5.473,
    "zh": "错误百出。",
    "zh_hant": "錯誤百出。"
  },
  {
    "index": 2,
    "text": "Listen to the tape",
    "start": 7.174,
    "end": 9.415,
    "zh": "听录音",
    "zh_hant": "聽錄音"
  },
  {
    "index": 3,
    "text": "then answer this question.",
    "start": 9.735,
    "end": 12.376,
    "zh": "然后回答这个问题。",
    "zh_hant": "然後回答這個問題。"
  },
  {
    "index": 4,
    "text": "What was Sandra's present?",
    "start": 13.417,
    "end": 16.078,
    "zh": "桑德拉的礼物是什么？",
    "zh_hant": "桑德拉的禮物是什麼？"
  },
  {
    "index": 5,
    "text": "Where's Sandra, Bob?",
    "start": 18.319,
    "end": 20.4,
    "zh": "桑德拉在哪儿，鲍勃？",
    "zh_hant": "桑德拉在哪兒，鮑勃？"
  },
  {
    "index": 6,
    "text": "I want her.",
    "start": 20.78,
    "end": 22.021,
    "zh": "我要找她。",
    "zh_hant": "我要找她。"
  },
  {
    "index": 7,
    "text": "Do you want to speak to her?",
    "start": 23.342,
    "end": 26.043,
    "zh": "你想和她说话吗？",
    "zh_hant": "你想和她說話嗎？"
  },
  {
    "index": 8,
    "text": "Yes, I do.",
    "start": 27.384,
    "end": 28.944,
    "zh": "是的，我想。",
    "zh_hant": "是的，我想。"
  },
  {
    "index": 9,
    "text": "I want her to come to my office.",
    "start": 29.745,
    "end": 32.986,
    "zh": "我要她到我办公室来。",
    "zh_hant": "我要她到我辦公室來。"
  },
  {
    "index": 10,
    "text": "Tell her to come at once.",
    "start": 33.347,
    "end": 36.268,
    "zh": "叫她马上来。",
    "zh_hant": "叫她馬上來。"
  },
  {
    "index": 11,
    "text": "Did you want to see me?",
    "start": 37.149,
    "end": 39.99,
    "zh": "你想见我吗？",
    "zh_hant": "你想見我嗎？"
  },
  {
    "index": 12,
    "text": "Ah, yes, Sandra.",
    "start": 40.671,
    "end": 42.952,
    "zh": "啊，是的，桑德拉。",
    "zh_hant": "啊，是的，桑德拉。"
  },
  {
    "index": 13,
    "text": "How do you spell 'intelligent'?",
    "start": 43.692,
    "end": 47.034,
    "zh": "你怎么拼写‘intelligent’？",
    "zh_hant": "你怎麼拼寫‘intelligent’？"
  },
  {
    "index": 14,
    "text": "Can you tell me?",
    "start": 47.174,
    "end": 48.955,
    "zh": "你能告诉我吗？",
    "zh_hant": "你能告訴我嗎？"
  },
  {
    "index": 15,
    "text": "That's right.",
    "start": 60.821,
    "end": 62.202,
    "zh": "对了。",
    "zh_hant": "對了。"
  },
  {
    "index": 16,
    "text": "You've typed it with only one 'L'.",
    "start": 62.762,
    "end": 66.244,
    "zh": "你只打了一个‘L’。",
    "zh_hant": "你只打了一個‘L’。"
  },
  {
    "index": 17,
    "text": "This letter's full of mistakes.",
    "start": 66.765,
    "end": 70.226,
    "zh": "这封信错误百出。",
    "zh_hant": "這封信錯誤百出。"
  },
  {
    "index": 18,
    "text": "I want you to type it again.",
    "start": 70.787,
    "end": 73.948,
    "zh": "我要你再打一遍。",
    "zh_hant": "我要你再打一遍。"
  },
  {
    "index": 19,
    "text": "Yes, I'll do that.",
    "start": 74.869,
    "end": 76.489,
    "zh": "好的，我会这么做。",
    "zh_hant": "好的，我會這麼做。"
  },
  {
    "index": 20,
    "text": "I'm sorry about that.",
    "start": 76.139,
    "end": 77.29,
    "zh": "对此我很抱歉。",
    "zh_hant": "對此我很抱歉。"
  },
  {
    "index": 21,
    "text": "And here's a little present for you.",
    "start": 80.412,
    "end": 83.457,
    "zh": "这有一份小礼物给你。",
    "zh_hant": "這有一份小禮物給你。"
  },
  {
    "index": 22,
    "text": "What is it?",
    "start": 83.739,
    "end": 85.2,
    "zh": "这是什么？",
    "zh_hant": "這是什麼？"
  },
  {
    "index": 23,
    "text": "It's a dictionary.",
    "start": 85.442,
    "end": 87.144,
    "zh": "这是一本字典。",
    "zh_hant": "這是一本字典。"
  },
  {
    "index": 24,
    "text": "I hope it'll help you.",
    "start": 87.826,
    "end": 89.769,
    "zh": "我希望它能帮助你。",
    "zh_hant": "我希望它能幫助你。"
  }
]
