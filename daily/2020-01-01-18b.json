[
  {
    "index": 0,
    "text": "Lesson 35 Our village",
    "start": 0.63,
    "end": 4.732,
    "zh": "第三十五课 我们的村庄",
    "zh_hant": "第三十五課 我們的村莊"
  },
  {
    "index": 1,
    "text": "Listen to the tape then",
    "start": 6.053,
    "end": 8.854,
    "zh": "听录音，然后",
    "zh_hant": "聽錄音，然後"
  },
  {
    "index": 2,
    "text": "answer this question.",
    "start": 8.634,
    "end": 10.555,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 3,
    "text": "Are the children coming out of the park",
    "start": 11.696,
    "end": 14.997,
    "zh": "孩子们是从公园里出来",
    "zh_hant": "孩子們是從公園裡出來"
  },
  {
    "index": 4,
    "text": "or going into it?",
    "start": 15.138,
    "end": 17.258,
    "zh": "还是走进公园去？",
    "zh_hant": "還是走進公園去？"
  },
  {
    "index": 5,
    "text": "This is a photograph of our village.",
    "start": 18.959,
    "end": 22.861,
    "zh": "这是我们村庄的一张照片。",
    "zh_hant": "這是我們村莊的一張照片。"
  },
  {
    "index": 6,
    "text": "Our village is in a valley.",
    "start": 23.482,
    "end": 26.303,
    "zh": "我们的村庄在一个山谷里。",
    "zh_hant": "我們的村莊在一個山谷裡。"
  },
  {
    "index": 7,
    "text": "It is between two hills.",
    "start": 26.883,
    "end": 29.665,
    "zh": "它位于两座小山之间。",
    "zh_hant": "它位於兩座小山之間。"
  },
  {
    "index": 8,
    "text": "The village is on a river.",
    "start": 30.165,
    "end": 32.926,
    "zh": "村庄坐落在一条河畔。",
    "zh_hant": "村莊坐落在一條河畔。"
  },
  {
    "index": 9,
    "text": "Here is another photograph of the village.",
    "start": 34.687,
    "end": 39.029,
    "zh": "这儿是村庄的另一张照片。",
    "zh_hant": "這兒是村莊的另一張照片。"
  },
  {
    "index": 10,
    "text": "My wife and I are walking",
    "start": 39.57,
    "end": 42.571,
    "zh": "我和妻子正在",
    "zh_hant": "我和妻子正在"
  },
  {
    "index": 11,
    "text": "along the banks of the river.",
    "start": 42.552,
    "end": 45.553,
    "zh": "沿着河岸散步。",
    "zh_hant": "沿著河岸散步。"
  },
  {
    "index": 12,
    "text": "We are on the left.",
    "start": 46.314,
    "end": 48.634,
    "zh": "我们在左边。",
    "zh_hant": "我們在左邊。"
  },
  {
    "index": 13,
    "text": "There is a boy in the water.",
    "start": 49.515,
    "end": 52.276,
    "zh": "水里有一个男孩。",
    "zh_hant": "水裡有一個男孩。"
  },
  {
    "index": 14,
    "text": "He is swimming across the river.",
    "start": 52.897,
    "end": 56.118,
    "zh": "他正在游过河。",
    "zh_hant": "他正在遊過河。"
  },
  {
    "index": 15,
    "text": "Here is another photograph.",
    "start": 58.239,
    "end": 60.921,
    "zh": "这儿是另一张照片。",
    "zh_hant": "這兒是另一張照片。"
  },
  {
    "index": 16,
    "text": "This is the school building.",
    "start": 61.721,
    "end": 64.202,
    "zh": "这是学校大楼。",
    "zh_hant": "這是學校大樓。"
  },
  {
    "index": 17,
    "text": "It is beside a park.",
    "start": 64.743,
    "end": 67.384,
    "zh": "它在公园旁边。",
    "zh_hant": "它在公園旁邊。"
  },
  {
    "index": 18,
    "text": "The park is on the right.",
    "start": 68.024,
    "end": 70.765,
    "zh": "公园在右边。",
    "zh_hant": "公園在右邊。"
  },
  {
    "index": 19,
    "text": "Some children are coming out of the building.",
    "start": 71.526,
    "end": 75.428,
    "zh": "一些孩子正从大楼里出来。",
    "zh_hant": "一些孩子正從大樓裡出來。"
  },
  {
    "index": 20,
    "text": "Some of them are going into the park.",
    "start": 76.028,
    "end": 79.67,
    "zh": "他们中的一些正走进公园。",
    "zh_hant": "他們中的一些正走進公園。"
  }
]
