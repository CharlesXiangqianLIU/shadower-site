[
  {
    "index": 0,
    "text": "Lesson 33 A fine day",
    "start": 1.551,
    "end": 5.812,
    "zh": "第33课 晴朗的一天",
    "zh_hant": "第33課 晴朗的一天"
  },
  {
    "index": 1,
    "text": "Listen to the tape then answer this question.",
    "start": 7.494,
    "end": 11.635,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 2,
    "text": "Where is the Jones family?",
    "start": 13.817,
    "end": 16.298,
    "zh": "琼斯一家在哪里？",
    "zh_hant": "瓊斯一家在哪裡？"
  },
  {
    "index": 3,
    "text": "It is a fine day today.",
    "start": 18.679,
    "end": 21.28,
    "zh": "今天天气晴朗。",
    "zh_hant": "今天天氣晴朗。"
  },
  {
    "index": 4,
    "text": "There are some clouds in the sky,",
    "start": 22.381,
    "end": 25.603,
    "zh": "天空中有一些云朵，",
    "zh_hant": "天空中有一些雲朵，"
  },
  {
    "index": 5,
    "text": "but the sun is shining.",
    "start": 26.843,
    "end": 29.284,
    "zh": "但阳光明媚。",
    "zh_hant": "但陽光明媚。"
  },
  {
    "index": 6,
    "text": "Mr. Jones is with his family.",
    "start": 31.406,
    "end": 35.127,
    "zh": "琼斯先生和他的家人在一起。",
    "zh_hant": "瓊斯先生和他的家人在一起。"
  },
  {
    "index": 7,
    "text": "They are walking over the bridge.",
    "start": 36.488,
    "end": 39.91,
    "zh": "他们正在走过那座桥。",
    "zh_hant": "他們正在走過那座橋。"
  },
  {
    "index": 8,
    "text": "There are some boats on the river.",
    "start": 41.631,
    "end": 44.732,
    "zh": "河上有一些船。",
    "zh_hant": "河上有一些船。"
  },
  {
    "index": 9,
    "text": "Mr. Jones and his wife",
    "start": 47.114,
    "end": 49.915,
    "zh": "琼斯先生和他的妻子",
    "zh_hant": "瓊斯先生和他的妻子"
  },
  {
    "index": 10,
    "text": "are looking at them.",
    "start": 50.056,
    "end": 51.796,
    "zh": "正在看那些船。",
    "zh_hant": "正在看那些船。"
  },
  {
    "index": 11,
    "text": "Sally is looking at a big ship.",
    "start": 53.558,
    "end": 57.56,
    "zh": "萨莉正在看一艘大船。",
    "zh_hant": "薩莉正在看一艘大船。"
  },
  {
    "index": 12,
    "text": "The ship is going under the bridge.",
    "start": 59.481,
    "end": 63.043,
    "zh": "那艘船正从桥下驶过。",
    "zh_hant": "那艘船正從橋下駛過。"
  },
  {
    "index": 13,
    "text": "Tim is looking at an aeroplane.",
    "start": 64.904,
    "end": 68.486,
    "zh": "蒂姆正在看一架飞机。",
    "zh_hant": "蒂姆正在看一架飛機。"
  },
  {
    "index": 14,
    "text": "The aeroplane is flying over the river.",
    "start": 70.127,
    "end": 74.61,
    "zh": "那架飞机正在河面上空飞行。",
    "zh_hant": "那架飛機正在河面上空飛行。"
  }
]
