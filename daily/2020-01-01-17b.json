[
  {
    "index": 0,
    "text": "Lesson 33 A fine day",
    "start": 0.67,
    "end": 4.852,
    "zh": "第33课 晴朗的一天",
    "zh_hant": "第33課 晴朗的一天"
  },
  {
    "index": 1,
    "text": "Listen to the tape then answer this question.",
    "start": 5.993,
    "end": 10.375,
    "zh": "听录音，然后回答这个问题。",
    "zh_hant": "聽錄音，然後回答這個問題。"
  },
  {
    "index": 2,
    "text": "Where is the Jones family?",
    "start": 11.456,
    "end": 14.157,
    "zh": "琼斯一家人在哪里？",
    "zh_hant": "瓊斯一家人在哪裡？"
  },
  {
    "index": 3,
    "text": "It is a fine day today.",
    "start": 16.238,
    "end": 19.02,
    "zh": "今天天气晴朗。",
    "zh_hant": "今天天氣晴朗。"
  },
  {
    "index": 4,
    "text": "There are some clouds in the sky,",
    "start": 19.94,
    "end": 23.342,
    "zh": "天空中有一些云，",
    "zh_hant": "天空中有一些雲，"
  },
  {
    "index": 5,
    "text": "but the sun is shining.",
    "start": 24.183,
    "end": 26.644,
    "zh": "但阳光在照耀。",
    "zh_hant": "但陽光在照耀。"
  },
  {
    "index": 6,
    "text": "Mr. Jones is with his family.",
    "start": 27.704,
    "end": 30.806,
    "zh": "琼斯先生和他的家人在一起。",
    "zh_hant": "瓊斯先生和他的家人在一起。"
  },
  {
    "index": 7,
    "text": "They are walking over the bridge.",
    "start": 31.766,
    "end": 34.648,
    "zh": "他们正走过那座桥。",
    "zh_hant": "他們正走過那座橋。"
  },
  {
    "index": 8,
    "text": "There are some boats on the river.",
    "start": 35.809,
    "end": 38.81,
    "zh": "河上有一些船。",
    "zh_hant": "河上有一些船。"
  },
  {
    "index": 9,
    "text": "Mr. Jones and his wife",
    "start": 39.811,
    "end": 42.713,
    "zh": "琼斯先生和他的妻子",
    "zh_hant": "瓊斯先生和他的妻子"
  },
  {
    "index": 10,
    "text": "are looking at them.",
    "start": 42.573,
    "end": 44.414,
    "zh": "正在看着它们。",
    "zh_hant": "正在看著它們。"
  },
  {
    "index": 11,
    "text": "Sally is looking at a big ship.",
    "start": 45.756,
    "end": 49.078,
    "zh": "萨利正在看一艘大轮船。",
    "zh_hant": "薩利正在看一艘大輪船。"
  },
  {
    "index": 12,
    "text": "The ship is going under the bridge.",
    "start": 50.179,
    "end": 53.582,
    "zh": "那艘轮船正从桥下经过。",
    "zh_hant": "那艘輪船正從橋下經過。"
  },
  {
    "index": 13,
    "text": "Tim is looking at an aeroplane.",
    "start": 54.683,
    "end": 58.005,
    "zh": "蒂姆正在看一架飞机。",
    "zh_hant": "蒂姆正在看一架飛機。"
  },
  {
    "index": 14,
    "text": "The aeroplane is flying over the river.",
    "start": 59.527,
    "end": 63.51,
    "zh": "那架飞机正从河上飞过。",
    "zh_hant": "那架飛機正從河上飛過。"
  }
]
