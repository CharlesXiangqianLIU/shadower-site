[
  {
    "index": 0,
    "text": "Lesson 59 Is that all?",
    "start": 0.67,
    "end": 4.732,
    "zh": "第59课 就这些吗？",
    "zh_hant": "第59課 就這些嗎？"
  },
  {
    "index": 1,
    "text": "Listen to the tape then",
    "start": 6.173,
    "end": 8.974,
    "zh": "听录音，然后",
    "zh_hant": "聽錄音，然後"
  },
  {
    "index": 2,
    "text": "answer this question.",
    "start": 8.754,
    "end": 10.675,
    "zh": "回答这个问题。",
    "zh_hant": "回答這個問題。"
  },
  {
    "index": 3,
    "text": "Does the lady buy any chalk?",
    "start": 11.736,
    "end": 14.537,
    "zh": "那位女士买粉笔了吗？",
    "zh_hant": "那位女士買粉筆了嗎？"
  },
  {
    "index": 4,
    "text": "I want some envelopes, please.",
    "start": 16.478,
    "end": 19.64,
    "zh": "请给我一些信封。",
    "zh_hant": "請給我一些信封。"
  },
  {
    "index": 5,
    "text": "Do you want the large size or the small size?",
    "start": 20.16,
    "end": 24.302,
    "zh": "您要大号的还是小号的？",
    "zh_hant": "您要大號的還是小號的？"
  },
  {
    "index": 6,
    "text": "The large size, please.",
    "start": 25.203,
    "end": 27.804,
    "zh": "请给我大号的。",
    "zh_hant": "請給我大號的。"
  },
  {
    "index": 7,
    "text": "Do you have any writing paper?",
    "start": 28.544,
    "end": 31.566,
    "zh": "你们有信纸吗？",
    "zh_hant": "你們有信紙嗎？"
  },
  {
    "index": 8,
    "text": "Yes, we do.",
    "start": 31.806,
    "end": 33.206,
    "zh": "有，我们有。",
    "zh_hant": "有，我們有。"
  },
  {
    "index": 9,
    "text": "I don't have any small pads.",
    "start": 34.547,
    "end": 37.809,
    "zh": "我没有小号的便笺簿。",
    "zh_hant": "我沒有小號的便箋簿。"
  },
  {
    "index": 10,
    "text": "I only have large ones.",
    "start": 38.449,
    "end": 41.071,
    "zh": "我只有大号的。",
    "zh_hant": "我只有大號的。"
  },
  {
    "index": 11,
    "text": "Do you want a pad?",
    "start": 41.552,
    "end": 43.793,
    "zh": "您要一本便笺簿吗？",
    "zh_hant": "您要一本便箋簿嗎？"
  },
  {
    "index": 12,
    "text": "Yes, please.",
    "start": 44.153,
    "end": 46.034,
    "zh": "好的，请给我。",
    "zh_hant": "好的，請給我。"
  },
  {
    "index": 13,
    "text": "And I want some glue.",
    "start": 46.414,
    "end": 48.976,
    "zh": "我还要一些胶水。",
    "zh_hant": "我還要一些膠水。"
  },
  {
    "index": 14,
    "text": "A bottle of glue.",
    "start": 49.856,
    "end": 51.777,
    "zh": "一瓶胶水。",
    "zh_hant": "一瓶膠水。"
  },
  {
    "index": 15,
    "text": "And I want a large box",
    "start": 53.078,
    "end": 56.1,
    "zh": "我还要一大盒",
    "zh_hant": "我還要一大盒"
  },
  {
    "index": 16,
    "text": "of chalk, too.",
    "start": 55.88,
    "end": 57.681,
    "zh": "粉笔。",
    "zh_hant": "粉筆。"
  },
  {
    "index": 17,
    "text": "I only have small boxes.",
    "start": 58.341,
    "end": 61.143,
    "zh": "我只有小盒的。",
    "zh_hant": "我只有小盒的。"
  },
  {
    "index": 18,
    "text": "Do you want one?",
    "start": 61.363,
    "end": 62.924,
    "zh": "您要一盒吗？",
    "zh_hant": "您要一盒嗎？"
  },
  {
    "index": 19,
    "text": "No, thank you.",
    "start": 63.044,
    "end": 64.464,
    "zh": "不，谢谢。",
    "zh_hant": "不，謝謝。"
  },
  {
    "index": 20,
    "text": "Is that all?",
    "start": 64.905,
    "end": 66.366,
    "zh": "就这些吗？",
    "zh_hant": "就這些嗎？"
  },
  {
    "index": 21,
    "text": "That's all, thank you.",
    "start": 66.486,
    "end": 68.887,
    "zh": "就这些，谢谢。",
    "zh_hant": "就這些，謝謝。"
  },
  {
    "index": 22,
    "text": "What else do you want?",
    "start": 69.227,
    "end": 71.208,
    "zh": "您还要别的吗？",
    "zh_hant": "您還要別的嗎？"
  },
  {
    "index": 23,
    "text": "I want my change.",
    "start": 71.769,
    "end": 74.11,
    "zh": "我要找零。",
    "zh_hant": "我要找零。"
  }
]
